{
  "schedules": [
    {
      "type": "schedule",
      "number": "X",
      "id": "schedule-X",
      "reference_text": "[See section 49]",
      "reference_section": "49",
      "title": "DEDUCTION FOR SITE RESTORATION FUND FOR COMPUTING INCOME UNDER THE HEAD \"PROFITS AND GAINS OF BUSINESS OR PROFESSION\"",
      "act": "Income-tax Act, 2025",
      "source_url": "https://www.incometaxindia.gov.in/w/schedule-x-3",
      "source_year": "2026",
      "x": null,
      "y_start": null,
      "page_start": null,
      "page_end": null,
      "text_before_paragraphs": "",
      "paragraphs": [
        {
          "type": "paragraph",
          "number": "1",
          "id": "schedule-X-1",
          "title": "Quantum of deduction.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-X-1-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "An assessee shall be allowed deduction of,--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-1-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "the amount or aggregate of the amount deposited by the assessee in the account as specified in paragraph 2; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-1-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "20% of the profits of such business computed under the head \"Profits and gains of business or profession\" before making any deduction under this paragraph,",
                  "children": []
                }
              ],
              "text_after_clauses": "whichever is less."
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-X-1-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "The deduction shall be allowed before allowing set off of loss, if any, brought forward from earlier tax years as per section 112.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-X-1-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Any interest credited in the specified account shall be deemed to be a deposit.",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "2",
          "id": "schedule-X-2",
          "title": "Conditions for claiming deduction.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-X-2-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Deduction under paragraph 1 shall be allowed if the assessee--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-2-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is, during the tax year, carrying on the business consisting of the prospecting for, or extraction or production of, petroleum or natural gas, or both in India, and has entered into an agreement with the Central Government for such business;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-2-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "has, before the end of the tax year, deposited any amount in the specified account, being,--",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "schedule-X-2-1-b-i",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "a special account maintained with the State Bank of India in accordance with, and for the purposes specified in the special scheme; or"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "schedule-X-2-1-b-ii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "a site restoration account in accordance with, and for the purposes specified in the deposit scheme; and"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "schedule-X-2-1-c",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "gets the accounts of such business for the relevant tax year audited by an accountant before the specified date referred to in section 63 and furnishes the audit report, in such form and manner, as may be prescribed and verified by such accountant, by that date.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-X-2-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where the assessee is required, by or under any other law, to get his accounts audited, then it shall be sufficient compliance of sub-paragraph (1) (c), if such assessee—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-2-2-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "gets the accounts of such business audited under such law before the specified date referred to in section 63; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-2-2-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "furnishes by that date the report of such audit and a report by an accountant in such form referred to in sub-paragraph (1)(c).",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-X-2-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "If any deduction has been allowed under paragraph 1 in any tax year, no deduction shall be allowed in respect of such amount in any other tax year.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "4",
              "id": "schedule-X-2-4",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where the assessee referred to in paragraph 1 is a firm or an association of persons or body of individuals, deduction under paragraph 1 shall not be allowed in computing the income of any of the partners or members of such assessee.",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "3",
          "id": "schedule-X-3",
          "title": "Withdrawal from specified account.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-X-3-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Any amount standing to the credit of the assessee in the specified account shall not be allowed to be withdrawn except for the purposes specified in the special scheme or in the deposit scheme.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-X-3-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-3-2-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "Irrespective of anything contained in sub-paragraph (1), if the amount is utilised for the purchase of specified articles or things, then, such amount shall not be allowed as deduction under paragraph 1;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-3-2-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "for the purposes of this paragraph, \"specified article or thing\" means—",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "schedule-X-3-2-b-i",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "any machinery or plant to be installed in any office premises or residential accommodation, including any accommodation in the nature of a guest-house;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "schedule-X-3-2-b-ii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "any office appliances (except computers);"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iii",
                      "id": "schedule-X-3-2-b-iii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "any machinery or plant, the whole of the actual cost of which is allowed as a deduction (whether by way of depreciation or otherwise) in computing the income chargeable under the head \"Profits and gains of business or profession\" of any one tax year;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iv",
                      "id": "schedule-X-3-2-b-iv",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "any new machinery or plant to be installed in an industrial undertaking for the purposes of business of construction, manufacture or production of any article or thing specified in the list in Schedule XIII."
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-X-3-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_formula": "Where any amount standing to the credit of the assessee in specified account is withdrawn on closure of such account in any tax year, then the amount computed as under shall be deemed to be the profits and gains of business or profession for the tax year and accordingly the following amount shall be charged to income-tax for that tax year:",
              "formula": {
                "type": "formula",
                "id": "schedule-X-3-3-formula",
                "x": null,
                "y_start": null,
                "page_start": null,
                "page_end": null,
                "expression": "A = B - C",
                "variables_intro": "where,—",
                "variables": [
                  {
                    "type": "variable",
                    "number": "A",
                    "id": "schedule-X-3-3-formula-A",
                    "x": null,
                    "y_start": null,
                    "page_start": null,
                    "page_end": null,
                    "symbol": "A",
                    "text": "deemed profits and gains of business or profession of that tax year;"
                  },
                  {
                    "type": "variable",
                    "number": "B",
                    "id": "schedule-X-3-3-formula-B",
                    "x": null,
                    "y_start": null,
                    "page_start": null,
                    "page_end": null,
                    "symbol": "B",
                    "text": "amount withdrawn from the specified account on its closure; and"
                  },
                  {
                    "type": "variable",
                    "number": "C",
                    "id": "schedule-X-3-3-formula-C",
                    "x": null,
                    "y_start": null,
                    "page_start": null,
                    "page_end": null,
                    "symbol": "C",
                    "text": "amount, if any, payable to the Central Government by way of profit or production share as provided in agreement referred to in section 54."
                  }
                ]
              },
              "text_after_formula": ""
            },
            {
              "type": "subparagraph",
              "number": "4",
              "id": "schedule-X-3-4",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where any amount is withdrawn on closure of specified account in a tax year in which the business of the assessee is no longer in existence, sub-paragraph (3) shall apply as if the business is in existence in that tax year.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "5",
              "id": "schedule-X-3-5",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "If any amount standing to the credited of the assessee—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-3-5-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "in the specified account is released by the State Bank of India; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-3-5-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is withdrawn by the assessee from the site restoration account,",
                  "children": []
                }
              ],
              "text_after_clauses": "during any tax year for utilisation for the purposes of such business as per the special scheme or deposit scheme and the same is not so utilised, either wholly or in part within that tax year, such amount shall be deemed to be the profits and gains of business of that tax year and accordingly be charged to income-tax for that tax year."
            },
            {
              "type": "subparagraph",
              "number": "6",
              "id": "schedule-X-3-6",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where any amount standing to the credit of the assessee in the special account or in the Site Restoration Account is utilised by the assessee for the purposes of any expenditure in connection with such business in accordance with the scheme or the deposit scheme, such expenditure shall not be allowed in computing the income chargeable under the head \"Profits and gains of business or profession\".",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "4",
          "id": "schedule-X-4",
          "title": "No deduction of expenditure met through amount withdrawn from specified account.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-X-4-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "If the amount standing to the credit of the assessee in the specified account is utilised to incur any expenditure for the purpose of business as per the special scheme or deposit scheme, no deduction against such expenditure shall be allowed in computing the income chargeable under the head \"Profits and gains of business or profession\".",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-X-4-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "In this paragraph, \"amount standing to the credit of the assessee in the specified account\" includes interest to such accounts.",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "5",
          "id": "schedule-X-5",
          "title": "Sale or transfer of asset acquired as per special scheme or deposit scheme.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-X-5-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where any asset,--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-5-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is acquired as per the special scheme or the deposit scheme; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-5-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is sold or transferred to any person in the tax year at any time before the expiry of eight years from the end of tax year in which it was acquired,",
                  "children": []
                }
              ],
              "text_after_clauses": "then, the part of cost of asset as is relatable to the deduction allowed under paragraph 1 shall be deemed to be the profits and gains of business of the tax year in which such asset is sold or transferred and shall accordingly be charged to income-tax for that tax year."
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-X-5-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Sub-paragraph (1) shall not apply, if the asset is sold or transferred by—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-5-2-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "the assessee to the specified person; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-5-2-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a firm to a company in connection with succession of business or profession of the firm by such company subject to the following conditions:—",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "schedule-X-5-2-b-i",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "the provisions of special scheme or deposit scheme is applicable to the company in the same manner as it applied to the firm;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "schedule-X-5-2-b-ii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "all the properties of the firm relating to the business or profession immediately before the succession becomes the properties of the company;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iii",
                      "id": "schedule-X-5-2-b-iii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "all the liabilities of the firm relating to the business or profession immediately before the succession becomes the liabilities of the company; and"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iv",
                      "id": "schedule-X-5-2-b-iv",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "all the shareholders of the company were partners of the firm immediately before the succession."
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-X-5-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "In this paragraph, \"specified person\" means—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-X-5-3-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "Government; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-X-5-3-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a local authority; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "schedule-X-5-3-c",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a corporation established by or under a Central, State or Provincial Act; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "schedule-X-5-3-d",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a Government company as defined in section 2(45) of the Companies Act, 2013 (18 of 2013).",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "6",
          "id": "schedule-X-6",
          "title": "Interpretation.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_clauses": "For the purposes of this Schedule,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "schedule-X-6-a",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"amount standing to the credit of the assessee\" pertaining to the specified account includes interest accrued to such accounts;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "schedule-X-6-b",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"deposit scheme\" means a scheme made in this behalf by the Ministry of Petroleum and Natural Gas;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "schedule-X-6-c",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"specified account\" means a special account or site restoration account;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "schedule-X-6-d",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"special account\" means an account maintained with the State Bank of India for making deposits in accordance with, and for the purposes specified in the special scheme;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "schedule-X-6-e",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"special scheme\" means a scheme approved in this behalf by the Government of India in the Ministry of Petroleum and Natural Gas;",
