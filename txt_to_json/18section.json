{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "18",
      "id": "18",
      "title": "Profits in lieu of salary.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "18-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this Part, \"profits in lieu of salary\" includes,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "18-1-a",
              "x": 40.8,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the amount of any compensation due to, or received by, an assessee from his employer or former employer at or in connection with the—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "18-1-a-i",
                  "x": 71.75,
                  "y_start": 106.05,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "termination of his employment; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "18-1-a-ii",
                  "x": 69.33,
                  "y_start": 116.66,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "modification of the terms and conditions relating thereto;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "18-1-b",
              "x": 40.8,
              "y_start": 127.26,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any amount due to, or received, whether in lump sum or otherwise, by any assessee from any person—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "18-1-b-i",
                  "x": 71.75,
                  "y_start": 137.87,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "before his joining any employment with that person; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "18-1-b-ii",
                  "x": 69.33,
                  "y_start": 148.48,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "after cessation of his employment with that person;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "18-1-c",
              "x": 41.27,
              "y_start": 159.09,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any payment due to or received by an assessee—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "18-1-c-i",
                  "x": 71.75,
                  "y_start": 169.7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from an employer or a former employer; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "18-1-c-ii",
                  "x": 69.33,
                  "y_start": 180.31,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from a provident or other fund, to the extent to which it does not consist of contributions by the assessee or interest on such contributions; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "18-1-c-iii",
                  "x": 66.91,
                  "y_start": 200.46,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any sum received under a Keyman insurance policy as defined in Schedule II (Note 1), including the sum allocated by way of bonus on such policy.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "18-2",
          "x": 27.62,
          "y_start": 221.68,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The payment referred in sub-section (1)(c) shall not include any payment referred to in—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "18-2-a",
              "x": 40.8,
              "y_start": 236.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule II (Table: Sl. No. 3);",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "18-2-b",
              "x": 40.8,
              "y_start": 246.61,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule II (Table: Sl. No. 4);",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "18-2-c",
              "x": 41.27,
              "y_start": 257.22,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule II (Table: Sl. No. 8); and",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "18-2-d",
              "x": 40.8,
              "y_start": 267.83,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule III (Table: Sl. No. 11).",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
