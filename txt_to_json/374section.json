      "type": "section",
      "number": "374",
      "id": "374",
      "title": "Interpretation of \"High Court\".",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_sub_clauses": "For the purposes of this Chapter, \"High Court\" means,—",
      "sub_clauses": [
        {
          "type": "sub_clause",
          "number": "i",
          "id": "374-i",
          "x": 42.68,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text": "for any State, the High Court for that State;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "ii",
          "id": "374-ii",
          "x": 40.26,
          "y_start": 106.05,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Jammu and Kashmir, the High Court of Jammu and Kashmir and Ladakh;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "iii",
          "id": "374-iii",
          "x": 37.84,
          "y_start": 116.66,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Ladakh, the High Court of Jammu and Kashmir and Ladakh;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "iv",
          "id": "374-iv",
          "x": 38.85,
          "y_start": 127.26,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of the Andaman and Nicobar Islands, the High Court at Calcutta;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "v",
          "id": "374-v",
          "x": 41.27,
          "y_start": 137.87,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Lakshadweep, the High Court of Kerala;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "vi",
          "id": "374-vi",
          "x": 38.85,
          "y_start": 148.48,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Chandigarh, the High Court of Punjab and Haryana;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "vii",
          "id": "374-vii",
          "x": 36.43,
          "y_start": 159.09,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territories of Dadra and Nagar Haveli and Daman and Diu, the High Court at Bombay;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "viii",
          "id": "374-viii",
          "x": 34.01,
          "y_start": 169.7,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Puducherry, the High Court at Madras; and",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "ix",
          "id": "374-ix",
          "x": 38.85,
          "y_start": 180.31,
          "page_start": 1,
          "page_end": 1,
          "text": "for the National Capital Territory of Delhi, the High Court of Delhi.",
          "children": []
        }
      ],
      "text_after_sub_clauses": ""
    }
  ],
