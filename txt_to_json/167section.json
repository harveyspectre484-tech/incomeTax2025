      "id": "167",
      "title": "Power of Board to make safe harbour rules.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "167-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The determination of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "167-1-a",
              "x": 40.8,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text": "income referred to in section 9(2); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "167-1-b",
              "x": 40.8,
              "y_start": 106.05,
              "page_start": 1,
              "page_end": 1,
              "text": "arm's length price under section 165 or 166,",
              "children": []
            }
          ],
          "text_after_clauses": "shall be subject to safe harbour rules."
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "167-2",
          "x": 27.62,
          "y_start": 133.1,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of sub-section (1), the Board may make rules for safe harbour.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "167-3",
          "x": 27.62,
          "y_start": 148.48,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, \"safe harbour\" means circumstances in which the income-tax authorities shall accept,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "167-3-a",
              "x": 40.8,
              "y_start": 163.33,
              "page_start": 1,
              "page_end": 1,
              "text": "the transfer price; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "167-3-b",
              "x": 40.8,
              "y_start": 173.94,
              "page_start": 1,
              "page_end": 1,
              "text": "the income, deemed to accrue or arise under section 9(2),",
              "children": []
            }
          ],
          "text_after_clauses": "declared by the assessee."
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
