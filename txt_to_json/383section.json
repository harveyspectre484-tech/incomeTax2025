  "sections": [
    {
      "type": "section",
      "number": "383",
      "id": "383",
      "title": "Application for advance ruling.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "383-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text": "An applicant desirous of obtaining an advance ruling under this Chapter, may make an application in such form and manner, as may be prescribed, stating the question on which the advance ruling is sought.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "383-2",
          "x": 27.62,
          "y_start": 109.23,
          "page_start": 1,
          "page_end": 1,
          "text": "The application shall be accompanied by a fee, as may be prescribed.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "383-3",
          "x": 27.62,
          "y_start": 124.61,
          "page_start": 1,
          "page_end": 1,
          "text": "An applicant may withdraw an application within thirty days from the date of the application.",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
