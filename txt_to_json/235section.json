{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "235",
      "id": "235",
      "title": "Interpretation.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "For the purposes of this Part,—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "235-a",
          "x": 40.8,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text": "\"bareboat charter\" means hiring of a ship or inland vessel, as the case may be, for a stipulated period on terms which give the charterer possession and control of the ship or inland vessel, as the case may be, including the right to appoint the master and crew;",
          "children": []
        },
        {
          "type": "clause",
          "number": "b",
          "id": "235-b",
          "x": 40.8,
          "y_start": 115.6,
          "page_start": 1,
          "page_end": 1,
          "text": "\"bareboat charter-cum-demise\" means a bareboat charter where the ownership of the ship or inland vessel, as the case may be, is intended to be transferred after a specified period to the company to whom it has been chartered;",
          "children": []
        },
        {
          "type": "clause",
          "number": "c",
          "id": "235-c",
          "x": 41.27,
          "y_start": 135.75,
          "page_start": 1,
          "page_end": 1,
          "text": "\"Director-General of Shipping\" means the Director-General of Shipping appointed by the Central Government under section 7(1) of the Merchant Shipping Act, 1958 (44 of 1958);",
          "children": []
        },
        {
          "type": "clause",
          "number": "d",
          "id": "235-d",
          "x": 40.8,
          "y_start": 155.91,
          "page_start": 1,
          "page_end": 1,
          "text": "\"factory ship\" includes a vessel providing processing services in respect of processing of the fishing produce;",
          "children": []
        },
        {
          "type": "clause",
          "number": "e",
          "id": "235-e",
          "x": 41.27,
          "y_start": 166.52,
          "page_start": 1,
          "page_end": 1,
          "text": "\"fishing vessel\" shall have the meaning assigned to it in section 3(12) of the Merchant Shipping Act, 1958 (44 of 1958);",
          "children": []
        },
        {
          "type": "clause",
          "number": "f",
          "id": "235-f",
          "x": 42.68,
          "y_start": 177.12,
          "page_start": 1,
          "page_end": 1,
          "text": "\"inland vessel\" shall have the meaning assigned to it in section 3(q) of the Inland Vessels Act, 2021 (24 of 2021);",
          "children": []
        },
        {
          "type": "clause",
          "number": "fa",
          "id": "235-fa",
          "x": 42.68,
          "y_start": 177.12,
          "page_start": 1,
          "page_end": 1,
          "footnote_refs": [
            "42"
          ],
          "text": "\"Inland Waterways Authority of India\" shall have the same meaning as assigned to it in section 3 of the Inland Waterways Authority of India Act,1985 (82 of 1985);]",
          "children": []
        },
        {
          "type": "clause",
          "number": "g",
          "id": "235-g",
          "x": 40.8,
          "y_start": 207.89,
          "page_start": 1,
          "page_end": 1,
          "text": "\"pleasure craft\" means a ship or inland vessel, as the case may be, of a kind whose primary use is for the purposes of sport or recreation;",
          "children": []
        },
        {
          "type": "clause",
          "number": "h",
          "id": "235-h",
          "x": 40.8,
          "y_start": 218.5,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "\"qualifying company\" means a company, if—",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "235-h-i",
              "x": 71.75,
              "y_start": 229.11,
              "page_start": 1,
              "page_end": 1,
              "text": "it is an Indian company;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "235-h-ii",
              "x": 69.33,
              "y_start": 239.72,
              "page_start": 1,
              "page_end": 1,
              "text": "the place of effective management of the company is in India;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "235-h-iii",
              "x": 66.91,
              "y_start": 250.32,
              "page_start": 1,
              "page_end": 1,
              "text": "it owns at least one qualifying ship; and",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "235-h-iv",
              "x": 67.93,
              "y_start": 260.93,
              "page_start": 1,
              "page_end": 1,
              "text": "the main object of the company is to carry on the business of operating ships,",
              "children": []
            }
          ],
          "explanation_block": {
            "type": "explanation_block",
            "id": "235-h-explanation",
            "x": 68.93,
            "y_start": 282.15,
            "page_start": 1,
            "page_end": 1,
            "text_before_items": "and for the purposes of sub-clause (ii), \"place of effective management of the company\" means—",
            "items": [
              {
                "type": "item",
                "number": "A",
                "id": "235-h-explanation-A",
                "x": 68.93,
                "y_start": 282.15,
                "page_start": 1,
                "page_end": 1,
                "text": "the place where the board of directors of the company or its executive directors, make their decisions; or",
                "children": []
              },
              {
                "type": "item",
                "number": "B",
                "id": "235-h-explanation-B",
                "x": 68.93,
                "y_start": 292.76,
                "page_start": 1,
                "page_end": 1,
                "text": "in a case where the board of directors routinely approve the commercial and strategic decisions made by the executive directors or officers of the company, the place where such executive directors or officers of the company perform their functions;",
                "children": []
              }
            ],
            "text_after_items": ""
          },
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "i",
          "id": "235-i",
          "x": 42.68,
          "y_start": 312.91,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "\"qualifying ship\" means a ship or inland vessel, as the case may be, if—",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "235-i-i",
              "x": 71.75,
              "y_start": 323.52,
              "page_start": 1,
              "page_end": 1,
              "text": "it is a seagoing ship or vessel or inland vessel, as the case may be, of fifteen net tonnage or more;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "235-i-ii",
              "x": 69.33,
              "y_start": 334.13,
              "page_start": 1,
              "page_end": 1,
              "text": "it is a ship registered under the Merchant Shipping Act, 1958 (44 of 1958), or a ship registered outside India in respect of which a licence has been issued by the Director-General of Shipping under section 406 or 407 of said Act or an inland vessel registered under the Inland Vessels Act, 2021 (24 of 2021), as the case may be; and",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "235-i-iii",
              "x": 66.91,
              "y_start": 363.84,
              "page_start": 1,
              "page_end": 1,
              "text": "a valid certificate in respect of such ship or inland vessel, as the case may be, indicating its net tonnage is in force,",
              "children": []
            }
          ],
          "exclusion_block": {
            "type": "exclusion_block",
            "id": "235-i-exclusions",
            "x": 68.93,
            "y_start": 385.05,
            "page_start": 1,
            "page_end": 1,
            "text_before_items": "but does not include—",
            "items": [
              {
                "type": "item",
                "number": "A",
                "id": "235-i-exclusions-A",
                "x": 68.93,
                "y_start": 385.05,
                "page_start": 1,
                "page_end": 1,
                "text": "a seagoing ship or vessel or inland vessel, as the case may be, if the main purpose for which it is used is the provision of goods or services of a kind normally provided on land;",
                "children": []
              },
              {
                "type": "item",
                "number": "B",
                "id": "235-i-exclusions-B",
                "x": 68.93,
                "y_start": 405.21,
                "page_start": 1,
                "page_end": 1,
                "text": "fishing vessels;",
                "children": []
              },
              {
                "type": "item",
                "number": "C",
                "id": "235-i-exclusions-C",
                "x": 68.46,
                "y_start": 415.82,
                "page_start": 1,
                "page_end": 1,
                "text": "factory ships;",
                "children": []
              },
              {
                "type": "item",
                "number": "D",
                "id": "235-i-exclusions-D",
                "x": 67.98,
                "y_start": 426.43,
                "page_start": 1,
                "page_end": 1,
                "text": "pleasure crafts;",
                "children": []
              },
              {
                "type": "item",
                "number": "E",
                "id": "235-i-exclusions-E",
                "x": 68.93,
                "y_start": 437.03,
                "page_start": 1,
                "page_end": 1,
                "text": "harbour and river ferries;",
                "children": []
              },
              {
                "type": "item",
                "number": "F",
                "id": "235-i-exclusions-F",
                "x": 68.93,
                "y_start": 447.64,
                "page_start": 1,
                "page_end": 1,
                "text": "offshore installations; and",
                "children": []
              },
              {
                "type": "item",
                "number": "G",
                "id": "235-i-exclusions-G",
                "x": 67.98,
                "y_start": 458.25,
                "page_start": 1,
                "page_end": 1,
                "text": "a qualifying ship which is used as a fishing vessel for more than thirty days during a tax year;",
                "children": []
              }
            ],
            "text_after_items": ""
          },
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "j",
          "id": "235-j",
          "x": 42.68,
          "y_start": 468.86,
          "page_start": 1,
          "page_end": 1,
          "text": "\"seagoing ship\" means a ship, if it is certified as such by the competent authority of any country;",
          "children": []
        },
        {
          "type": "clause",
          "number": "k",
          "id": "235-k",
          "x": 41.27,
          "y_start": 479.47,
          "page_start": 1,
          "page_end": 1,
          "text": "\"tonnage income\" means the income of a tonnage tax company computed as per the provisions of this Part of the Chapter;",
          "children": []
        },
        {
          "type": "clause",
          "number": "l",
          "id": "235-l",
          "x": 42.68,
          "y_start": 490.08,
          "page_start": 1,
          "page_end": 1,
          "text": "\"tonnage tax activities\" means the activities referred to in section 228(3) and (7);",
          "children": []
        },
        {
          "type": "clause",
          "number": "m",
          "id": "235-m",
          "x": 38.91,
          "y_start": 500.69,
          "page_start": 1,
          "page_end": 1,
          "text": "\"tonnage tax business\" means the business of operating qualifying ships giving rise to relevant shipping income as referred to in section 228(1);",
          "children": []
        },
        {
          "type": "clause",
          "number": "n",
          "id": "235-n",
          "x": 40.8,
          "y_start": 511.29,
          "page_start": 1,
          "page_end": 1,
          "text": "\"tonnage tax company\" means a qualifying company in relation to which tonnage tax option is in force;",
          "children": []
        },
        {
          "type": "clause",
          "number": "o",
          "id": "235-o",
          "x": 40.8,
          "y_start": 521.9,
          "page_start": 1,
          "page_end": 1,
          "text": "\"tonnage tax scheme\" means a scheme for computation of profits and gains of business of operating qualifying ships under the provisions of this Part.",
          "children": []
        }
      ],
      "text_after_clauses": ""
    }
  ],
  "footnotes": [
    {
      "type": "footnote",
      "number": "42",
      "text": "Ins. by Act No. 4 of 2026, w.e.f. 1-4-2026.",
      "page_start": 1,
      "page_end": 1,
      "referenced_by": [
        "235-fa"
      ]
    }
  ],
  "orphans": []
}