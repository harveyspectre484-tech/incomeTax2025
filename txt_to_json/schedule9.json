{
  "schedules": [
    {
      "type": "schedule",
      "number": "IX",
      "id": "schedule-IX",
      "reference_text": "[See section 48]",
      "reference_section": "48",
      "title": "DEDUCTION FOR TEA DEVELOPMENT ACCOUNT, COFFEE DEVELOPMENT ACCOUNT AND RUBBER DEVELOPMENT ACCOUNT FOR COMPUTING INCOME UNDER THE HEAD \"PROFITS AND GAINS OF BUSINESS OR PROFESSION\"",
      "act": "Income-tax Act, 2025",
      "source_url": "https://www.incometaxindia.gov.in/w/schedule-ix-3",
      "source_year": "2026",
      "x": null,
      "y_start": null,
      "page_start": null,
      "page_end": null,
      "text_before_paragraphs": "",
      "paragraphs": [
        {
          "type": "paragraph",
          "number": "1",
          "id": "schedule-IX-1",
          "title": "Quantum of deduction.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-IX-1-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "An assessee shall be allowed deduction of,--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-1-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "the amount or aggregate of the amounts deposited by the assessee in the account as specified in paragraph 2; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-1-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "40% of the profits of such business computed under the head \"Profits and gains of business or profession\" before making any deduction under this paragraph,",
                  "children": []
                }
              ],
              "text_after_clauses": "whichever is less."
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-IX-1-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "The deduction shall be allowed before allowing set off of loss, if any, brought forward from earlier tax years as per section 112.",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "2",
          "id": "schedule-IX-2",
          "title": "Conditions for claiming deduction.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-IX-2-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "The deduction under paragraph 1 shall be allowed if the assessee--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-2-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is carrying on the business of growing and manufacturing tea or coffee or rubber in India during the tax year;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-2-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "has, before the expiry of six months from the end of the tax year or before the due date of furnishing the return of his income, whichever is earlier, deposited any amount in the specified account being,—",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "schedule-IX-2-1-b-i",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "a special account maintained with the National Bank in accordance with, and for the purposes specified in the special scheme; or"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "schedule-IX-2-1-b-ii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "a deposit account in accordance with, and for the purposes specified in the deposit scheme; and"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "schedule-IX-2-1-c",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "gets the accounts of such business for the relevant tax year audited by an accountant before the specified date referred to in section 63 and furnishes the audit report, in such form and manner as may be prescribed and verified by such accountant, by that date.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-IX-2-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where the assessee is required, by or under any other law, to get his accounts audited, then it shall be sufficient compliance of sub-paragraph (1)(c), if such assessee—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-2-2-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "gets the accounts of such business audited under such law before the specified date referred to in section 63; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-2-2-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "furnishes by that date the report of such audit and a report by an accountant in the form referred to in sub-paragraph (1)(c).",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-IX-2-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "If any deduction has been allowed under paragraph 1 in any tax year, no deduction shall be allowed in respect of such amount in any other tax year.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "4",
              "id": "schedule-IX-2-4",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where the assessee referred to in paragraph 1 is a firm or an association of persons or body of individuals, the deduction under paragraph 1 shall not be allowed in computing the income of any of the partners or members of such assessee.",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "3",
          "id": "schedule-IX-3",
          "title": "Withdrawal from special account or deposit account.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-IX-3-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Any amount standing to the credit of the assessee in the specified account shall not be allowed to be withdrawn except for the purpose specified in the special scheme or, in the deposit scheme, or in the circumstances specified below:—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-3-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "closure of business; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-3-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "death of an assessee; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "schedule-IX-3-1-c",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "partition of a Hindu undivided family; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "schedule-IX-3-1-d",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "dissolution of a firm; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "e",
                  "id": "schedule-IX-3-1-e",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "liquidation of a company.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-IX-3-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "If any amount standing to the credit of the assessee in the specified account, is withdrawn during any tax year by the assessee in the circumstance referred to in sub-paragraph (1)(a) and (1)(d), the whole of such amount shall be deemed to be the profits and gains of business or profession of that tax year and shall accordingly be charged to income-tax for that tax year, as if the business had not been closed or, the firm had not been dissolved respectively.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-IX-3-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Irrespective of anything contained in sub-paragraph (1), if --",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-3-3-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "any amount standing to the credit of the assessee in the specified account is released by the National Bank or withdrawn by the assessee from the Deposit account, during any tax year; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-3-3-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "such amount is utilised for the purchase of specified articles or thing,",
                  "children": []
                }
              ],
              "text_after_clauses": "then whole of such amount so utilised shall be deemed to be the profits and gains of business of that tax year and shall accordingly be charged to income-tax for that tax year."
            },
            {
              "type": "subparagraph",
              "number": "4",
              "id": "schedule-IX-3-4",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "If any amount standing to the credit of the assessee--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-3-4-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "in the specified account is released by the National Bank; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-3-4-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is withdrawn by the assessee from the deposit account,",
                  "children": []
                }
              ],
              "text_after_clauses": "during any tax year for utilisation for the purposes of such business as per the special scheme or deposit scheme and the same is not so utilised, either wholly or partly, within that tax year, such amount not so utilised shall be deemed to be the profits and gains of business of that tax year and shall accordingly be charged to income-tax for that tax year."
            },
            {
              "type": "subparagraph",
              "number": "5",
              "id": "schedule-IX-3-5",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "The provisions of sub-paragraph (4) shall not apply in cases where amount is released during any tax year on closure of the account in circumstances referred to in sub-paragraphs (1)(b), (1)(c) and (1)(e).",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "6",
              "id": "schedule-IX-3-6",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "In sub-paragraph (3), \"specified article or thing\" means—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-3-6-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "any machinery or plant to be installed in any office premises or residential accommodation, including any accommodation in the nature of a guest-house;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-3-6-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "any office appliances (not being computers);",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "schedule-IX-3-6-c",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "any machinery or plant, the whole of the actual cost of which is allowed as a deduction (whether by way of depreciation or otherwise) in computing the income chargeable under the head \"Profits and gains of business or profession\" of any one tax year;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "schedule-IX-3-6-d",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "any new machinery or plant to be installed in an industrial undertaking for the purposes of business of construction, manufacture or production of any article or thing specified in the list in Schedule XIII.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "4",
          "id": "schedule-IX-4",
          "title": "No deduction of expenditure met through the amount withdrawn from specified account.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_clauses": "If the amount standing to the credit of the assessee in specified account is utilised to incur any expenditure for the purpose of such business as per the special scheme or deposit scheme, no deduction against such expenditure shall be allowed in computing the income chargeable under the head \"Profits and gains of business or profession\".",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "paragraph",
          "number": "5",
          "id": "schedule-IX-5",
          "title": "Sale or transfer of asset acquired as per special scheme or deposit scheme.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_subparagraphs": "",
          "subparagraphs": [
            {
              "type": "subparagraph",
              "number": "1",
              "id": "schedule-IX-5-1",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "Where any asset,--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-5-1-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is acquired in accordance with the special scheme or the deposit scheme; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-5-1-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "is sold or transferred to any person in the tax year at any time before expiry of eight years from the end of tax year in which such asset was acquired,",
                  "children": []
                }
              ],
              "text_after_clauses": "then, the part of cost of asset which is relatable to the deduction allowed under paragraph 1 shall be deemed to be the profits and gains of business of the tax year in which such asset is sold or transferred and shall accordingly be charged to income-tax for that tax year."
            },
            {
              "type": "subparagraph",
              "number": "2",
              "id": "schedule-IX-5-2",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "The provisions of sub-paragraph (1) shall not apply, if the asset is sold or transferred—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-5-2-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "by the assessee to the specified person; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-5-2-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "by a firm to a company in connection with succession of business or profession of the firm by such company subject to the following conditions:--",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "schedule-IX-5-2-b-i",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "the provisions of special scheme or deposit scheme is applicable to the company in the same manner as it applied to the firm;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "schedule-IX-5-2-b-ii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "all the properties of the firm relating to the business or profession immediately before the succession become the properties of the company;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iii",
                      "id": "schedule-IX-5-2-b-iii",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "all the liabilities of the firm relating to the business or profession immediately before the succession become the liabilities of the company; and"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iv",
                      "id": "schedule-IX-5-2-b-iv",
                      "x": null,
                      "y_start": null,
                      "page_start": null,
                      "page_end": null,
                      "text": "all the shareholders of the company were partners of the firm immediately before the succession."
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subparagraph",
              "number": "3",
              "id": "schedule-IX-5-3",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text_before_clauses": "In this paragraph, \"specified person\" means,--",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "schedule-IX-5-3-a",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "Government; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "schedule-IX-5-3-b",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a local authority; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "schedule-IX-5-3-c",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a corporation established by or under a Central, State or Provincial Act; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "schedule-IX-5-3-d",
                  "x": null,
                  "y_start": null,
                  "page_start": null,
                  "page_end": null,
                  "text": "a Government company as defined in section 2(45) of the Companies Act, 2013 (18 of 2013).",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            }
          ],
          "text_after_subparagraphs": ""
        },
        {
          "type": "paragraph",
          "number": "6",
          "id": "schedule-IX-6",
          "title": "Interpretation.",
          "x": null,
          "y_start": null,
          "page_start": null,
          "page_end": null,
          "text_before_clauses": "For the purposes of this Schedule,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "schedule-IX-6-a",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"Coffee Board\" means the Coffee Board constituted under section 4 of the Coffee Act, 1942 (7 of 1942);",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "schedule-IX-6-b",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"deposit account\" means an account opened by the assessee for making deposits by the assessee in accordance with and for the purposes specified in the deposit scheme;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "schedule-IX-6-c",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"deposit scheme\" means the scheme made by the Tea Board or the Coffee Board or the Rubber Board, with the prior approval of the Central Government;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "schedule-IX-6-d",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"National Bank\" means the National Bank for Agriculture and Rural Development established under section 3 of the National Bank for Agriculture and Rural Development Act, 1981 (61 of 1981);",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "schedule-IX-6-e",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"Rubber Board\" means the Rubber Board constituted under section 4(1) of the Rubber Act, 1947 (24 of 1947);",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "schedule-IX-6-f",
              "x": null,
              "y_start": null,
              "page_start": null,
              "page_end": null,
              "text": "\"special account\" means an account maintained by the assessee with the National Bank for making deposits in accordance with and for the purposes specified in the special scheme;",
              "children": []
            },
            {
              "type": "clause",
