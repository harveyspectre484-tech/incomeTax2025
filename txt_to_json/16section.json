  "sections": [
    {
      "type": "section",
      "number": "16",
      "id": "16",
      "title": "Income from salary.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "For the purposes of this Part, \"salary\" includes—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "16-a",
          "x": 40.8,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text": "wages;",
          "children": []
        },
        {
          "type": "clause",
          "number": "b",
          "id": "16-b",
          "x": 40.8,
          "y_start": 106.05,
          "page_start": 1,
          "page_end": 1,
          "text": "any annuity or pension;",
          "children": []
        },
        {
          "type": "clause",
          "number": "c",
          "id": "16-c",
          "x": 41.27,
          "y_start": 116.66,
          "page_start": 1,
          "page_end": 1,
          "text": "any gratuity;",
          "children": []
        },
        {
          "type": "clause",
          "number": "d",
          "id": "16-d",
          "x": 40.8,
          "y_start": 127.26,
          "page_start": 1,
          "page_end": 1,
          "text": "any fees or commission;",
          "children": []
        },
        {
          "type": "clause",
          "number": "e",
          "id": "16-e",
          "x": 41.27,
          "y_start": 137.87,
          "page_start": 1,
          "page_end": 1,
          "text": "perquisites;",
          "children": []
        },
        {
          "type": "clause",
          "number": "f",
          "id": "16-f",
          "x": 42.68,
          "y_start": 148.48,
          "page_start": 1,
          "page_end": 1,
          "text": "profits in lieu of, or in addition to, any salary or wages;",
          "children": []
        },
        {
          "type": "clause",
          "number": "g",
          "id": "16-g",
          "x": 40.8,
          "y_start": 159.09,
          "page_start": 1,
          "page_end": 1,
          "text": "any advance of salary;",
          "children": []
        },
        {
          "type": "clause",
          "number": "h",
          "id": "16-h",
          "x": 40.8,
          "y_start": 169.7,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "any payment received by an employee in respect of any period of leave not availed of by him;",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "16-h-i",
              "x": 42.68,
              "y_start": 180.31,
              "page_start": 1,
              "page_end": 1,
              "text": "the annual accretion to the balance at the credit of an employee participating in a recognised provident fund, to the extent to which it is chargeable to tax as per paragraph 6 of Part A of Schedule XI;",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "j",
          "id": "16-j",
          "x": 42.68,
          "y_start": 200.46,
          "page_start": 1,
          "page_end": 1,
          "text": "the aggregate of all sums that are comprised in the transferred balance as referred to in paragraph 11(2) of Part A of Schedule XI of an employee participating in a recognised provident fund, to the extent to which it is chargeable to tax under sub-paragraphs (4) and (5) thereof;",
          "children": []
        },
        {
          "type": "clause",
          "number": "k",
          "id": "16-k",
          "x": 41.27,
          "y_start": 220.62,
          "page_start": 1,
          "page_end": 1,
          "text": "the contribution made by the Central Government or any other employer in any tax year, to the account of an employee under a pension scheme referred to in section 124; and",
          "children": []
        },
        {
          "type": "clause",
          "number": "l",
          "id": "16-l",
          "x": 42.68,
          "y_start": 240.78,
          "page_start": 1,
          "page_end": 1,
          "text": "the contribution made by the Central Government in any tax year, to the Agniveer Corpus Fund account of an individual enrolled in the Agnipath Scheme referred to in section 125.",
          "children": []
        }
      ],
      "text_after_clauses": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
