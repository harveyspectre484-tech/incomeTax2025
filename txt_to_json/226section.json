{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "226",
      "id": "226",
      "title": "Tonnage tax scheme.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "226-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In this Part, a company shall—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "226-1-a",
              "x": 40.8,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text": "be regarded as operating a ship or inland vessel, as the case may be, if it operates any ship or inland vessel, as the case may be, whether owned or chartered by it and includes a case where even a part of the ship or inland vessel, as the case may be, has been chartered in by it in an arrangement such as slot charter, space charter or joint charter;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "226-1-b",
              "x": 40.8,
              "y_start": 125.14,
              "page_start": 1,
              "page_end": 1,
              "text": "not be regarded as operating a ship or inland vessel, as the case may be, which has been chartered out by it on bareboat charter-cum-demise terms or on bareboat charter terms for a period exceeding three years.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "226-2",
          "x": 27.62,
          "y_start": 146.36,
          "page_start": 1,
          "page_end": 1,
          "text": "A tonnage tax company engaged in the business of operating qualifying ships shall compute the profits from such business under the tonnage tax scheme.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "226-3",
          "x": 27.62,
          "y_start": 174.47,
          "page_start": 1,
          "page_end": 1,
          "text": "The tonnage tax business shall be considered as a separate business distinct from all other activities or business carried on by the company.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "226-4",
          "x": 27.62,
          "y_start": 189.85,
          "page_start": 1,
          "page_end": 1,
          "text": "The profits referred to in sub-section (2) shall be computed separately from the profits and gains from any other business.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "226-5",
          "x": 27.62,
          "y_start": 205.77,
          "page_start": 1,
          "page_end": 1,
          "text": "The tonnage tax scheme shall apply only if an option to that effect is made as per section 231.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "226-6",
          "x": 27.62,
          "y_start": 221.15,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where a company engaged in the business of operating qualifying ships,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "226-6-a",
              "x": 40.8,
              "y_start": 235.47,
              "page_start": 1,
              "page_end": 1,
              "text": "is not covered under the tonnage tax scheme; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "226-6-b",
              "x": 40.8,
              "y_start": 246.08,
              "page_start": 1,
              "page_end": 1,
              "text": "has not made an option in respect of the tonnage tax scheme as per section 231,",
              "children": []
            }
          ],
          "text_after_clauses": "the profits and gains of such company from such business shall be computed as per other provisions of this Act."
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "226-7",
          "x": 27.62,
          "y_start": 273.66,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Subject to the other provisions of this Part,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "226-7-a",
              "x": 40.8,
              "y_start": 287.98,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the tonnage income, shall be—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "226-7-a-i",
                  "x": 71.75,
                  "y_start": 298.59,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "computed as per section 227;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "226-7-a-ii",
                  "x": 69.33,
                  "y_start": 309.2,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "deemed to be the profits chargeable under the head \"Profits and gains of business or profession\"; and",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "226-7-b",
              "x": 40.8,
              "y_start": 319.81,
              "page_start": 1,
              "page_end": 1,
              "text": "the relevant shipping income referred to in section 228(1) shall not be chargeable to tax.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
