      "page_end": 1,
      "text_before_children": "GENERAL ANTI-AVOIDANCE RULE",
      "children": [
        {
          "type": "section",
          "number": "178",
          "id": "178",
          "title": "Applicability of General Anti-Avoidance Rule.",
          "x": 27.62,
          "y_start": 111.88,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "",
          "subsections": [
            {
              "type": "subsection",
              "number": "1",
              "id": "178-1",
              "x": 27.62,
              "y_start": 111.88,
              "page_start": 1,
              "page_end": 1,
              "text": "Irrespective of anything contained in this Act, an arrangement entered into by an assessee may be declared to be an impermissible avoidance arrangement and the consequence in relation to tax arising from it may be determined subject to the provisions of this Chapter.",
              "children": []
            },
            {
              "type": "subsection",
              "number": "2",
              "id": "178-2",
              "x": 27.62,
              "y_start": 139.99,
              "page_start": 1,
              "page_end": 1,
              "text": "The provisions of this Chapter may be applied to any step in, or a part of, the arrangement as they are applicable to the arrangement.",
              "children": []
            }
          ],
          "text_after_subsections": ""
        }
      ],
      "text_after_children": ""
    }
  ],
