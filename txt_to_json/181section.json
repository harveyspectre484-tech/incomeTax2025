{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "181",
      "id": "181",
      "title": "Consequences of impermissible avoidance arrangement.",
      "x": 27.62,
      "y_start": 115.6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "181-1",
          "x": 27.62,
          "y_start": 115.6,
          "page_start": 1,
          "page_end": 1,
          "text": "If an arrangement is declared to be an impermissible avoidance arrangement, then, the consequences, in relation to tax, of the arrangement, including denial of tax benefit or a benefit under a tax treaty, shall be determined, in the manner as deemed appropriate in the circumstances of the case.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "181-2",
          "x": 27.62,
          "y_start": 143.71,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The consequences of an arrangement declared to be an impermissible avoidance arrangement as referred to in sub-section (1) shall include but shall not be limited to the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "181-2-a",
              "x": 40.8,
              "y_start": 170.76,
              "page_start": 1,
              "page_end": 1,
              "text": "disregarding, combining or recharacterising any step in, or a part or whole of, the impermissible avoidance arrangement;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "181-2-b",
              "x": 40.8,
              "y_start": 181.37,
              "page_start": 1,
              "page_end": 1,
              "text": "treating the impermissible avoidance arrangement as if it had not been entered into or carried out;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "181-2-c",
              "x": 41.27,
              "y_start": 191.98,
              "page_start": 1,
              "page_end": 1,
              "text": "disregarding any accommodating party or treating any accommodating party and any other party as one and the same person;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "181-2-d",
              "x": 40.8,
              "y_start": 202.59,
              "page_start": 1,
              "page_end": 1,
              "text": "deeming persons who are connected persons in relation to each other to be one and the same person for the purposes of determining tax treatment of any amount;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "181-2-e",
              "x": 41.27,
              "y_start": 222.74,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "reallocating amongst the parties to the arrangement—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "181-2-e-i",
                  "x": 71.75,
                  "y_start": 233.35,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any accrual, or receipt, of a capital nature or revenue nature; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "181-2-e-ii",
                  "x": 69.33,
                  "y_start": 243.96,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any expenditure, deduction, relief or rebate;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "f",
              "id": "181-2-f",
              "x": 42.68,
              "y_start": 254.57,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "treating—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "181-2-f-i",
                  "x": 71.75,
                  "y_start": 265.18,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the place of residence of any party to the arrangement; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "181-2-f-ii",
                  "x": 69.33,
                  "y_start": 275.78,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the situs of an asset or of a transaction,",
                  "children": []
                }
              ],
              "text_after_sub_clauses": "at a place other than the place of residence, location of the asset or location of the transaction as provided under the arrangement; or"
            },
            {
              "type": "clause",
              "number": "g",
              "id": "181-2-g",
              "x": 40.8,
              "y_start": 297.0,
              "page_start": 1,
              "page_end": 1,
              "text": "considering or looking through any arrangement by disregarding any corporate structure.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "181-3",
          "x": 27.62,
          "y_start": 308.67,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "181-3-a",
              "x": 40.8,
              "y_start": 323.52,
              "page_start": 1,
              "page_end": 1,
              "text": "any equity may be treated as debt or vice versa;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "181-3-b",
              "x": 40.8,
              "y_start": 334.13,
              "page_start": 1,
              "page_end": 1,
              "text": "any accrual, or receipt, of a capital nature may be treated as of revenue nature or vice versa; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "181-3-c",
              "x": 41.27,
              "y_start": 344.74,
              "page_start": 1,
              "page_end": 1,
              "text": "any expenditure, deduction, relief or rebate may be recharacterised.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
