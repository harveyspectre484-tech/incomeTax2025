{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "353",
      "id": "353",
      "title": "Other violations.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "353-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where any registered non-profit organisation—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "353-1-a",
              "x": 40.8,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to maintain books of account under section 347; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "353-1-b",
              "x": 40.8,
              "y_start": 106.05,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to get books of account audited under section 348; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "353-1-c",
              "x": 41.27,
              "y_start": 116.66,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to furnish its return of income under section 349; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "353-1-d",
              "x": 40.8,
              "y_start": 127.26,
              "page_start": 1,
              "page_end": 1,
              "text": "carrying out advancement of any other object of general public utility, carries out any commercial activity in contravention of the provisions of section 346,",
              "children": []
            }
          ],
          "text_after_clauses": "during any tax year, its regular income for such tax year as reduced by the expenditure referred to in sub-section (3) shall be taxable regular income which shall be chargeable to tax as per the provisions of section 334."
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "353-2",
          "x": 27.62,
          "y_start": 176.59,
          "page_start": 1,
          "page_end": 1,
          "text": "Irrespective of the provisions of section 338, any specified income and residual income of the registered non-profit organisation, which is not included in sub-section (1) shall also be chargeable to tax under the provisions of section 334.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "353-3",
          "x": 27.62,
          "y_start": 204.71,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The expenditure referred to in sub-section (1) shall be the expenditure incurred in India (other than capital expenditure) for the objects of the registered non-profit organisation, subject to the fulfilment of the following conditions:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "353-3-a",
              "x": 40.8,
              "y_start": 232.29,
              "page_start": 1,
              "page_end": 1,
              "text": "such expenditure shall be incurred in India;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "353-3-b",
              "x": 40.8,
              "y_start": 242.9,
              "page_start": 1,
              "page_end": 1,
              "text": "such expenditure shall be for the objects of the registered non-profit organisation;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "353-3-c",
              "x": 41.27,
              "y_start": 253.51,
              "page_start": 1,
              "page_end": 1,
              "text": "such expenditure is not made from the corpus standing to the credit of the registered non-profit organisation as on the end of the tax year immediately preceding the tax year for which income is being computed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "353-3-d",
              "x": 40.8,
              "y_start": 273.66,
              "page_start": 1,
              "page_end": 1,
              "text": "such expenditure is not out of any loan or borrowing;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "353-3-e",
              "x": 41.27,
              "y_start": 284.27,
              "page_start": 1,
              "page_end": 1,
              "text": "the claim of depreciation is not in respect of an asset, acquisition of which has been claimed as application of income, in the same or any other tax year;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "353-3-f",
              "x": 42.68,
              "y_start": 304.43,
              "page_start": 1,
              "page_end": 1,
              "text": "such expenditure is not in the form of any contribution or donation to any person;",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "353-3-g",
              "x": 40.8,
              "y_start": 315.04,
              "page_start": 1,
              "page_end": 1,
              "text": "such expenditure is not on account of a payment or aggregate of payments made to a person in contravention to the provisions of section 36(4), (5),",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "353-6",
          "x": 55.2,
          "y_start": 324.58,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "and (7); and",
          "clauses": [
            {
              "type": "clause",
              "number": "h",
              "id": "353-6-h",
              "x": 40.8,
              "y_start": 335.19,
              "page_start": 1,
              "page_end": 1,
              "text": "such payment is allowable under section 35(b)(i).",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "353-4",
          "x": 27.62,
          "y_start": 346.86,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this section, no set off or deduction or allowance of any application or expenditure other than those referred to in sub-section (3) shall be allowed.",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
