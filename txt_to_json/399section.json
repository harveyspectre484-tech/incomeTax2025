{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "399",
      "id": "399",
      "title": "Processing.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "399-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "All statements of tax deducted at source or tax collected at source including a correction statement shall be processed in the following manner:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "399-1-a",
              "x": 40.8,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the amounts deductible or collectible under this Chapter shall be computed after making the following adjustments:—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "399-1-a-i",
                  "x": 71.75,
                  "y_start": 106.05,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any arithmetical error in the statement; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "399-1-a-ii",
                  "x": 69.33,
                  "y_start": 116.66,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an incorrect claim apparent from any information in the statement;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "399-1-b",
              "x": 40.8,
              "y_start": 127.26,
              "page_start": 1,
              "page_end": 1,
              "text": "the interest, if any, shall be computed on the basis of the amounts deductible or collectible as reflected in the statement;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "399-1-c",
              "x": 41.27,
              "y_start": 135.42,
              "page_start": 1,
              "page_end": 1,
              "text": "the fee, if any, shall be computed as per the provisions of section ^9^3[427(1) and (2)];",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "399-1-d",
              "x": 40.8,
              "y_start": 148.48,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "399-1-d-i",
                  "x": 40.8,
                  "y_start": 148.48,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the amount payable by; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "399-1-d-ii",
                  "x": 51.96,
                  "y_start": 159.09,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the amount of refund due to, the deductor or collector shall be determined after adjustment of the amount computed under clauses (b) and (c) against any amount paid under section 397(3) or 398 or ^9^3[427(1) and (2)] and any amount paid otherwise by way of tax or interest or fee;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "e",
              "id": "399-1-e",
              "x": 41.27,
              "y_start": 189.85,
              "page_start": 1,
              "page_end": 1,
              "text": "an intimation shall be prepared or generated and sent to the deductor or collector specifying the amount determined to be payable by, or the amount of refund due to, him under clause (d);",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "399-1-f",
              "x": 42.68,
              "y_start": 210.01,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of refund due to a deductor or collector in pursuance of the determination under clause (d) shall be granted to the deductor or collector.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "399-2",
          "x": 27.62,
          "y_start": 221.68,
          "page_start": 1,
          "page_end": 1,
          "text": "The intimation under this section shall be sent within one year from the end of the tax year in which the statement is filed.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "399-3",
          "x": 27.62,
          "y_start": 237.06,
          "page_start": 1,
          "page_end": 1,
          "text": "The Board may make a scheme for centralised processing of statements, as required under sub-section (1).",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [
    {
      "type": "footnote",
      "number": "93",
      "text": "Sub. for \"427\" by Act No. 4 of 2026, w.e.f. 1-4-2026.",
      "page_start": 1,
      "page_end": 1
    }
  ],
  "orphans": []
}
