    {
      "id": "279-1",
      "citation": "Section 279(1)",
      "unit_type": "subsection",
      "parent_id": "279",
      "section_id": "279",
      "section_number": "279",
      "title": "Income escaping assessment.",
      "text": "If, in the case of an assessee, any income chargeable to tax has escaped assessment for any tax year (herein and in sections 280 to 286 referred to as the relevant tax year), the Assessing Officer may, subject to the provisions of sections 280 to 286, assess or reassess such income or recompute the loss or the depreciation allowance or any other allowance or deduction for the relevant tax year.",
      "retrieval_text": "Chapter XVI PROCEDURE FOR ASSESSMENT Chapter XVI, Division A Procedure for assessment Section 279 Income escaping assessment. Section 279(1): If, in the case of an assessee, any income chargeable to tax has escaped assessment for any tax year (herein and in sections 280 to 286 referred to as the relevant tax year), the Assessing Officer may, subject to the provisions of sections 280 to 286, assess or reassess such income or recompute the loss or the depreciation allowance or any other allowance or deduction for the relevant tax year.",
      "act": "Income-tax Act, 2025",
      "chapter": "XVI",
      "chapter_id": "chapter-XVI",
      "chapter_title": "PROCEDURE FOR ASSESSMENT",
      "division_id": "chapter-XVI-division-A",
      "division_number": "A",
      "division_title": "Procedure for assessment",
      "subdivision_id": null,
      "subdivision_number": null,
      "subdivision_title": "",
      "jurisdiction": "India",
      "page_start": 1,
      "page_end": 1,
      "line_start": null,
