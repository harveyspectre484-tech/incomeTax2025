        {
          "type": "subsection",
          "number": "7",
          "id": "266-7",
          "indent": 0,
          "line_start": 32,
          "page_start": 1,
          "page_end": 1,
          "text": "After a regular assessment under section 270 or 271 or an assessment under section 294 has been made, any amount paid under sub-section (1) shall be deemed to have been paid towards such regular assessment or assessment.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-266-7-001",
              "target_id": "266-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-266-7-002",
              "target_id": "270",
              "target_type": "section",
              "anchor_text": "section 270 or 271",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-266-7-003",
              "target_id": "294",
              "target_type": "section",
              "anchor_text": "section 294",
              "relationship": "depends_on",
              "confidence": "medium"
