              "id": "266-2-e",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "any relief of tax claimed under section 159(2) on account of tax paid in any specified territory outside India referred to in that section;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-266-2-e-001",
                  "target_id": "159-2",
                  "target_type": "subsection",
                  "anchor_text": "section 159(2)",
