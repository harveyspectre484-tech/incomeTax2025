        },
        {
          "type": "subsection",
          "number": "5",
          "id": "266-5",
          "indent": 0,
          "line_start": 25,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of sub-section (1), interest payable under section 424 shall be computed on an amount equal to the assessed tax or, as the case may be, on the amount by which the advance tax paid falls short of the assessed tax.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-266-5-001",
              "target_id": "266-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            },
            {
              "reference_id": "ref-266-5-002",
              "target_id": "424",
              "target_type": "section",
              "anchor_text": "section 424",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "266-6",
          "indent": 0,
          "line_start": 26,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In sub-section (5), \"assessed tax\" means the tax on the total income as declared in the return as reduced by the amount of,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "266-6-a",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "tax deducted or collected at source, as per the provisions of Chapter XIX-B, on any income which is subject to such deduction or collection and which is taken into account in computing such total income;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "266-6-b",
              "indent": 0,
              "line_start": 28,
              "page_start": 1,
              "page_end": 1,
              "text": "any relief of tax claimed under section 157;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-266-6-b-001",
                  "target_id": "157",
                  "target_type": "section",
                  "anchor_text": "section 157",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "266-6-c",
              "indent": 0,
              "line_start": 29,
              "page_start": 1,
              "page_end": 1,
              "text": "any relief of tax or deduction of tax claimed under section 159(1) or section 160 on account of tax paid in a country outside India;",
              "children": [],
              "references": [
                {
