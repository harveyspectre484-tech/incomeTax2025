        },
        {
          "type": "subsection",
          "number": "3",
          "id": "266-3",
          "indent": 0,
          "line_start": 17,
          "page_start": 1,
          "page_end": 1,
          "text": "Where the amount paid by the assessee under sub-section (1) falls short of the aggregate of the tax, interest and fee as payable under the said subsection, the amount so paid shall first be adjusted towards the fee payable and thereafter towards the interest payable and the balance, if any, shall be adjusted towards the tax payable.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-266-3-001",
              "target_id": "266-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
