      "id": "266",
      "title": "Self-assessment.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "266-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where, after taking into account the amounts referred to in sub-section (2), any tax is payable on the basis of any return required to be furnished under section 263 or 268 or 280 or 294, then––",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "266-1-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee shall be liable to pay such tax together with interest and fee payable under any provision of this Act for any delay in furnishing the return or any default or delay in payment of advance tax, before furnishing the return; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "266-1-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "the return shall be accompanied by proof of payment of tax, interest and fee.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-266-1-001",
              "target_id": "266-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-266-1-002",
              "target_id": "263",
              "target_type": "section",
              "anchor_text": "section 263 or 268",
              "relationship": "depends_on",
              "confidence": "medium"
            }
