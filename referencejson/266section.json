              "number": "a",
              "id": "266-4-a",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "advance tax, if any, paid;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "266-4-b",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "any tax deducted or collected at source;",
              "children": []
            },
