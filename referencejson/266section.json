        },
        {
          "type": "subsection",
          "number": "8",
          "id": "266-8",
          "indent": 0,
          "line_start": 33,
          "page_start": 1,
          "page_end": 1,
          "text": "If any assessee fails to pay the whole or any part of such tax, interest or fee as per the provisions of sub-section (1), he shall be deemed to be an assessee in default in respect of the tax, interest or fee remaining unpaid and all the provisions of this Act shall apply accordingly.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-266-8-001",
              "target_id": "266-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "266-9",
          "indent": 0,
          "line_start": 34,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of sub-section (8) shall apply without prejudice to any other consequences which the assessee may incur.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-266-9-001",
              "target_id": "266-8",
              "target_type": "subsection",
