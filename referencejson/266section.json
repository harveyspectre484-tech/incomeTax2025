            {
              "type": "clause",
              "number": "a",
              "id": "266-2-a",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of tax, if any, already paid under any provision of this Act;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "266-2-b",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "any tax deducted or collected at source;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "266-2-c",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "any relief of tax claimed under section 157;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-266-2-c-001",
                  "target_id": "157",
                  "target_type": "section",
                  "anchor_text": "section 157",
