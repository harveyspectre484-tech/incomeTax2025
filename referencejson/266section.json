              "id": "266-2-d",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "any relief of tax or deduction of tax claimed under section 159(1) or 160 on account of tax paid in a country outside India;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-266-2-d-001",
                  "target_id": "159-1",
                  "target_type": "subsection",
                  "anchor_text": "section 159(1) or 160",
