              "target_type": "section",
              "anchor_text": "section 508",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "455-2",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The prescribed income-tax authority referred to in section 508, shall direct that reporting financial institution referred to in section 508(1)(k) shall, in addition to the penalty under sub-section (1) of this section, if any, pay a sum of Rs. 5000 for every inaccurate reportable account, if—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "455-2-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "the said institution provides inaccurate information in the statement required to be furnished under section 508(1); and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-455-2-a-001",
                  "target_id": "508-1",
                  "target_type": "subsection",
                  "anchor_text": "section 508(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "455-2-b",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "the inaccuracy in the said statement is due to false or inaccurate information furnished by the holder or holders of the relevant reportable account or accounts.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-455-2-001",
              "target_id": "455-1",
              "target_type": "subsection",
