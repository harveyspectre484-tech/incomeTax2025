          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The prescribed income-tax authority referred to in section 508 may direct that a person required to furnish a statement under sub-section (1) of the said section shall pay penalty of Rs. 50000, if such person—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "455-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "provides inaccurate information in the statement or fails to furnish correct information within the period specified under section 508(8); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-455-1-a-001",
                  "target_id": "508-8",
                  "target_type": "subsection",
                  "anchor_text": "section 508(8)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "455-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to comply with the due diligence requirement under section 508(9).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-455-1-b-001",
                  "target_id": "508-9",
                  "target_type": "subsection",
                  "anchor_text": "section 508(9)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
