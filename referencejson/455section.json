          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The reporting financial institution as referred to in sub-section (2) shall be entitled to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "455-3-a",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "recover the amount paid under sub-section (2) on behalf of the reportable account holder; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-455-3-a-001",
                  "target_id": "455-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (2)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
