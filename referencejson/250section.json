{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "250",
      "id": "250",
      "title": "Income Tax Department",
      "indent": 0,
      "line_start": 4,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "250-1",
          "indent": 0,
          "line_start": 4,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The amount of the following liabilities may be recovered out of the assets seized under section 247 or requisitioned under section 248 in the following manner, namely:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "250-1-a",
              "indent": 0,
              "line_start": 5,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of any existing liability (other than advance tax payable under the provisions of Part C of Chapter XIX) of this Act, the Income-tax Act, 1961 (43 of 1961), the Black Money (Undisclosed Foreign Income and Assets) and Imposition of Tax Act, 2015 (22 of 2015) and in respect of which such person is in default or is deemed to be in default;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "250-1-b",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of the liability determined on completion of the assessment or reassessment or recomputation and the assessment of the year relevant to the tax year in which search is initiated or requisition is made, or the amount of liability determined on completion of the assessment under Part B of Chapter XVI for the block period, as the case may be (including any penalty levied or interest payable in connection with such assessment), and in respect of which such person is in default or is deemed to be in default;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "250-1-c",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of liability arising on an application made before the Interim Boards for Settlement under section 245C(1) of the Income-tax Act, 1961 (43 of 1961).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-250-1-c-001",
                  "target_id": "245C-1",
                  "target_type": "subsection",
                  "anchor_text": "section 245C(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-250-1-001",
              "target_id": "247",
              "target_type": "section",
              "anchor_text": "section 247 or requisitioned",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-250-1-002",
              "target_id": "248",
              "target_type": "section",
              "anchor_text": "section 248",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "250-2",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer may release the assets seized as referred to in sub-section (1) or portion of such asset to the person from whose custody the assets were seized, on an application made by the person concerned within thirty days from the end of the month in which the asset was seized, on fulfilment of the following requirements:––",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "250-2-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "after being satisfied on the basis of explanation furnished by such person that the nature and source of acquisition of such assets is explained;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "250-2-b",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "after recovering any existing liability referred to in sub-section (1) out of such assets; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-250-2-b-001",
                  "target_id": "250-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "250-2-c",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "after obtaining prior approval of the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-250-2-001",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or portion",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "250-3",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "The assets referred to in sub-section (2) shall be released within one hundred and twenty days from the date on which the last of the authorisations for the search or requisition was executed.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-250-3-001",
              "target_id": "250-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "250-4",
          "indent": 0,
          "line_start": 13,
          "page_start": 1,
          "page_end": 1,
          "text": "If the assets as referred to in sub-section (1) consist solely of money, or partly of money and partly of other assets, the Assessing Officer may apply such money in the discharge of the liabilities referred to in sub-section (1) and the assessee shall be discharged of such liability to the extent of the money so applied.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-250-4-001",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-250-4-002",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) and the",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "250-5",
          "indent": 0,
          "line_start": 14,
          "page_start": 1,
          "page_end": 1,
          "text": "The assets, other than money, may also be applied for discharge of liabilities referred to in sub-section (1), as remains undischarged, and shall be deemed to be under distraint as if such distraint was effected by the Assessing Officer or Tax Recovery Officer under authorisation from the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner under section 416(7) and the recovery of any liability out of such assets shall be effected in such manner as may be prescribed.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-250-5-001",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-250-5-002",
              "target_id": "416-7",
              "target_type": "subsection",
              "anchor_text": "section 416(7) and the",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "250-6",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text": "The mode of recovery of liabilities under sub-section (1) shall not preclude the recovery of liabilities aforesaid by any other mode laid down in this Act.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-250-6-001",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "250-7",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text": "Any assets or proceeds thereof, which remain after the liabilities referred to in sub-section (1) are discharged shall be forthwith made over or paid to the person from whose custody the assets were seized. where—",
          "children": [],
          "references": [
            {
              "reference_id": "ref-250-7-001",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "250-8",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
          "text": "The Central Government shall pay simple interest at the rate of 0.5% for every month or part of a month for the period on the amount determined in accordance with the following formula:–– (A – B) + (C – D) A = the aggregate amount of money seized under section 247 or requisitioned under section 248; B = the amount of money, if any, released under sub-section (2); C = the proceeds, if any, of the assets sold towards the discharge of the liability under sub-section (1); and D = the aggregate amount required to meet the liabilities referred to in sub-section (1).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-250-8-001",
              "target_id": "250-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-250-8-002",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-250-8-003",
              "target_id": "250-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-250-8-004",
              "target_id": "247",
              "target_type": "section",
              "anchor_text": "section 247 or requisitioned",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-250-8-005",
              "target_id": "248",
              "target_type": "section",
              "anchor_text": "section 248",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "250-9",
          "indent": 0,
          "line_start": 23,
          "page_start": 1,
          "page_end": 1,
          "text": "The period referred to in sub-section (8) shall be from the date immediately following the expiry of one hundred and twenty days from the date on which the last of the authorisations for the search under section 247 or requisition under section 248 was executed to the date of completion of the assessment or reassessment or recomputation.",
          "children": [],
          "references": [
            {
