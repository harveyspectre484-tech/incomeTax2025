          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in this Act but subject to the provisions of Part A, B, E and this Part (other than section 204) of this Chapter, the income-tax payable for a tax year shall be at the rate of 22%, at the option of a person being a co-operative society resident in India, in respect of the total income of such person computed in the following manner:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "203-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "without any deduction under—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "203-1-a-i",
                  "indent": 0,
                  "line_start": 7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Chapter VIII other than the provisions of section 146 26[or 150]; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "203-1-a-ii",
                  "indent": 0,
                  "line_start": 8,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "sections specified in section 205(1)(a) to (g);",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "203-1-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "without set off of any loss carried forward or depreciation from any earlier tax year, if such loss or depreciation is attributable to any of the deductions referred to in clause (a).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-203-1-b-001",
                  "target_id": "203-1-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-203-1-001",
