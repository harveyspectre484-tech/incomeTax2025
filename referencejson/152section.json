{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "152",
      "id": "152",
      "title": "Deduction in respect of royalty on patents.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "152-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An assessee, being an individual, who is—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "152-1-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "resident in India;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "152-1-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "a patentee;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "152-1-c",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "in receipt of income by way of royalty in respect of a patent registered on or after the 1st April, 2003 under the Patents Act, 1970 (39 of 1970); and (d) having gross total income for the tax year which includes royalty, shall be allowed a deduction from such income computed in the manner specified in sub-sections (2) to (7).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-152-1-c-001",
                  "target_id": "152-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-sections (2) to (7)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "152-2",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text": "The deduction under this section shall be equal to the whole of such income referred to in sub-section (1) or Rs. 300000, whichever is less.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-152-2-001",
              "target_id": "152-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or Rs",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "152-3",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "Where a compulsory licence is granted in respect of any patent under the Patents Act, 1970 (39 of 1970), the income by way of royalty for the purpose of allowing deduction under this section shall not exceed the amount of royalty under the terms and conditions of a licence settled by the Controller under that Act.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "152-4",
          "indent": 0,
          "line_start": 13,
          "page_start": 1,
          "page_end": 1,
          "text": "In respect of any income earned from any source outside India, so much of the income, shall be taken into account for the purpose of this section as is brought into India by, or on behalf of, the assessee in convertible foreign exchange within six months from the end of the tax year in which such income is earned or within such further period as the competent authority referred to in section 151(8)(c) may allow in this behalf.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-152-4-001",
              "target_id": "151-8-c",
              "target_type": "clause",
              "anchor_text": "section 151(8)(c)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "152-5",
          "indent": 0,
          "line_start": 14,
          "page_start": 1,
          "page_end": 1,
          "text": "No deduction under this section shall be allowed unless the assessee furnishes a certificate in the prescribed form, duly signed by the authority as may be prescribed, along with the return of income setting forth such particulars as may be prescribed.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "152-6",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text": "No deduction under this section shall be allowed in respect of any income earned from any source outside India, unless the assessee furnishes a certificate in such form, from the authority or authorities, as may be prescribed, along with the return of income.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "152-7",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text": "Where a deduction for any tax year has been claimed and allowed in respect of any income referred to in this section, no deduction in respect of such income shall be allowed under any other provision of this Act in any tax year.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "152-8",
          "indent": 0,
          "line_start": 17,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "152-8-a",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "\"Controller\" means the authority as defined in section 2(1)(b) of the Patents Act, 1970 (39 of 1970);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-152-8-a-001",
                  "target_id": "2-1-b",
                  "target_type": "clause",
                  "anchor_text": "section 2(1)(b)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "152-8-b",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "\"lump sum\" includes a non-returnable advance payment for royalties;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "152-8-c",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "\"patent\" means any patent granted, including a patent of addition, under the Patents Act, 1970 (39 of 1970);",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "152-8-d",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
              "page_end": 1,
              "text": "\"patentee\" means the true and first inventor recorded as the patentee under the Patents Act, 1970 (39 of 1970), including joint patentees recorded as such true and first inventors;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "152-8-e",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "\"patent of addition\" shall have the same meaning as assigned to it in section 2(1)(q) of the Patents Act, 1970 (39 of 1970);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-152-8-e-001",
                  "target_id": "2-1-q",
                  "target_type": "clause",
                  "anchor_text": "section 2(1)(q)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "f",
              "id": "152-8-f",
              "indent": 0,
              "line_start": 23,
              "page_start": 1,
              "page_end": 1,
              "text": "\"patented article\" and \"patented process\" shall have the same meanings as assigned to them in section 2(1)(o) of the Patents Act, 1970 (39 of 1970);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-152-8-f-001",
                  "target_id": "2-1-o",
                  "target_type": "clause",
                  "anchor_text": "section 2(1)(o)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "152-8-g",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"royalty\" in respect of a patent, means consideration for—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "152-8-g-i",
                  "indent": 0,
                  "line_start": 25,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the transfer of all or any rights (including the granting of a licence) in respect of a patent; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "152-8-g-ii",
                  "indent": 0,
                  "line_start": 26,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the imparting of any information concerning the working of, or the use of, a patent; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "152-8-g-iii",
                  "indent": 0,
                  "line_start": 27,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the use of any patent; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "152-8-g-iv",
                  "indent": 0,
                  "line_start": 28,
                  "page_start": 1,
                  "page_end": 1,
                  "text_before_items": "the rendering of any services in connection with the activities referred to in sub-clauses (i) to (iii), but does not include any consideration,—",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "152-8-g-iv-A",
                      "indent": 0,
                      "line_start": 29,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "which would be the income of the recipient chargeable under the head \"Capital gains\"; or",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "B",
                      "id": "152-8-g-iv-B",
                      "indent": 0,
                      "line_start": 30,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "for sale of product manufactured with the use of patented process or of the patented article for commercial use;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "h",
                      "id": "152-8-g-iv-h",
                      "indent": 0,
                      "line_start": 31,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "\"true and first inventor\" shall have the same meaning as assigned to it in section 2(1)(y) of the Patents Act, 1970 (39 of 1970).",
                      "children": []
                    }
                  ],
                  "text_after_items": ""
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}