      "text": "",
      "children": [
        {
          "type": "section",
          "number": "1",
          "id": "1",
          "title": "A.—Association of persons, firm, Hindu undivided family, etc.",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "—Legal representatives",
          "subsections": [],
          "text_after_subsections": ""
        },
        {
          "type": "section",
          "number": "302",
          "id": "302",
          "title": "Legal representative.",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "",
          "subsections": [
            {
              "type": "subsection",
              "number": "1",
              "id": "302-1",
              "x": 27.62,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Where a person dies, his legal representative shall be liable to pay any sum which the deceased would have been liable to pay if he had not died, in the like manner and to the same extent as the deceased.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "2",
              "id": "302-2",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purposes of making an assessment (including an assessment, reassessment or recomputation under section 279) of the income of the deceased and for the purpose of levying any sum in the hands of the legal representative as per the provisions of sub-section (1), —",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "302-2-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any proceeding taken against the deceased before his death shall be deemed to have been taken against the legal representative and may be continued against the legal representative from the stage at which it stood on the date of the death of the deceased;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "302-2-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any proceeding which could have been taken against the deceased if he had survived, may be taken against the legal representative; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "302-2-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "all the provisions of this Act shall apply accordingly.",
                  "children": []
                }
              ],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-302-2-001",
                  "target_id": "302-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-302-2-002",
                  "target_id": "279",
                  "target_type": "section",
                  "anchor_text": "section 279",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "3",
              "id": "302-3",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The legal representative of the deceased shall be deemed to be an assessee for the purposes of this Act.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "4",
              "id": "302-4",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Subject to the provisions of sub-sections (5), (6) and (7), the liability of a legal representative referred to in sub-section (1) shall be limited to the extent to which the estate of the deceased is capable of meeting the liability.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-302-4-001",
                  "target_id": "302-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-sections (5)",
                  "relationship": "subject_to",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-302-4-002",
                  "target_id": "302-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "5",
              "id": "302-5",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every legal representative shall be personally liable for any tax payable by him in his capacity as legal representative if, while such liability for tax remains undischarged, he creates a charge on or disposes of or parts with any assets of the estate of the deceased, which are in, or may come into, his possession.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "6",
              "id": "302-6",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The liability of a legal representative referred to in sub-section (5) shall be limited to the value of the asset so charged, disposed of or parted with.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-302-6-001",
                  "target_id": "302-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "7",
              "id": "302-7",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The provisions of sections 304(2) and (5) and 305 shall, in so far as may be and to the extent to which they are not inconsistent with the provisions of this section, apply in relation to a legal representative.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-302-7-001",
                  "target_id": "304-2",
                  "target_type": "subsection",
                  "anchor_text": "sections 304(2) and (5)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_subsections": ""
        }
      ]
    }
  ],
