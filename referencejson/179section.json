{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "179",
      "id": "179",
      "title": "Impermissible avoidance arrangement.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "179-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An impermissible avoidance arrangement means an arrangement, the main purpose of which is to obtain a tax benefit, and it—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "179-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "creates rights, or obligations, which are not ordinarily created between persons dealing at arm's length;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "179-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "results, directly or indirectly, in the misuse, or abuse, of the provisions of this Act;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "179-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "lacks commercial substance or is deemed to lack commercial substance under section 180, in whole or in part; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-179-1-c-001",
                  "target_id": "180",
                  "target_type": "section",
                  "anchor_text": "section 180",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "179-1-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "is entered into, or carried out, by means, or in a manner, which are not ordinarily employed for bona fide purposes.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "179-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An arrangement shall be presumed, unless it is proved to the contrary by the assessee, to have been entered into, or carried out, for the main purpose of obtaining a tax benefit, if the main purpose of a step in, or a part of, the arrangement is to obtain a tax benefit, irrespective of the fact that the main purpose of the whole arrangement is not to obtain a tax benefit.",
          "clauses": [],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}