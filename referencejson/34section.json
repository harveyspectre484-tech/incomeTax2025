{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "34",
      "id": "34",
      "title": "General conditions for allowable deductions.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "34-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "Any expenditure (not being an expenditure of the nature specified in sections 28 to 33, 44 to 49, 51 and 52 and not being in the nature of capital expenditure or personal expenses of the assessee), laid out or expended wholly and exclusively for the purposes of the business or profession shall be allowed in computing the income chargeable under the head \"Profits and gains of business or profession\".",
          "children": [],
          "references": [
            {
              "reference_id": "ref-34-1-001",
              "target_id": "28",
              "target_type": "section",
              "anchor_text": "sections 28 to 33",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "34-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (1), an expenditure laid out or expended wholly and exclusively for business or profession by the assessee shall not include any of the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "34-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "an expenditure incurred for any purpose which is an offence or is prohibited by law; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "34-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "an expenditure incurred on the activities relating to corporate social responsibility referred to in section 135 of the Companies Act, 2013 (18 of 2013); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-34-2-b-001",
                  "target_id": "135",
                  "target_type": "section",
                  "anchor_text": "section 135",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "34-2-c",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "an expenditure incurred on advertisement in any souvenir, brochure, tract, pamphlet or the like, published by a political party.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-34-2-001",
              "target_id": "34-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "34-3",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The expenditure mentioned in sub-section (2)(a) shall include expenditure incurred for—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "34-3-a",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "any purpose which is an offence under, or is prohibited by, any law in force in or outside India; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "34-3-b",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "providing a benefit or perquisite in any form to a person, who may or may not be carrying on a business or exercising a profession, when its acceptance by the person is in violation of any law or rule or regulation or guideline governing the conduct of that person; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "34-3-c",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "compounding an offence under any law in force in or outside India; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "34-3-d",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "settling proceedings initiated in relation to contravention under any law notified by the Central Government in this behalf.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-34-3-001",
              "target_id": "34-2-a",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(a)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
