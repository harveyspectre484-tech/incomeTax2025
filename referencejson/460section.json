      "type": "section",
      "number": "460",
      "id": "460",
      "title": "Ministry of Finance, Government of India",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "If any person required to furnish statement under section 505, fails to do so within the period prescribed under that section, the Assessing Officer may impose on him, a penalty of—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "460-a",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "Rs. 1000 for every day for which the failure continues, if the period of failure does not exceed three months; or",
          "children": []
        },
        {
          "type": "clause",
          "number": "b",
          "id": "460-b",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "Rs. 100000 in any other case.",
          "children": []
        }
      ],
      "text_after_clauses": "",
      "references": [
        {
          "reference_id": "ref-460-001",
          "target_id": "505",
