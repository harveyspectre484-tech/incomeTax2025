      "page_end": 1,
      "text": "—Change in constitution, succession and dissolution",
      "children": []
    },
    {
      "type": "section",
      "number": "327",
      "id": "327",
      "title": "Change in constitution of a firm.",
      "indent": 0,
      "line_start": 8,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "327-1",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "Where at the time of making an assessment under section 270 or 271, it is found that a change has occurred in the constitution of a firm, the assessment shall be made on the firm as constituted at the time of making the assessment.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-327-1-001",
              "target_id": "270",
              "target_type": "section",
              "anchor_text": "section 270 or 271",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "327-2",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, there is a change in the constitution of the firm—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "327-2-a",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "if one or more of the partners cease to be partners or one or more new partners are admitted, subject to the condition that at least one person who was partner of the firm before the change continues as partner after such change; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "327-2-b",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "where all the partners continue with a change in their respective shares or in the shares of some of them.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "327-3",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of sub-section (2)(a) shall not apply to a case where the firm is dissolved on the death of any of its partners.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-327-3-001",
              "target_id": "327-2-a",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(a)",
              "relationship": "exception_to",
              "confidence": "high"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}