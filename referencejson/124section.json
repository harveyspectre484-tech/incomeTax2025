              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"salary\" includes dearness allowance, if the terms of employment so provide, but excludes all other allowances and perquisites.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
