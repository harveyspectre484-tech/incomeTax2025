              "reference_id": "ref-124-10-002",
              "target_id": "123",
              "target_type": "section",
              "anchor_text": "section 123",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "124-11",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any amount standing to the credit of the assessee, being a subscriber to Unified Pension Scheme, in his account referred to in sub-sections (1) and (3), and paragraph 1(y) of Schedule XV, in respect of which a deduction has been allowed together with the amount accrued thereon, received by the assessee or his nominee, in whole or in part, in any tax year on account of his superannuation or voluntary retirement or retirement under Fundamental Rules 56(j) (which is not treated as penalty under the Central Civil Services (Classification, Control and Appeal) Rules, 1965), the whole of the amount shall be deemed to be the income of the assessee or his nominee, as the case may be, in the tax year in which such amount is received, and shall accordingly be charged to tax as income of that tax year.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-124-11-001",
              "target_id": "para-1",
              "target_type": "paragraph",
              "anchor_text": "paragraph 1",
              "relationship": "related_to",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-124-11-002",
              "target_id": "schedule-XV",
              "target_type": "schedule",
              "anchor_text": "Schedule XV",
              "relationship": "related_to",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-124-11-003",
              "target_id": "124-1",
              "target_type": "subsection",
              "anchor_text": "sub-sections (1) and (3)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "12",
