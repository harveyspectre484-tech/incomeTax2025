          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "124-13-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"pool corpus\" and \"individual corpus\" shall have the same meaning as in Notification F. No. FX-1/3/2024-PR of the Department of Financial Services, dated the 24th January, 2025.",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
