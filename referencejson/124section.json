          "number": "9",
          "id": "124-9",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, the assessee shall not be deemed to have received any amount in the tax year, if such amount is used for purchasing an annuity plan in the same tax year.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "124-10",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where any amount paid or deposited by the assessee has been allowed as a deduction under sub-section (3), no deduction with reference to such amount shall be allowed under section 123 for that tax year.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-124-10-001",
              "target_id": "124-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "depends_on",
              "confidence": "high"
            },
