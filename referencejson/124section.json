          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (11), the assessee shall be deemed not to have received any amount in the tax year if such amount is transferred to pool corpus from individual corpus on account of his superannuation or voluntary retirement or retirement under Fundamental Rules 56(j) (which is not treated as penalty under the Central Civil Services (Classification, Control and Appeal) Rules, 1965), as may be applicable.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-124-12-001",
              "target_id": "124-11",
