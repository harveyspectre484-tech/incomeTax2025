        },
        {
          "type": "subsection",
          "number": "7",
          "id": "124-7",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The amount received by the nominee, on the death of the assessee, under the circumstances referred to in sub-section (6)(a), shall not be deemed to be the income of the nominee.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-124-7-001",
              "target_id": "124-6-a",
              "target_type": "clause",
              "anchor_text": "sub-section (6)(a)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "124-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The amount received by a person, being the parent or guardian or nominee of a minor on account of closure of the pension scheme, due to the death of the minor, referred to in sub-section (4), shall not be deemed to be the income of such person.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-124-8-001",
