                  "target_id": "397-3-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "exception_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "i",
              "id": "397-3-i",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "to a person who is required to deduct tax under provisions of section 393(1) [Table: Sl. Nos. 2(i), 3(i) and 6(ii)];",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "397-3-i-ii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to a person referred to in section 393(4) [Table: Sl. No. 12.C(a)]; and"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "397-3-i-iii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a person notified in this regard by the Central Government.\""
                }
              ],
              "references": [
