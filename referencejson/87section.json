{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "87",
      "id": "87",
      "title": "Income Tax Department",
      "indent": 0,
      "line_start": 4,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "87-1",
          "indent": 0,
          "line_start": 4,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the assessee has—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "87-1-a",
              "indent": 0,
              "line_start": 5,
              "page_start": 1,
              "page_end": 1,
              "text": "capital gains arising from the transfer of capital asset, being machinery or plant or building or land or any rights in building or land used for the business of an industrial undertaking situated in an urban area, effected in the case of shifting of an industrial undertaking situated in an urban area (original asset) to any area [other than an urban area (new area)]; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "87-1-b",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "within one year before or three years after the date of such transfer,—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "87-1-b-i",
                  "indent": 0,
                  "line_start": 7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "purchased new machinery or plant for business of the industrial undertaking in the new area;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "87-1-b-ii",
                  "indent": 0,
                  "line_start": 8,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "acquired building or land or constructed building for his business in the said area;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "87-1-b-iii",
                  "indent": 0,
                  "line_start": 9,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "shifted the original asset and transferred the establishment of such undertaking to such area; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "87-1-b-iv",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text_before_items": "incurred expenses on such other purpose as specified in a scheme notified by the Central Government for this section, then, instead of the capital gains being charged to income-tax as income of the tax year in which the transfer took place, it shall be dealt with as follows:—",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "87-1-b-iv-A",
                      "indent": 0,
                      "line_start": 12,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "if the cost and expenses incurred on all or any of the purposes mentioned in sub-clauses (i) to (iv) referred to as \"new asset\",—",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "I",
                      "id": "87-1-b-iv-I",
                      "indent": 0,
                      "line_start": 13,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "is less than the capital gains, the difference shall be charged under section 67 as the income of the tax year; or",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "II",
                      "id": "87-1-b-iv-II",
                      "indent": 0,
                      "line_start": 14,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "is equal to or more than the capital gain, no capital gain shall be charged under section 67; and",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "B",
                      "id": "87-1-b-iv-B",
                      "indent": 0,
                      "line_start": 15,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "for computing any capital gain arising from transfer of the new asset within three years of its being purchased, acquired, constructed or transferred, the cost shall be nil in case of sub-clause (A)(II) or shall be reduced by the amount of the capital gain in case of sub-clause (A)(I).",
                      "children": []
                    }
                  ],
                  "text_after_items": ""
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "87-2",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the capital gain is not used by the assessee for the new asset within one year before the date of transfer of the original asset, or before filing the return of income under section 263, then—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "87-2-a",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "the unutilised amount shall be deposited in a specified bank or institution and utilised as per the scheme notified by the Central Government;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "87-2-b",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "such deposit shall be made before the filing of the return and not later than the due date applicable in the case of the assessee for filing the return of income under section 263(1); and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-87-2-b-001",
                  "target_id": "263-1",
                  "target_type": "subsection",
                  "anchor_text": "section 263(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "87-2-c",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "the proof of deposit shall be submitted along with such return.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-87-2-001",
              "target_id": "263",
              "target_type": "section",
              "anchor_text": "section 263",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "87-3",
          "indent": 0,
          "line_start": 20,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of sub-section (1), the amount already utilised for purchasing or constructing the new asset together with the deposited amount under sub-section (2) shall be deemed to be the cost of the new asset.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-87-3-001",
              "target_id": "87-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            },
            {
              "reference_id": "ref-87-3-002",
              "target_id": "87-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "87-4",
          "indent": 0,
          "line_start": 21,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the amount deposited under sub-section (2) is not wholly or partly utilised for the new asset within the period specified in sub-section (1), then,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "87-4-a",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "the unutilised amount shall be charged under section 67 as the income of the tax year in which the period of three years from the date of the transfer of the original asset expires; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-87-4-a-001",
                  "target_id": "67",
                  "target_type": "section",
                  "anchor_text": "section 67",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "87-4-b",
              "indent": 0,
              "line_start": 23,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee shall be entitled to withdraw such unutilised amount in accordance with the scheme referred to in sub-section (2).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-87-4-b-001",
                  "target_id": "87-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (2)",
                  "relationship": "procedure_reference",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-87-4-001",
              "target_id": "87-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-87-4-002",
              "target_id": "87-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "87-5",
          "indent": 0,
          "line_start": 24,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, the expression \"urban area\" means any area within the limits of a municipal corporation or municipality, declared to be an urban area by the Central Government for the purposes of this section, having regard to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "87-5-a",
              "indent": 0,
              "line_start": 26,
              "page_start": 1,
              "page_end": 1,
              "text": "the population;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "87-5-b",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "concentration of industries; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "87-5-c",
              "indent": 0,
              "line_start": 28,
              "page_start": 1,
              "page_end": 1,
              "text": "need for proper planning of the area and other relevant factors.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": [
    {
      "page": 1,
      "line": 2,
      "text": "Ministry of Finance, Government of India"
    },
    {
      "page": 1,
      "line": 3,
      "text": "Exemption of capital gains on transfer of assets in cases of shifting of industrial undertaking from urban area."
    }
  ]
}