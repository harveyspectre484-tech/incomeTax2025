          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The following income shall not be included in the total undisclosed income of the block period:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "293-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the total income determined or assessed, as the case may be, under section 270(1) or (10) or section 271 or 279 or 294(1)(c) of this Act or section 143 or 144 or 147 or 153A or 153C or 158BC or 245D(4) of the Income-tax Act, 1961 (43 of 1961) prior to the date of initiation of the search or the date of requisition, in respect of any of the tax year falling within the block period;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-293-2-a-001",
                  "target_id": "270-1",
                  "target_type": "subsection",
                  "anchor_text": "section 270(1) or (10)",
