              "id": "293-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "undisclosed income determined by the Assessing Officer under sub-section (4).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-293-1-b-001",
                  "target_id": "293-4",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (4)",
