                  "target_id": "271",
                  "target_type": "section",
                  "anchor_text": "section 271 or 279",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-293-2-a-003",
                  "target_id": "143",
                  "target_type": "section",
