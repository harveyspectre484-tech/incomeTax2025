              "type": "clause",
              "number": "d",
              "id": "293-2-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the total income referred to in section 207(8) or section 216 or section 393(1) [Table: Sl. No. 8(iii)] of this Act, or section 115A(5) or section 115G or 194P(1) of the Income-tax Act, 1961 (43 of 1961).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-293-2-d-001",
                  "target_id": "207-8",
                  "target_type": "subsection",
                  "anchor_text": "section 207(8) or section",
                  "relationship": "related_to",
