            },
            {
              "type": "clause",
              "number": "c",
              "id": "293-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the income computed by the assessee, in respect of—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "293-2-c-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a tax year, where such tax year has ended and the due date for furnishing the return for such year has not expired prior to the date of initiation of the search or the date of requisition, on the basis of entries relating to such income or transactions as recorded in the books of account and other documents maintained in the normal course before the date of initiation of search or the date of requisition;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "293-2-c-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the period commencing from the 1st April of the tax year in which the search is initiated or requisition is made and ending on the day immediately preceding the date of initiation of search or requisition, on the basis of entries relating to such income or transactions as recorded in the books of account and other documents maintained in the normal course for such period on or before the day immediately preceding the date of initiation of search or the date of requisition;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "293-2-c-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the period commencing from the date of initiation of the search or the date of requisition and ending on the date of the execution of the last of the authorisations for search or requisition, on the basis of entries relating to such income or transactions as recorded in the books of account and other documents maintained in the normal course for such period on or before the date of the execution of the last of the authorisations;"
                }
              ]
            },
