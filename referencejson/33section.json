{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "33",
      "id": "33",
      "title": "Deduction for depreciation.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "33-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "A deduction in respect of depreciation of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "buildings, machinery, plant or furniture, being tangible assets;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "know-how, patents, copyrights, trademarks, licences, franchises or any other business or commercial rights of similar nature, being intangible assets acquired on or after the 1st April, 1998, not being goodwill of a business or profession, owned wholly or partly by the assessee and used wholly and exclusively for the purposes of the business or profession, shall be allowed, as per the provisions of this section.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "33-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In case of assets referred to in sub-section (1) of an undertaking engaged in generation or generation and distribution of power, the deduction in respect of depreciation shall be such percentage of its actual cost to the assessee, as may be prescribed.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-33-2-001",
              "target_id": "33-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "33-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "In case of any block of assets, deduction in respect of depreciation shall be such percentage of its written down value, as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "when any building, machinery, plant or furniture is partly, or not wholly and exclusively, used for the purposes of the business or profession, the deduction under clause (a) shall be restricted to the fair proportionate part thereof as determined by the Assessing Officer, having regard to the usage of such building, machinery, plant or furniture for the purposes of the business or profession;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-33-3-b-001",
                  "target_id": "33-3-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "33-3-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "when deduction of actual cost in respect of any machinery or plant has been allowed under section 54, no deduction under this sub-section shall be allowed.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-33-3-c-001",
                  "target_id": "54",
                  "target_type": "section",
                  "anchor_text": "section 54",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "33-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The deduction under this section shall be restricted to 50% of the prescribed rate, if such asset, being asset referred to in sub-sections (2) and (3) is—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "acquired by the assessee during the tax year; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "put to use for the purposes of business or profession for less than one hundred and eighty days in that tax year.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-33-4-001",
              "target_id": "33-2",
              "target_type": "subsection",
              "anchor_text": "sub-sections (2) and (3)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "33-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The aggregate deduction in respect of depreciation allowable to the predecessor and successor in cases of succession under section 70(1)(zd) or (ze) or (zf), or section 313, or to the amalgamating and the amalgamated company in the case of amalgamation, or to the demerged and resulting company in the case of demerger, as the case may be, for any tax year, shall not exceed the deduction calculated at the prescribed rates under this section as if the succession, amalgamation or demerger had not taken place, and such deduction shall be allowed on pro rata basis based on number of days for which assets were used by the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-5-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "predecessor and successor, in case of such succession; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "amalgamating company and the amalgamated company in case of an amalgamation; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "33-5-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "demerged company and the resulting company in case of a demerger.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-33-5-001",
              "target_id": "70-1-zd",
              "target_type": "clause",
              "anchor_text": "section 70(1)(zd) or (ze)",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-33-5-002",
              "target_id": "313",
              "target_type": "section",
              "anchor_text": "section 313",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "33-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where a building, not owned by the assessee, is held on lease or by any other right of occupancy is used for the purposes of business or profession of the assessee, and if any capital expenditure is incurred by the assessee for the purposes of business or profession on construction of any structure or any work by way of renovation, extension or improvement to such building, then such structure or work shall be treated as a building owned by the assessee for the purposes of this section. (7) The provisions of this section shall apply whether or not the assessee has claimed deduction for depreciation in computing his total income.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "33-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In addition to deduction under sub-section (3), additional deduction in respect of depreciation for any new machinery or plant shall be allowed, when—",
          "clauses": [
            {
              "type": "clause",
              "number": "b",
              "id": "33-8-b",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee acquires and installs the new machinery or plant;",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "33-8-a",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee is engaged in the business of manufacture or production of any article or thing or in the business of generation, transmission or distribution of power;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "33-8-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the new machinery or plant is first put to use by the assessee for the purposes of business; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "33-8-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the new machinery or plant (not being a ship or an aircraft)—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "33-8-d-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "was not used either within or outside India by any other person before its installation by the assessee;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "33-8-d-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "is not installed in any office premises or any residential accommodation, including accommodation in the nature of a guest house;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "33-8-d-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "is not in the nature of any office appliances or road transport vehicle; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "33-8-d-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "is not an asset on which the whole of the actual cost is allowed as a deduction (whether by way of depreciation or otherwise) in computing the income under the head \"Profits and gains of business or profession\" of any tax year."
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-33-8-001",
              "target_id": "33-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "33-9",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The additional deduction in respect of depreciation referred to in sub-section (8) shall be—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-9-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "20% of the actual cost of the new machinery or plant in the tax year when it is acquired and put to use, subject to the provisions of clause (b); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-33-9-a-001",
                  "target_id": "33-9-b",
                  "target_type": "clause",
                  "anchor_text": "clause (b)",
                  "relationship": "subject_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-9-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "10% of the actual cost, if the new machinery or plant is acquired and put to use for less than one hundred and eighty days in the relevant tax year, and 10% of the actual cost shall be allowed in the immediately succeeding tax year.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-33-9-001",
              "target_id": "33-8",
              "target_type": "subsection",
              "anchor_text": "sub-section (8)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "33-10",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The difference between the written down value and the moneys payable including the scrap value, if any, for any tangible asset in respect of which depreciation is claimed and allowed under sub-section (2), shall be allowed as deduction when—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-10-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such asset is sold, discarded, demolished or destroyed in the tax year not being the tax year in which it is first put into use;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-10-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the moneys payable including the scrap value, if any, is less than its written down value; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "33-10-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such deficiency is actually written off in the books of account of the assessee.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-33-10-001",
              "target_id": "33-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "33-11",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-11-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Where the profits and gains chargeable for the tax year before allowing the deduction under sub-sections (1) to (10) is less than such allowable deduction, then—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "33-11-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if such profits and gains is not a loss, the deduction under sub-sections (1) to (10) shall be allowed to the extent of the available profits and gains;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "33-11-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if such profits and gains is a loss, no deduction under sub-sections (1) to (10) shall be allowed;"
                }
              ],
              "references": [
                {
                  "reference_id": "ref-33-11-a-001",
                  "target_id": "33-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-sections (1) to (10)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "33-11-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of deduction which has not been allowed under clause (a) shall be added to the allowable deduction under this section, whether available or not, for the succeeding tax year and the total amount shall be deemed to be eligible for deduction in that year, and so on for the succeeding tax years; and (c) the provisions of this sub-section shall be subject to the provisions of sections 112(3) and 113(4).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-33-11-b-001",
                  "target_id": "112-3",
                  "target_type": "subsection",
                  "anchor_text": "sections 112(3) and 113",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-33-11-b-002",
                  "target_id": "33-11-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "12",
          "id": "33-12",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "33-12-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"assets\" mean—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "33-12-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "tangible assets, being buildings, machinery, plant or furniture;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "33-12-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "intangible assets being—"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
