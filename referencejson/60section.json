      "type": "section",
      "number": "60",
      "id": "60",
      "title": "Deduction of head office expenditure in case of non-residents.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "60-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything to the contrary contained in sections 26 to 54, in the case of a non-resident assessee, deduction of head office expenditure incurred by such assessee as is attributable to his business or profession in India, shall be allowed in computing the income chargeable under the head \"Profits and gains of business or profession\" subject to provisions of sub-section (2).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-60-1-001",
              "target_id": "60-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "subject_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-60-1-002",
              "target_id": "26",
              "target_type": "section",
              "anchor_text": "sections 26 to 54",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "60-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The deduction allowable under sub-section (1) shall be restricted—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "60-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "if the adjusted total income of the assessee is a loss, to an upper monetary limit of 5% of the average adjusted total income of the assessee; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "60-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in any other case, to an upper monetary limit of 5% of the adjusted total income of the assessee.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-60-2-001",
              "target_id": "60-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "60-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "60-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"adjusted total income\" means the total income computed under this Act, without giving effect to the allowance referred to in this section or in section 33(11) or the deduction referred to in section 32(i)(A) or any loss carried forward under section 111(1) or 112(1) or 113(2) or 115(2) or the deductions under Chapter VIII;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-60-3-a-001",
                  "target_id": "33-11",
                  "target_type": "subsection",
                  "anchor_text": "section 33(11) or the",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-60-3-a-002",
                  "target_id": "32-i",
                  "target_type": "clause",
                  "anchor_text": "section 32(i)",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-60-3-a-003",
                  "target_id": "111-1",
                  "target_type": "subsection",
                  "anchor_text": "section 111(1) or 112",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "60-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"average adjusted total income\" means,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "60-3-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if the assessee is assessable for each of the three tax years immediately preceding the relevant tax year, the arithmetic mean of his adjusted total income over those three tax years;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "60-3-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if the assessee is assessable only for two of the said three tax years, the arithmetic mean of his adjusted total income over those two tax years;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "60-3-b-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if the assessee is assessable only for one of the said three tax years, his adjusted total income for that tax year;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "60-3-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"head office expenditure\" means executive and general administration expenditure incurred by the assessee outside India, including expenditure incurred in respect of—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "60-3-c-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "rent, rates, taxes, repairs or insurance of any premises outside India used for the business or profession;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "60-3-c-iii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "travelling by any employee or other person employed in, or managing the affairs of, any office outside India;"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "60-3-c-iv",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such other matters connected with executive and general administration, as may be prescribed."
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "60-3-c-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "salary, wages, annuity, pension, fees, bonus, commission, gratuity, perquisites or profits in lieu of, or in addition to, salary, whether paid or allowed to any employee or other person employed in, or managing the affairs of, any office outside India;"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
