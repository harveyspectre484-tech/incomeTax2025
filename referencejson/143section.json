{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "143",
      "id": "143",
      "title": "Special provisions in respect of certain undertakings in North-Eastern States.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "143-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "Where the gross total income of an assessee includes any profits and gains derived by an undertaking, to which this section applies, from any business referred to in sub-section (2), there shall be allowed, in computing the total income of the assessee, a deduction of an amount equal to 100% of the profits and gains derived from such business for ten consecutive tax years commencing with the initial tax year.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-143-1-001",
              "target_id": "143-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "143-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "This section applies to any undertaking which during the period beginning on the 1st April, 2007 and ending before the 1st April, 2017, has begun or begins, in any of the North-Eastern States,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "143-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "to manufacture or produce any eligible article or thing; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "143-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "to undertake substantial expansion to manufacture or produce any eligible article or thing; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "143-2-c",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "to carry on any eligible business.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "143-3",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "This section applies to any undertaking which fulfils all the following conditions:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "143-3-a",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "it is not formed by splitting up, or the reconstruction, of a business already in existence (other than an undertaking which is formed as a result of the re-establishment, reconstruction or revival by the assessee of the business of any such undertaking as is referred to in section 140(4), in the circumstances and within the period specified therein);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-143-3-a-001",
                  "target_id": "140-4",
                  "target_type": "subsection",
                  "anchor_text": "section 140(4)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "143-3-b",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "it is not formed by the transfer to a new business of machinery or plant previously used for any purpose.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "143-4",
          "indent": 0,
          "line_start": 14,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of sub-section (3)(b), the provisions of section 140(5) and (6) shall apply.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-143-4-001",
              "target_id": "143-3-b",
              "target_type": "clause",
              "anchor_text": "sub-section (3)(b)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            },
            {
              "reference_id": "ref-143-4-002",
              "target_id": "140-5",
              "target_type": "subsection",
              "anchor_text": "section 140(5) and (6)",
              "relationship": "definition_or_scope",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "143-5",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text": "Irrespective of anything contained in any other provision of this Act, in computing the total income of the assessee, no deduction shall be allowed under any other section contained in this Chapter in relation to the profits and gains of the undertaking.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "143-6",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text": "Irrespective of anything contained in this Act, no deduction shall be allowed to any undertaking under this section, where the total period of deduction inclusive of the period of deduction under this section or under second proviso to section 80-IB(4) of the Income-tax Act, 1961 (43 of 1961) exceeds ten tax years.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-143-6-001",
              "target_id": "80",
              "target_type": "section",
              "anchor_text": "section 80-IB",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "143-7",
          "indent": 0,
          "line_start": 17,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions contained in section 140(7) to (15) shall, so far as may be, apply to the eligible undertaking under this section.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-143-7-001",
              "target_id": "140-7",
              "target_type": "subsection",
              "anchor_text": "section 140(7) to (15)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "143-8",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "143-8-a",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"eligible article or thing\" means the article or thing other than the following:—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "143-8-a-i",
                  "indent": 0,
                  "line_start": 20,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "goods falling under Chapter 24 of the First Schedule to the Central Excise Tariff Act, 1985 (5 of 1986), which pertains to tobacco and manufactured tobacco substitutes;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "143-8-a-ii",
                  "indent": 0,
                  "line_start": 21,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "pan masala as covered under Chapter 21 of the First Schedule to the Central Excise Tariff Act, 1985 (5 of 1986);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "143-8-a-iii",
                  "indent": 0,
                  "line_start": 22,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "plastic carry bags of less than twenty microns as specified by the Ministry of Environment and Forests vide notification numbers S.O. 705(E), dated the 2nd September, 1999 and S.O. 698(E), dated the 17th June, 2003; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "143-8-a-iv",
                  "indent": 0,
                  "line_start": 23,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "goods falling under Chapter 27 of the First Schedule to the Central Excise Tariff Act, 1985 (5 of 1986), produced by petroleum oil or gas refineries;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "143-8-b",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"eligible business\" means the business of—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "143-8-b-i",
                  "indent": 0,
                  "line_start": 25,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "hotel (not below two star category);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "143-8-b-ii",
                  "indent": 0,
                  "line_start": 26,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "adventure and leisure sports including ropeways;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "143-8-b-iii",
                  "indent": 0,
                  "line_start": 27,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "providing medical and health services in the nature of nursing home with a minimum capacity of twenty-five beds;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "143-8-b-iv",
                  "indent": 0,
                  "line_start": 28,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "running an old-age home;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "v",
                  "id": "143-8-b-v",
                  "indent": 0,
                  "line_start": 29,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "operating vocational training institute for hotel management, catering and food craft, entrepreneurship development, nursing and paramedical, civil aviation related training, fashion designing and industrial training;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vi",
                  "id": "143-8-b-vi",
                  "indent": 0,
                  "line_start": 30,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "running information technology related training centre;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vii",
                  "id": "143-8-b-vii",
                  "indent": 0,
                  "line_start": 31,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "manufacturing of information technology hardware; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "viii",
                  "id": "143-8-b-viii",
                  "indent": 0,
                  "line_start": 32,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "bio-technology;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "143-8-c",
              "indent": 0,
              "line_start": 33,
              "page_start": 1,
              "page_end": 1,
              "text": "\"initial tax year\" means the tax year in which the undertaking begins to manufacture or produce articles or things, or completes substantial expansion;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "143-8-d",
              "indent": 0,
              "line_start": 34,
              "page_start": 1,
              "page_end": 1,
              "text": "\"North-Eastern States\" means the States of Arunachal Pradesh, Assam, Manipur, Meghalaya, Mizoram, Nagaland, Sikkim and Tripura;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "143-8-e",
              "indent": 0,
              "line_start": 35,
              "page_start": 1,
              "page_end": 1,
              "text": "\"substantial expansion\" means increase in the investment in the plant and machinery by at least 25% of the book value of plant and machinery (before taking depreciation in any year), as on the first day of the tax year in which the substantial expansion is undertaken.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}