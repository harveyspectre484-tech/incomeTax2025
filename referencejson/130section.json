{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "130",
      "id": "130",
      "title": "Ministry of Finance, Government of India",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "130-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "An assessee, being an individual, shall be allowed a deduction of interest payable on loan taken by him from any financial institution for the purpose of acquisition of a residential house property as per the provisions of this section.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "130-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "The deduction under sub-section (1) shall not exceed Rs. 50000 and shall be allowed in computing the total income of the individual for the tax year beginning on the 1st April, 2016 and subsequent tax years.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-130-2-001",
              "target_id": "130-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "130-3",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The deduction under sub-section (1) shall be subject to the following conditions:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "130-3-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "the loan has been sanctioned by the financial institution during the period beginning on the 1st April, 2016 and ending on the 31st March, 2017;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "130-3-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of loan sanctioned for acquisition of the residential house property does not exceed thirty-five lakh rupees;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "130-3-c",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of residential house property does not exceed fifty lakh rupees; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "130-3-d",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee does not own any residential house property on the date of sanction of loan.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-130-3-001",
              "target_id": "130-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "subject_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "130-4",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "Where a deduction under this section is allowed for any interest referred to in sub-section (1), deduction shall not be allowed in respect of such interest under any other provision of this Act for the same or any other tax year.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-130-4-001",
              "target_id": "130-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "130-5",
          "indent": 0,
          "line_start": 13,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "130-5-a",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "\"financial institution\" means a banking company to which the Banking Regulation Act, 1949 (10 of 1949) applies, or any bank or banking institution referred to in section 51 of that Act or a housing finance company;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-130-5-a-001",
                  "target_id": "51",
                  "target_type": "section",
                  "anchor_text": "section 51",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "130-5-b",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "\"housing finance company\" means a public company formed or registered in India with the main object of carrying on the business of providing long-term finance for construction or purchase of houses in India for residential purposes.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": [
    {
      "page": 1,
      "line": 4,
      "text": "Deduction in respect of interest on loan taken for residential house property."
    }
  ]
}