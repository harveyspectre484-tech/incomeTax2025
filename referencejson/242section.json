{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "242",
      "id": "242",
      "title": "Jurisdiction of Assessing Officers.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "242-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where an Assessing Officer has been vested with jurisdiction over any area by virtue of any direction or order issued under section 241(1) or (2) or (3), he shall have jurisdiction within the limits of such area,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "242-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of any person carrying on a business or profession, if the place at which he carries on his business or profession is situated within the area, or where his business or profession is carried on in more places than one, if the principal place of his business or profession is situated within the area; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "242-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of any other person residing within the area.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-242-1-001",
              "target_id": "241-1",
              "target_type": "subsection",
              "anchor_text": "section 241(1) or (2)",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "242-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where a question arises under this section as to whether an Assessing Officer has jurisdiction to assess any person, the question shall be determined by the specified income-tax authority.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "242-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where under this section, a question arises relating to areas within the jurisdiction of different specified income-tax authorities, the question shall be determined––",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "242-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "by the specified income-tax authorities concerned; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "242-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "by the Board or by such specified income-tax authority as the Board may, by notification, specify in this behalf, if they are not in agreement.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "242-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No person shall call in question the jurisdiction of an Assessing Officer,––",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "242-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where he has made a return under section 263(1), after the expiry of one month from the date on which he was served with a notice under section 268(1) or 270(8) or after the completion of the assessment, whichever is earlier;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-242-4-a-001",
                  "target_id": "263-1",
                  "target_type": "subsection",
                  "anchor_text": "section 263(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-242-4-a-002",
                  "target_id": "268-1",
                  "target_type": "subsection",
                  "anchor_text": "section 268(1) or 270",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "242-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where he has made no such return, after the expiry of the time allowed by the notice under section 268(1) or 280(2) for the making of the return or by the notice under section 271(2) to show cause why the assessment should not be completed to the best of the judgment of the Assessing Officer, whichever is earlier;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-242-4-b-001",
                  "target_id": "268-1",
                  "target_type": "subsection",
                  "anchor_text": "section 268(1) or 280",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-242-4-b-002",
                  "target_id": "271-2",
                  "target_type": "subsection",
                  "anchor_text": "section 271(2) to show",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "242-4-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where an action has been taken under section 247 or 248, after the expiry of one month from the date on which he was served with a notice under section 294(1)(a) or after the completion of the assessment, whichever is earlier.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-242-4-c-001",
                  "target_id": "247",
                  "target_type": "section",
                  "anchor_text": "section 247 or 248",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-242-4-c-002",
                  "target_id": "294-1-a",
                  "target_type": "clause",
                  "anchor_text": "section 294(1)(a) or after",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "242-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Subject to the provisions of sub-section (4), where an assessee calls in question the jurisdiction of an Assessing Officer, then the Assessing Officer shall, if not satisfied with the correctness of the claim, refer the matter for determination under sub-section (2) or (3) before the assessment is made.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-242-5-001",
              "target_id": "242-4",
              "target_type": "subsection",
              "anchor_text": "sub-section (4)",
              "relationship": "subject_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-242-5-002",
              "target_id": "242-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2) or (3)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "242-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in this section or in any direction or order issued under section 241, every Assessing Officer shall have all the powers conferred under this Act on an Assessing Officer in respect of the income accruing or arising or received within the area, if any, over which he has been vested with jurisdiction by virtue of the directions or orders issued under section 241(1) or (2) or (3).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-242-6-001",
              "target_id": "241",
              "target_type": "section",
              "anchor_text": "section 241",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-242-6-002",
              "target_id": "241-1",
              "target_type": "subsection",
              "anchor_text": "section 241(1) or (2)",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
