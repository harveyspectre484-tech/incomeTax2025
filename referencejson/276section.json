      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "276-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "Income chargeable under the head \"Profits and gains of business or profession\" or \"Income from other sources\" shall, subject to the provisions of sub-section (2), be computed as per either cash or mercantile system of accounting regularly employed by the assessee.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-276-1-001",
              "target_id": "276-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "subject_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "276-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "The Central Government may notify income computation and disclosure standards to be followed by any class of assessees or in respect of any class of income.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "276-3",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer may make an assessment in the manner provided in section 271, where—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "276-3-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "he is not satisfied about the correctness or completeness of the accounts of the assessee; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "276-3-b",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "the method of accounting provided in sub-section (1) has not been regularly followed by the assessee; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-276-3-b-001",
                  "target_id": "276-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "procedure_reference",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "276-3-c",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "income has not been computed as per the standards notified under sub-section (2).",
              "children": [],
