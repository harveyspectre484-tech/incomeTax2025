      "text": "",
      "children": [
        {
          "type": "section",
          "number": "268",
          "id": "268",
          "title": "Inquiry before assessment.",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "",
          "subsections": [
            {
              "type": "subsection",
              "number": "1",
              "id": "268-1",
              "x": 27.62,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purpose of making an assessment under this Act, the Assessing Officer may serve on any person who has made a return under section 263 or in whose case the time allowed under section 263(1) for furnishing the return has expired, a notice requiring him, on a date to be specified therein,—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "268-1-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "where such person has not made a return within the time allowed under section 263(1) or before the end of the financial year succeeding the relevant tax year, to furnish a return of his income or the income of any other person in respect of which he is assessable under this Act, in such form and verified in such manner and setting forth such other particulars as may be prescribed;",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-268-1-a-001",
                      "target_id": "263-1",
                      "target_type": "subsection",
                      "anchor_text": "section 263(1) or before",
                      "relationship": "depends_on",
                      "confidence": "medium"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "268-1-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to produce, or cause to be produced, such accounts or documents as the Assessing Officer may require;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "268-1-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to furnish in writing and verified in the manner as may be prescribe information in such form and on such points or matters (including a statement of all assets and liabilities of the assessee, whether included in the accounts or not) as the Assessing Officer may require.",
                  "children": []
                }
              ],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-1-001",
                  "target_id": "263",
                  "target_type": "section",
                  "anchor_text": "section 263 or in",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-268-1-002",
                  "target_id": "263-1",
                  "target_type": "subsection",
                  "anchor_text": "section 263(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "2",
              "id": "268-2",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purposes of sub-section (1),—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "268-2-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the previous approval of the Joint Commissioner shall be obtained by the Assessing Officer before requiring the assessee to furnish a statement of all assets and liabilities not included in the accounts;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "268-2-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the Assessing Officer shall not require the production of any accounts relating to a period more than three years prior to the relevant tax year.",
                  "children": []
                }
              ],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-2-001",
                  "target_id": "268-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "definition_or_scope",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "3",
              "id": "268-3",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "A notice under sub-section (1)(a) may also be served by the prescribed income-tax authority.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-3-001",
                  "target_id": "268-1-a",
                  "target_type": "clause",
                  "anchor_text": "sub-section (1)(a)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "4",
              "id": "268-4",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purposes of obtaining full information in respect of the income or loss of any person, the Assessing Officer may make such inquiry as he considers necessary.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "5",
              "id": "268-5",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "If, at any stage of the proceedings before him, the Assessing Officer, having regard to—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "268-5-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the nature and complexity of the accounts; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "268-5-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "volume of the accounts; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "268-5-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "doubts about the correctness of the accounts; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "268-5-d",
                  "x": 40.8,
                  "y_start": 450.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "multiplicity of transactions in the accounts; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "e",
                  "id": "268-5-e",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "specialised nature of business activity of the assessee, and interests of the revenue, is of the opinion that it is necessary so to do, he may, after giving the assessee a reasonable opportunity of being heard, and with the previous approval of the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner, direct the assessee to get either or both of the following:—",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "268-5-e-i",
                      "x": 55.0,
                      "y_start": 465.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "to get the accounts audited by an accountant, and to furnish a report of such audit in the prescribed form duly signed and verified by such accountant and setting forth such particulars, as may be prescribed, and such other particulars as the Assessing Officer may require;"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "268-5-e-ii",
                      "x": 55.0,
                      "y_start": 480.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "to get the inventory valued by a cost accountant, and to furnish a report of such inventory valuation in the prescribed form as duly signed and verified by such cost accountant and setting forth such particulars, as may be prescribed, and such other particulars as the Assessing Officer may require. (6) The accountant or the cost accountant as referred to in sub-section (5) shall be nominated by the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner for the purposes of the said sub-section."
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "7",
              "id": "268-7",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The provisions of sub-section (5) shall have effect irrespective of whether or not accounts of the assessee have been audited under any other law for the time being in force or otherwise.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-7-001",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "8",
              "id": "268-8",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every report under sub-section (5) shall be furnished by the assessee to the Assessing Officer within such period as specified by the Assessing Officer.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-8-001",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "9",
              "id": "268-9",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The Assessing Officer may, on his own motion, or on an application made in this behalf by the assessee and for any good and sufficient reason, subject to the provisions of sub-section (10), extend the period referred to in sub-section (8) by such further period or periods as he thinks fit.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-9-001",
                  "target_id": "268-10",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (10)",
                  "relationship": "subject_to",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-268-9-002",
                  "target_id": "268-8",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (8)",
                  "relationship": "subject_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "10",
              "id": "268-10",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The aggregate of the period originally fixed under sub-section (8) and the period or periods so extended, as referred to in sub-section (9), shall not, in any case, exceed six months from the end of the month in which the direction under sub-section (5) is received by the assessee.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-10-001",
                  "target_id": "268-8",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (8) and the",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-268-10-002",
                  "target_id": "268-9",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (9)",
                  "relationship": "related_to",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-268-10-003",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "11",
              "id": "268-11",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The expenses of any audit or inventory valuation under sub-section (5) (including incidental expenses and remuneration of the accountant or the cost accountant) shall be—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "268-11-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "determined by the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner as per such guidelines issued in this behalf; and",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "268-11-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "paid by the Central Government.",
                  "children": []
                }
              ],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-11-001",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "12",
              "id": "268-12",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The assessee shall, except where the assessment is made under section 271, be given an opportunity of being heard in respect of any material gathered on the basis of any inquiry under sub-section (4), or any audit or inventory valuation under sub-section (5) and proposed to be utilised for the purposes of the assessment.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-12-001",
                  "target_id": "268-4",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (4)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-268-12-002",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5) and proposed",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-268-12-003",
                  "target_id": "271",
                  "target_type": "section",
                  "anchor_text": "section 271",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "13",
              "id": "268-13",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purposes of this section, \"cost accountant\" means a cost accountant as defined in section 2(1)(b) of the Cost and Works Accountants Act, 1959 (23 of 1959) and who holds a valid certificate of practice under section 6(1) of the said Act.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-268-13-001",
                  "target_id": "2-1-b",
                  "target_type": "clause",
                  "anchor_text": "section 2(1)(b)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-268-13-002",
                  "target_id": "6-1",
                  "target_type": "subsection",
                  "anchor_text": "section 6(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_subsections": ""
        }
      ]
    }
