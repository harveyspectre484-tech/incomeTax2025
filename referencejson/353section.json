          "page_end": 1,
          "text_before_clauses": "Where any registered non-profit organisation—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "353-1-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to maintain books of account under section 347; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-353-1-a-001",
                  "target_id": "347",
                  "target_type": "section",
                  "anchor_text": "section 347",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "353-1-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to get books of account audited under section 348; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-353-1-b-001",
                  "target_id": "348",
                  "target_type": "section",
                  "anchor_text": "section 348",
