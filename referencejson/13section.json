              "number": "b",
              "id": "13-b",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "Income from house property;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "13-c",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "Profits and gains of business or profession;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "13-d",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "Capital gains; and",
              "children": []
            },
            {
