          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "406-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "A person who pays any instalment or instalments of advance tax under sub-section (1), may increase or reduce the amount of advance tax payable in the remaining instalment or instalments to accord with specified sum and the advance tax payable thereon, and make payment of the said tax in the remaining instalment or instalments accordingly.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-406-2-001",
              "target_id": "406-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "406-3",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this section, the expression \"specified sum\" means current income as estimated by the assessee.",
          "children": []
        }
