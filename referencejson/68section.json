              "id": "68-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the sum so arrived at shall be deemed to be the full value of the consideration for the purposes of section 72.",
              "children": [],
