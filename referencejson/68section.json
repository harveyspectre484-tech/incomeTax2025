          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in section 67, where the assets of a company are distributed to its shareholders on its liquidation, such distribution shall not be regarded as a transfer by the company for the purposes of the said section.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
