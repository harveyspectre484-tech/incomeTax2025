      "title": "Income from house property.",
      "indent": 0,
      "line_start": 8,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "20-1",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "The annual value of property consisting of any buildings or lands appurtenant thereto, owned by the assessee shall be chargeable to income-tax under the head \"Income from house property\".",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "20-2",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of sub-section (1) shall not apply to such portions of the property, as the assessee may occupy for his business or profession, the profits of which are chargeable to income-tax.",
          "children": [],
