                  "target_id": "253",
                  "target_type": "section",
                  "anchor_text": "section 253",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "280-6-g",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any directions in the case of the assessee given by the Approving Panel under section 274(6);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-6-g-001",
                  "target_id": "274-6",
                  "target_type": "subsection",
                  "anchor_text": "section 274(6)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
