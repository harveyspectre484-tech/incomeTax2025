          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "280-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Before making the assessment, reassessment or recomputation under section 279, the Assessing Officer shall, subject to the provisions of section 281, issue a notice to the assessee, along with a copy of the order passed under section 281(3);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-1-a-001",
                  "target_id": "279",
                  "target_type": "section",
                  "anchor_text": "section 279",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-280-1-a-002",
                  "target_id": "281",
                  "target_type": "section",
                  "anchor_text": "section 281",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-280-1-a-003",
                  "target_id": "281-3",
                  "target_type": "subsection",
                  "anchor_text": "section 281(3)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "280-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the notice referred to in clause (a) shall require the assessee to furnish, within such period as may be specified therein, a return of his income or income of any other person in respect of whom he is assessable under this Act during the relevant tax year; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-1-b-001",
                  "target_id": "280-1-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "280-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "footnote_refs": [
                "59"
              ],
              "text": "the period specified in the notice referred to in clause (a) shall not be less than thirty days from the date of such notice but shall not exceed three months from the end of the month in which such notice is issued.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-1-c-001",
                  "target_id": "280-1-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "280-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The return of income required under sub-section (1) shall be furnished in such form, verified in such manner and setting forth such other particulars, as may be prescribed, and the provisions of this Act shall apply accordingly, as if such return were a return required to be furnished under section 263.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-280-2-001",
              "target_id": "280-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-280-2-002",
              "target_id": "263",
              "target_type": "section",
              "anchor_text": "section 263",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "280-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any return of income required to be furnished under sub-section (1), furnished after the expiry of the period specified in the notice under the said subsection, shall not be deemed to be a return under section 263.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-280-3-001",
              "target_id": "280-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-280-3-002",
              "target_id": "263",
              "target_type": "section",
              "anchor_text": "section 263",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "280-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No notice under this section shall be issued unless there is information with the Assessing Officer which suggests that the income chargeable to tax has escaped assessment in the case of the assessee for the relevant tax year.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "280-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No notice under this section shall be issued without prior approval of the specified authority, where the Assessing Officer has received—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "280-5-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "information under the scheme notified under section 260; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-5-a-001",
                  "target_id": "260",
                  "target_type": "section",
                  "anchor_text": "section 260",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "280-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "directions from the Approving Panel under section 274(6); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-5-b-001",
                  "target_id": "274-6",
                  "target_type": "subsection",
                  "anchor_text": "section 274(6)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "280-5-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any finding or direction contained in an order passed by any authority, Tribunal or court in any proceeding under this Act by way of appeal, reference or revision or by a Court in any proceeding under any other law.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "280-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section and section 281, the information with the Assessing Officer which suggests that the income chargeable to tax has escaped assessment means—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "280-6-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any information in the case of the assessee for the relevant tax year as per the risk management strategy formulated by the Board from time to time;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "280-6-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any audit objection to the effect that the assessment in the case of the assessee for the relevant tax year has not been made as per this Act;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "280-6-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any information received under an agreement referred to in section 159 of this Act;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-6-c-001",
                  "target_id": "159",
                  "target_type": "section",
                  "anchor_text": "section 159",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "280-6-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any information made available to the Assessing Officer under the scheme notified under section 260;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-6-d-001",
                  "target_id": "260",
                  "target_type": "section",
                  "anchor_text": "section 260",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "e",
              "id": "280-6-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any information which requires action in consequence of the order of a Tribunal or a Court;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "280-6-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any information in the case of the assessee emanating from the survey conducted under section 253, other than under sub-section (4) of the said section;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-280-6-f-001",
                  "target_id": "280-4",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (4)",
                  "relationship": "depends_on",
