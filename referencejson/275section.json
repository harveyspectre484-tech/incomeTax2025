{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "275",
      "id": "275",
      "title": "Reference to Dispute Resolution Panel.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "275-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "The Assessing Officer shall, irrespective of anything to the contrary contained in this Act, in the first instance, forward a draft of the proposed order of assessment (hereafter in this section referred to as the draft order) to the eligible assessee, if he proposes to make any variation which is prejudicial to the interest of such assessee.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "275-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "On receipt of the draft order, the eligible assessee shall, within thirty days of its receipt by him,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "file his acceptance of the variations to the Assessing Officer; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "file his objections, if any, to such variation with,—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "275-2-b-i",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the Dispute Resolution Panel; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "275-2-b-ii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the Assessing Officer.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "275-3",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer shall complete the assessment on the basis of the draft order, if—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-3-a",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee intimates to the Assessing Officer the acceptance of the variation; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-3-b",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "no objection is received within the period specified in sub-section (2).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-275-3-b-001",
                  "target_id": "275-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (2)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "275-4",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "footnote_refs": [
            "56"
          ],
          "text_before_clauses": "",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-4-a",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "The Assessing Officer shall, irrespective of anything contained in section 286, pass the assessment order under sub-section (3) within one month from the end of the month in which,—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "275-4-a-i",
                  "indent": 0,
                  "line_start": 16,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the acceptance is received; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "275-4-a-ii",
                  "indent": 0,
                  "line_start": 17,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the period of filing of objections under sub-section (2) expires.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-4-b",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "Irrespective of anything contained in section 286, where a draft of the proposed order of assessment under sub-section (1) is forwarded within the time period allowed under the said section, further time period available to the Assessing Officer to complete the assessment under sub-section (3) shall be governed by the provisions of this sub-section.]",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-275-4-b-001",
                  "target_id": "275-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-275-4-b-002",
                  "target_id": "275-3",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (3)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-275-4-b-003",
                  "target_id": "286",
                  "target_type": "section",
                  "anchor_text": "section 286",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "275-5",
          "indent": 0,
          "line_start": 19,
          "page_start": 1,
          "page_end": 1,
          "text": "The Dispute Resolution Panel shall, in a case where any objection is received under sub-section (2), issue such directions, as it thinks fit, for guidance of the Assessing Officer to enable him to complete the assessment.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-5-001",
              "target_id": "275-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "275-6",
          "indent": 0,
          "line_start": 20,
          "page_start": 1,
          "page_end": 1,
          "text": "The Dispute Resolution Panel shall issue the directions as referred to in sub-section (5), in writing, stating the points of determination, the decision thereon and the reason for such decision.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-6-001",
              "target_id": "275-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "275-7",
          "indent": 0,
          "line_start": 21,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Dispute Resolution Panel may, before issuing any directions referred to in sub-section (5),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-7-a",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "make such further enquiry, as it thinks fit; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-7-b",
              "indent": 0,
              "line_start": 23,
              "page_start": 1,
              "page_end": 1,
              "text": "cause any further enquiry to be made by any income-tax authority and report the result of the same to such panel.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-275-7-001",
              "target_id": "275-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "275-8",
          "indent": 0,
          "line_start": 24,
          "page_start": 1,
          "page_end": 1,
          "text": "The Dispute Resolution Panel may, confirm, reduce or enhance the variations proposed in the draft order, so however, that it shall not set aside any proposed variation, or issue any direction under sub-section (5) for further enquiry and passing of the assessment order.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-8-001",
              "target_id": "275-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "275-9",
          "indent": 0,
          "line_start": 25,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of sub-section (8), the power of the Dispute Resolution Panel to enhance the variation shall include the power to consider any matter arising out of the assessment proceedings relating to the draft order, irrespective of the fact that such matter was not raised by the eligible assessee.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-9-001",
              "target_id": "275-8",
              "target_type": "subsection",
              "anchor_text": "sub-section (8)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "275-10",
          "indent": 0,
          "line_start": 26,
          "page_start": 1,
          "page_end": 1,
          "text": "If the members of the Dispute Resolution Panel differ in opinion on any point, the point shall be decided as per the opinion of the majority of the members.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "275-11",
          "indent": 0,
          "line_start": 27,
          "page_start": 1,
          "page_end": 1,
          "text": "Every direction issued by the Dispute Resolution Panel shall be binding on the Assessing Officer.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "12",
          "id": "275-12",
          "indent": 0,
          "line_start": 28,
          "page_start": 1,
          "page_end": 1,
          "text": "No direction under sub-section (5) shall be issued unless an opportunity of being heard is given to the assessee, and the Assessing Officer, on such directions which are prejudicial to the interest of the assessee, or the interest of the revenue, respectively.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-12-001",
              "target_id": "275-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "13",
          "id": "275-13",
          "indent": 0,
          "line_start": 29,
          "page_start": 1,
          "page_end": 1,
          "text": "No direction under sub-section (5) shall be issued after nine months from the end of the month in which the draft order is forwarded to the eligible assessee.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-13-001",
              "target_id": "275-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "14",
          "id": "275-14",
          "indent": 0,
          "line_start": 30,
          "page_start": 1,
          "page_end": 1,
          "footnote_refs": [
            "57"
          ],
          "text_before_clauses": "",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-14-a",
              "indent": 0,
              "line_start": 30,
              "page_start": 1,
              "page_end": 1,
              "text": "Upon receipt of the directions issued under sub-section (5), the Assessing Officer shall, in conformity with the directions, complete, irrespective of anything to the contrary contained in section 286, the assessment without providing any further opportunity of being heard to the assessee, within one month from the end of the month in which such direction is received.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-275-14-a-001",
                  "target_id": "275-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-275-14-a-002",
                  "target_id": "286",
                  "target_type": "section",
                  "anchor_text": "section 286",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-14-b",
              "indent": 0,
              "line_start": 31,
              "page_start": 1,
              "page_end": 1,
              "text": "Irrespective of anything contained in section 286, where a draft of the proposed order of assessment under sub-section (1) is forwarded within the time period allowed under section 286, time period available for the Assessing Officer under this sub-section to pass the assessment order upon receipt of the direction issued under sub-section (5), shall be governed by the provisions of sub-section (13) and this sub-section.]",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-275-14-b-001",
                  "target_id": "275-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-275-14-b-002",
                  "target_id": "275-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "depends_on",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-275-14-b-003",
                  "target_id": "275-13",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (13) and this",
                  "relationship": "related_to",
                  "confidence": "high"
                },
                {
                  "reference_id": "ref-275-14-b-004",
                  "target_id": "286",
                  "target_type": "section",
                  "anchor_text": "section 286",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-275-14-b-005",
                  "target_id": "286",
                  "target_type": "section",
                  "anchor_text": "section 286",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "15",
          "id": "275-15",
          "indent": 0,
          "line_start": 32,
          "page_start": 1,
          "page_end": 1,
          "text": "The Board may make rules for the purposes of the efficient functioning of the Dispute Resolution Panel and expeditious disposal of the objections filed under sub-section (2) by the eligible assessee.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-15-001",
              "target_id": "275-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "16",
          "id": "275-16",
          "indent": 0,
          "line_start": 33,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of this section shall not apply to any assessment or reassessment order passed by the Assessing Officer with the prior approval of the Principal Commissioner or Commissioner as provided in section 274(12).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-16-001",
              "target_id": "274-12",
              "target_type": "subsection",
              "anchor_text": "section 274(12)",
              "relationship": "procedure_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "17",
          "id": "275-17",
          "indent": 0,
          "line_start": 34,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, subject to the provisions of sub-section (18),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-17-a",
              "indent": 0,
              "line_start": 35,
              "page_start": 1,
              "page_end": 1,
              "text": "\"Dispute Resolution Panel\" means a collegium comprising of three Principal Commissioners or Commissioners of Income-tax constituted by the Board for this purpose;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-17-b",
              "indent": 0,
              "line_start": 36,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"eligible assessee\" means,—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "275-17-b-i",
                  "indent": 0,
                  "line_start": 37,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any person in whose case the variation referred to in sub-section (1) arises as a consequence of the order of the Transfer Pricing Officer passed under section 166(6);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "275-17-b-ii",
                  "indent": 0,
                  "line_start": 38,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any non-resident (not being a company), or any foreign company.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-275-17-001",
              "target_id": "275-18",
              "target_type": "subsection",
              "anchor_text": "sub-section (18)",
              "relationship": "subject_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "18",
          "id": "275-18",
          "indent": 0,
          "line_start": 39,
          "page_start": 1,
          "page_end": 1,
          "text": "The eligible assessee referred to in sub-section (17) shall not include person referred to in section 292(1) or other person referred to in section 295.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-275-18-001",
              "target_id": "275-17",
              "target_type": "subsection",
              "anchor_text": "sub-section (17)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-275-18-002",
              "target_id": "292-1",
              "target_type": "subsection",
              "anchor_text": "section 292(1) or other",
              "relationship": "related_to",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-275-18-003",
              "target_id": "295",
              "target_type": "section",
              "anchor_text": "section 295",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "19",
          "id": "275-19",
          "indent": 0,
          "line_start": 40,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The provisions of this section shall not apply to any proceedings under Chapter XVI-B. \"(4) The Assessing Officer shall, irrespective of anything contained in section 286, pass the assessment order under sub-section (3) within one month from the end of the month in which,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "275-19-a",
              "indent": 0,
              "line_start": 43,
              "page_start": 1,
              "page_end": 1,
              "text": "the acceptance is received; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "275-19-b",
              "indent": 0,
              "line_start": 44,
              "page_start": 1,
              "page_end": 1,
              "text": "the period of filing of objections under sub-section (2) expires.\"",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-275-19-b-001",
                  "target_id": "275-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (2)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-275-19-001",
              "target_id": "275-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-275-19-002",
              "target_id": "286",
              "target_type": "section",
              "anchor_text": "section 286",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
