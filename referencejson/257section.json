            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "257-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "Every income-tax authority shall be deemed to be a Civil Court for the purposes of section 215 of the Bharatiya Nagarik Suraksha Sanhita, 2023 (46 of 2023), but not for the purposes of Chapter XXVIII of the Bharatiya Nagarik Suraksha Sanhita, 2023 (46 of 2023).",
          "children": [],
