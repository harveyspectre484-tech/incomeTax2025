          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-169-4-001",
              "target_id": "275",
              "target_type": "section",
              "anchor_text": "section 275 or 286",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "169-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "b",
              "id": "169-5-b",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of a case falling under sub-section (3)(b), the period of limitation as provided in section 275 or 286 or section 296 for completion of pending assessment or reassessment proceedings shall be extended by twelve months.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-169-5-b-001",
                  "target_id": "169-3-b",
                  "target_type": "clause",
