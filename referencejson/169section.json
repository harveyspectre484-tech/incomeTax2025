                  "target_id": "275",
                  "target_type": "section",
                  "anchor_text": "section 275 or 286",
                  "relationship": "procedure_reference",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-169-5-b-003",
                  "target_id": "296",
                  "target_type": "section",
                  "anchor_text": "section 296",
                  "relationship": "procedure_reference",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "a",
              "id": "169-5-a",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"agreement\" means an agreement referred to in section 168(1);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-169-5-a-001",
                  "target_id": "168-1",
                  "target_type": "subsection",
                  "anchor_text": "section 168(1)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            },
            {
