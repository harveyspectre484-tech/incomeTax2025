      "number": "244",
      "id": "244",
      "title": "Change of incumbent of an office.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "244-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "Whenever, in respect of any proceeding under this Act, an income-tax authority ceases to exercise jurisdiction and is succeeded by another who has and exercises jurisdiction, the income-tax authority so succeeding may continue the proceeding from the stage at which the proceeding was left by his predecessor.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "244-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Before the proceeding referred to in sub-section (1) is so continued, the assessee concerned may demand that––",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "244-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "the previous proceeding or any part thereof be reopened; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "244-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "he be reheard before any order of assessment is passed against him.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-244-2-001",
