              "target_type": "section",
              "anchor_text": "section 280",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "283-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The provisions of sub-section (1) shall not apply in any case, where the assessment or reassessment or recomputation as is referred to in that subsection relates to a tax year in respect of which an assessment or reassessment or recomputation could not have been made under this Act due to it being time-barred, at the time when,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "283-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "the order, which was the subject-matter before any authority, Tribunal or Court, was made; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "283-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "the proceedings relating to assessment or reassessment or recomputation under this Act (other than those proceedings which have culminated in an order), which was the subject-matter before the Court, was initiated; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "283-2-c",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "the reference from the jurisdictional Principal Commissioner or Commissioner is made to the Approving Panel under section 274(4).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-283-2-c-001",
                  "target_id": "274-4",
                  "target_type": "subsection",
                  "anchor_text": "section 274(4)",
