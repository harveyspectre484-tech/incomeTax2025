                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-283-1-001",
              "target_id": "282",
              "target_type": "section",
              "anchor_text": "section 282",
              "relationship": "related_to",
