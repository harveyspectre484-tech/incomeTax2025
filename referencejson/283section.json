          "line_start": 4,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in section 282, the notice under section 280 may be issued at any time for the purpose of making an assessment or reassessment or recomputation in consequence of, or to give effect to,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "283-1-a",
              "indent": 0,
              "line_start": 5,
              "page_start": 1,
              "page_end": 1,
              "text": "any finding or direction contained in an order passed by any authority. Tribunal or Court in any proceeding under this Act or any other law; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "283-1-b",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "the directions issued by the Approving Panel under section 274(6).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-283-1-b-001",
                  "target_id": "274-6",
                  "target_type": "subsection",
                  "anchor_text": "section 274(6)",
