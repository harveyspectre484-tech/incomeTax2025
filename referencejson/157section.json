      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "157-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where the total income of an assessee is assessed at a rate higher than the rate at which it would otherwise have been assessed, due to the following receipts,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "157-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "a sum in the nature of arrear or advance salary; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "157-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "salary for more than twelve months in any one tax year; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "157-1-c",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "a payment in the nature of \"profits in lieu of salary\" under section 18(1); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-157-1-c-001",
                  "target_id": "18-1",
                  "target_type": "subsection",
                  "anchor_text": "section 18(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "157-1-d",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "arrears of \"family pension\" as defined in section 93(1)(d), the Assessing Officer shall on an application made to him by the assessee in this behalf, grant such relief, as may be prescribed.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-157-1-d-001",
                  "target_id": "93-1-d",
                  "target_type": "clause",
                  "anchor_text": "section 93(1)(d)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "157-2",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text": "No relief shall be granted on any income on which deduction has been claimed by the assessee in section 19(1)(Table: Sl. No. 12) for any amount mentioned therein, for such, or any other, tax year.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-157-2-001",
              "target_id": "19-1",
              "target_type": "subsection",
              "anchor_text": "section 19(1)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": [
    {
      "page": 1,
      "line": 4,
      "text": "Relief when salary, etc., is paid in arrears or in advance."
    }
  ]
