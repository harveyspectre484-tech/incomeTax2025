{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "509",
      "id": "509",
      "title": "Obligation to furnish information on transaction of crypto-asset.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "509-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any person, being a reporting entity, as may be prescribed, in respect of a crypto-asset, shall furnish information in respect of a transaction of such crypto-asset in a statement, for such period, within such time, in such form and manner and to such income-tax authority, as may be prescribed.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "509-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where the prescribed income-tax authority considers that the statement furnished under sub-section (1) is defective, he may intimate the defect to the person who has furnished such statement and give him an opportunity of rectifying the defect within thirty days from the date of such intimation or such further period as may be allowed, and if the defect is not rectified within such period, the provisions of this Act shall apply as if such person had furnished inaccurate information in the statement.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-509-2-001",
              "target_id": "509-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "509-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where a person who is required to furnish a statement under sub-section (1) has not furnished the same within the specified time, the prescribed income-tax authority may serve upon such person a notice requiring him to furnish such statement within a period not exceeding thirty days from the date of service of such notice and he shall furnish the statement within the time specified in the notice.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-509-3-001",
              "target_id": "509-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "509-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If any person, having furnished a statement under sub-section (1), or in pursuance of a notice issued under sub-section (3), comes to know or discovers any inaccuracy in the information provided in the statement, he shall within ten days inform the prescribed income-tax authority, the inaccuracy in such statement and furnish the correct information in such manner as may be prescribed.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-509-4-001",
              "target_id": "509-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-509-4-002",
              "target_id": "509-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "procedure_reference",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "509-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Central Government may, by rules prescribe—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "509-5-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the persons referred to in sub-section (1) to be registered with the prescribed income-tax authority;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-509-5-a-001",
                  "target_id": "509-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1) to be",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "509-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the nature of information and the manner in which such information shall be maintained by the persons referred to in clause (a); and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-509-5-b-001",
                  "target_id": "509-5-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "509-5-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the due diligence to be carried out by the persons referred to in sub-section (1) for the purpose of identification of any crypto-asset user or owner.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-509-5-c-001",
                  "target_id": "509-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "509-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, the expression \"crypto-asset\" shall have the meaning assigned to it in section 2(111)(d).",
