        },
        {
          "type": "subsection",
          "number": "4",
          "id": "188-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In sub-section (1), \"Rs. 200000\" shall be substituted for \"Rs. 20000\" in the case of any deposit or loan where—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "188-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such deposit is repaid to a member by a primary agricultural credit society or a primary co-operative agricultural and rural development bank; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "188-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such loan is repaid by a member to a primary agricultural credit society or a primary co-operative agricultural and rural development bank.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-188-4-001",
              "target_id": "188-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
