      "type": "section",
      "number": "188",
      "id": "188",
      "title": "Mode of repayment of certain loans or deposits or specified advances.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "188-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No branch of a banking company or co-operative bank and no other company or co-operative society and no firm or other person shall repay—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "188-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any loan or deposit made with it; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "188-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any specified advance received by it, except through—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "188-1-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an account payee cheque;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "188-1-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "account payee bank draft drawn in the name of the person who has made the loan or deposit or paid the specified advance; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "188-1-b-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "by use of electronic clearing system through a bank account, or any other prescribed electronic mode, if, —"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "188-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of the provision in sub-section (1), a branch of a banking company or co-operative bank, may also make the repayment by crediting such loan or deposit to the savings bank account or current account, if any, with such branch of the person to whom such loan or deposit has to be repaid.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-188-2-001",
              "target_id": "188-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "188-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Sub-section (1) shall not apply to repayment of any loan, deposit, or specified advance taken or accepted from—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "188-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Government;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "188-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any banking company, post office savings bank, or co-operative bank;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "188-3-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any corporation established by a Central, State, or Provincial Act;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "188-3-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any Government company as defined in section 2(45) of the Companies Act, 2013 (18 of 2013);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-188-3-d-001",
                  "target_id": "2-45",
                  "target_type": "subsection",
                  "anchor_text": "section 2(45)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "e",
              "id": "188-3-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any institution, association, or body or class of institutions, associations or bodies notified by the Central Government.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-188-3-001",
              "target_id": "188-1",
              "target_type": "subsection",
              "anchor_text": "Sub-section (1)",
