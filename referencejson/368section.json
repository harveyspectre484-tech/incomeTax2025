      "id": "368",
      "title": "Hearing before Supreme Court.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "368-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of the Code of Civil Procedure, 1908 (5 of 1908), relating to appeals to the Supreme Court shall, so far as may be, apply in the case of appeals under section 367 as they apply in the case of appeals from decrees of a High Court.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-368-1-001",
              "target_id": "367",
              "target_type": "section",
              "anchor_text": "section 367",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "368-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "The costs of the appeal shall be at the discretion of the Supreme Court.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "368-3",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "Where the judgment of the High Court is varied or reversed in the appeal, effect shall be given to the order of the Supreme Court in the manner provided in section 365(10) in the case of a judgment of the High Court.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-368-3-001",
              "target_id": "365-10",
              "target_type": "subsection",
              "anchor_text": "section 365(10)",
              "relationship": "procedure_reference",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
