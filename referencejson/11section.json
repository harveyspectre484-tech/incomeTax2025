      "sections": [
        {
          "type": "section",
          "number": "11",
          "id": "11",
          "title": "Incomes not included in total income.",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "",
          "subsections": [
            {
              "type": "subsection",
              "number": "1",
              "id": "11-1",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "In computing the total income of any person for a tax year under this Act, any income enumerated in Schedules II, III, IV, V and VI shall not be included, subject to fulfilment of conditions specified therein.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-11-1-001",
                  "target_id": "schedule-II",
                  "target_type": "schedule",
                  "anchor_text": "Schedules II",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-11-1-001",
                  "target_id": "schedule-III",
                  "target_type": "schedule",
                  "anchor_text": "III",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-11-1-001",
                  "target_id": "schedule-IV",
                  "target_type": "schedule",
                  "anchor_text": "IV",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-11-1-001",
                  "target_id": "schedule-V",
                  "target_type": "schedule",
                  "anchor_text": "V",
                  "relationship": "subject_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-11-1-001",
                  "target_id": "schedule-VI",
                  "target_type": "schedule",
                  "anchor_text": "VI",
                  "relationship": "subject_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "2",
              "id": "11-2",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "Wherever the conditions referred to in the Schedules referred in sub-section (1) are not satisfied in any tax year in respect of any income enumerated in the said Schedules, such income shall be charged to tax under this Act on the total income for that tax year.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-11-2-001",
                  "target_id": "11-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "3",
              "id": "11-3",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "The persons enumerated in Schedule VII shall, subject to fulfilment of the conditions specified therein, not be chargeable to tax under this Act on the total income for a tax year.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-11-3-001",
                  "target_id": "schedule-VII",
                  "target_type": "schedule",
                  "anchor_text": "Schedule VII",
                  "relationship": "subject_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "4",
              "id": "11-4",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "Wherever the conditions referred to in Schedule VII are not satisfied in respect of the persons enumerated in the said Schedule in any tax year, the income of such person shall be charged to tax under the provisions of this Act for that tax year.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-11-4-001",
                  "target_id": "schedule-VII",
                  "target_type": "schedule",
                  "anchor_text": "Schedule VII",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "5",
              "id": "11-5",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "The Central Government may make rules or issue notifications for the purposes of this section as specified in Schedules II, III, IV, V, VI and VII.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-11-1-001",
                  "target_id": "schedule-II",
                  "target_type": "schedule",
                  "anchor_text": "Schedules II",
