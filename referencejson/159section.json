{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "159",
      "id": "159",
      "title": "Agreement with foreign countries or specified territories and adoption by Central Government of agreement between specified associations for double taxation relief.",
      "indent": 0,
      "line_start": 7,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "159-1",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Central Government may enter into an agreement with the Government of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-1-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "any other country; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "159-1-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "any specified territory, for the purposes mentioned in sub-section (3), and may, by notification, make such provisions as necessary for implementing the agreement.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-159-1-b-001",
                  "target_id": "159-3",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (3)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "159-2",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text": "Any specified association in India may enter into an agreement with any specified association in the specified territory for the purposes mentioned in sub-section (3) and the Central Government may, by notification, make such provisions as may be necessary for adopting and implementing such agreement.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-159-2-001",
              "target_id": "159-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3) and the",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "159-3",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The agreement mentioned in sub-section (1) or (2) may be entered for—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-3-a",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the granting of relief in respect of—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "159-3-a-i",
                  "indent": 0,
                  "line_start": 14,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "income on which income-tax under this Act and income-tax in that country or specified territory, as the case may be have been paid;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "159-3-a-ii",
                  "indent": 0,
                  "line_start": 15,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "income-tax chargeable under this Act and under the corresponding law in force in that country or specified territory, as the case may be, to promote mutual economic relations, trade and investment; or",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "159-3-b",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "the avoidance of double taxation of income under this Act and under the corresponding law in force in that country or specified territory, as the case may be, without creating opportunities for non-taxation or reduced taxation through tax evasion or avoidance (including through treaty-shopping arrangements aimed at obtaining reliefs provided in the said agreement for the indirect benefit to residents of any other country or territory);",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "159-3-c",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "exchange of information for—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "159-3-c-i",
                  "indent": 0,
                  "line_start": 18,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the prevention of evasion or avoidance of income-tax chargeable under this Act or under the corresponding law in force in that country or specified territory, as the case may be; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "159-3-c-ii",
                  "indent": 0,
                  "line_start": 19,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "investigation of cases of such evasion or avoidance; or",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "d",
              "id": "159-3-d",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "recovery of income-tax under this Act and under the corresponding law in force in that country or specified territory, as the case may be.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-159-3-001",
              "target_id": "159-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "159-4",
          "indent": 0,
          "line_start": 21,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-4-a",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "the Central Government has entered into an agreement with the Government of any country or specified territory, as the case may be, under subsection (1); or agreement has been notified under that sub-section, for granting relief of tax, or avoidance of double taxation, then, in relation to the assessee to whom such agreement applies, the provisions of this Act shall apply to the extent they are more beneficial to that assessee.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-159-4-a-001",
                  "target_id": "159-1",
                  "target_type": "subsection",
                  "anchor_text": "subsection (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "159-4-b",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text": "a specified association in India has entered into an agreement with a specified association of any specified territory under sub-section (2) and such",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-159-4-b-001",
                  "target_id": "159-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (2) and such",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "159-5",
          "indent": 0,
          "line_start": 25,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The charge of tax,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-5-a",
              "indent": 0,
              "line_start": 26,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of a foreign company at a rate higher than the rate at which a domestic company is chargeable; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "159-5-b",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of a company incorporated in the specified territory at a rate higher than the rate at which a domestic company is chargeable, shall not be regarded as less favourable charge or levy of tax in respect of such foreign company or such company incorporated in the specified territory, as the case may be.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "159-6",
          "indent": 0,
          "line_start": 28,
          "page_start": 1,
          "page_end": 1,
          "text": "Irrespective of anything contained in sub-section (4), the provisions of Chapter XI shall apply to the assessee, even if such provisions are not beneficial to him.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-159-6-001",
              "target_id": "159-4",
              "target_type": "subsection",
              "anchor_text": "sub-section (4)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "159-7",
          "indent": 0,
          "line_start": 29,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where, any—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-7-a",
              "indent": 0,
              "line_start": 30,
              "page_start": 1,
              "page_end": 1,
              "text": "term used in an agreement entered into under sub-section (1) or (2), is defined under the said agreement, the said term shall have the same meaning as assigned to it in that agreement and where the term is not defined in that agreement, but defined in this Act, it shall have the same meaning as assigned to it in this Act and the explanation, if any, given to it by the Central Government; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-159-7-a-001",
                  "target_id": "159-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1) or (2)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "159-7-b",
              "indent": 0,
              "line_start": 31,
              "page_start": 1,
              "page_end": 1,
              "text": "term is used but not defined in this Act or in the agreement referred to in sub-section (1) or (2), it shall, unless the context otherwise requires, and is not inconsistent with the provisions of this Act or the said agreement, have the same meaning as assigned to it in the notification issued by the Central Government in this behalf, and the meaning assigned to such term shall be deemed to have effect from the date on which that agreement came into force; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-159-7-b-001",
                  "target_id": "159-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1) or (2)",
                  "relationship": "definition_reference",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "159-7-c",
              "indent": 0,
              "line_start": 32,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "term is used in any agreement entered into under sub-section (1) or (2), and not defined under the said agreement or this Act, or in any notification issued under clause (b), then, unless the context otherwise requires, it shall have the same meaning as assigned to it—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "159-7-c-i",
                  "indent": 0,
                  "line_start": 33,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in any Act of the Central Government related to taxes; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "159-7-c-ii",
                  "indent": 0,
                  "line_start": 34,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in any other case, in any other law of the Central Government, and shall be deemed to have effect from the date on which the said agreement came into force.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "159-8",
          "indent": 0,
          "line_start": 36,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An assessee, not being a resident, shall be entitled to claim any relief under an agreement mentioned in sub-section (1) or (2), only when—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-8-a",
              "indent": 0,
              "line_start": 37,
              "page_start": 1,
              "page_end": 1,
              "text": "a certificate of his being a resident in any country or specified territory, is obtained by him from the Government of that country or Government of that specified territory, as the case may be; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "159-8-b",
              "indent": 0,
              "line_start": 38,
              "page_start": 1,
              "page_end": 1,
              "text": "he provides such other documents and information, as may be prescribed.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-159-8-001",
              "target_id": "159-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "159-9",
          "indent": 0,
          "line_start": 39,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "159-9-a",
              "indent": 0,
              "line_start": 40,
              "page_start": 1,
              "page_end": 1,
              "text_before_items": "\"specified associations\" means any institution, association or body, whether incorporated or not—",
              "items": [
                {
                  "type": "item",
                  "number": "A",
                  "id": "159-9-a-A",
                  "indent": 0,
                  "line_start": 41,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "functioning under any law for the time being in force in India or the laws of the specified territory; and",
                  "children": []
                },
                {
                  "type": "item",
                  "number": "B",
                  "id": "159-9-a-B",
                  "indent": 0,
                  "line_start": 42,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "which may be notified as such by the Central Government for the purposes of this section;",
                  "children": []
                },
                {
                  "type": "item",
                  "number": "b",
                  "id": "159-9-a-b",
                  "indent": 0,
                  "line_start": 43,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"specified territory\" means any area outside India which may be notified as such by the Central Government.",
                  "children": []
                }
              ],
              "text_after_items": ""
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
