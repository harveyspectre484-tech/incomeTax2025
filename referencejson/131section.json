  "sections": [
    {
      "type": "section",
      "number": "131",
      "id": "131",
      "title": "Deduction in respect of interest on loan taken for certain house property.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "131-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An assessee, being an individual not eligible to claim deduction under section 130, shall be allowed a deduction of interest payable on loan taken by him from any financial institution for the purpose of acquisition of a residential house property, subject to a maximum limit of Rs. 150000 in a tax year and on fulfilment of conditions specified in sub-section (2), for the tax year beginning on the 1st April, 2019 and subsequent tax years.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-131-1-001",
              "target_id": "131-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-131-1-002",
              "target_id": "130",
              "target_type": "section",
              "anchor_text": "section 130",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "131-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The conditions referred in sub-section (1) shall be the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "131-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the loan has been sanctioned by the financial institution during the period beginning on the 1st April, 2019 and ending on the 31st March, 2022;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "131-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the stamp duty value of residential house property does not exceed forty-five lakh rupees; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "131-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee does not own any residential house property on the date of sanction of loan.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-131-2-001",
              "target_id": "131-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "131-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where a deduction under this section is allowed for any interest referred to in sub-section (1), deduction shall not be allowed in respect of such interest under any other provision of this Act for the same or any other tax year.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-131-3-001",
              "target_id": "131-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
