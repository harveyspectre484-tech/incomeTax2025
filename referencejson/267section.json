            {
              "type": "clause",
              "number": "a",
              "id": "267-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee shall be liable to pay such tax together with interest and fee payable under any of the provisions of this Act for any delay in furnishing the return or any default or delay in payment of advance tax;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "267-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such tax, interest and fee shall be payable along with the payment of additional income-tax computed as per sub-section (5), before furnishing the return; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-267-1-b-001",
                  "target_id": "267-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (5)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "267-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the return shall be accompanied by proof of payment of such tax, additional income-tax, interest and fee.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
