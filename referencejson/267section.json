          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in section 424(2), for the purposes of sub-section (3), interest payable under section 424 shall be computed on an amount equal to the assessed tax where, \"assessed tax\" means the tax on the total income as declared in the return to be furnished under section 263(6),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "267-7-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "after taking into account,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "267-7-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the amount of relief or tax referred to in section 266(1), the credit for which has been claimed in the earlier return, if any;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "267-7-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "tax deducted or collected at source, as per the provisions of Chapter XIX-B, on any income which is subject to such deduction or collection and which is taken into account in computing such total income, which has not been included in the earlier return;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "267-7-a-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any relief of tax or deduction of tax claimed under section 159(1) or 160 on account of tax paid in a country outside India on such income which has not been included in the earlier return;"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
