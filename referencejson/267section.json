                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any relief of tax claimed under section 159(2) on account of tax paid in any specified territory outside India referred to in that section on such income which has not been included in the earlier return;"
                },
                {
                  "type": "sub-clause",
                  "number": "v",
                  "id": "267-7-a-v",
                  "x": 55.0,
