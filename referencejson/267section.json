            {
              "type": "clause",
              "number": "a",
              "id": "267-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee shall be liable to pay such tax together with interest payable under any provision of this Act for any default or delay in payment of advance tax;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "267-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such tax, interest and fee shall be payable along with the payment of additional income-tax, as computed as per sub-section (5), as reduced by the amount of interest paid under the provisions of this Act in the earlier return, before furnishing the return; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-267-3-b-001",
                  "target_id": "267-5",
