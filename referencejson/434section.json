          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer may, before passing an order under sub-section (2), make such inquiry as he considers necessary.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
