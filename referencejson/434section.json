          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer shall, by an order in writing, allow or reject the application as referred to in sub-section (1).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-434-2-001",
              "target_id": "434-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
