          "id": "434-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No application under sub-section (1) shall be rejected unless an opportunity of being heard has been given to the applicant.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-434-3-001",
