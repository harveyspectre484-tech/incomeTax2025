{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "57",
      "id": "57",
      "title": "Revenue recognition for construction and service contracts.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "57-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "The profits and gains arising from a construction contract or a contract for providing services, shall be determined on the basis of percentage of completion method, subject to provisions of sub-section (2), as per the income computation and disclosure standards notified under section 276(2).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-57-1-001",
              "target_id": "57-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "subject_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-57-1-002",
              "target_id": "276-2",
              "target_type": "subsection",
              "anchor_text": "section 276(2)",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "57-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (1), the profits and gains arising from a contract for providing services shall be determined—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "57-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "on the basis of project completion method, if the duration of such contract is not more than ninety days;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "57-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "on the basis of straight line method, if the contract involves indeterminate number of acts over a specified period of time.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-57-2-001",
              "target_id": "57-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "57-3",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of percentage of completion method, project completion method or straight line method under this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "57-3-a",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "the contract revenue shall include retention money;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "57-3-b",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "the contract costs shall not be reduced by any incidental income in the nature of interest, dividends or capital gains.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
