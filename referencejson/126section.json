            {
              "type": "clause",
              "number": "b",
              "id": "126-9-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "other than cash in all other cases not falling under clause (a).",
              "children": [],
              "references": [
                {
