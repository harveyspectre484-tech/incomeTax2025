          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The amount of sum under sub-section (5) shall not exceed Rs. 50000 in the aggregate of the sum specified under sub-section (5)(a) and (b).",
          "clauses": [],
