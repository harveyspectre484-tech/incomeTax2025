              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-126-4-003",
              "target_id": "126-2-b",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(b) and (d)",
              "relationship": "depends_on",
              "confidence": "high"
            }
