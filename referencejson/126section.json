              "number": "b",
              "id": "126-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "on account of medical expenditure incurred on the health of any member of such Hindu undivided family, up to Rs. 50000 in the aggregate.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
