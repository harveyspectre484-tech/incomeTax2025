          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, where the amount is paid on account of medical expenditure incurred on the health of a senior citizen under sub-section (2)(c) or (d) or (5)(b), deduction shall be allowed, if no amount has been paid to effect or to keep in force the health insurance of such person.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-126-7-001",
              "target_id": "126-2-c",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(c) or (d)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "126-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where the sum specified in sub-section (2)(a) or (b) or (5)(a) is paid to effect or keep in force the health insurance of any person specified therein, and —",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "126-8-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such person is a senior citizen, the amount of sum as provided in such clauses, shall be substituted with Rs. 50000 for Rs. 25000; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "126-8-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such sum is paid in lump sum in the tax year for more than a year, a deduction shall be allowed for each of the relevant tax year equal to the appropriate fraction of such amount.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-126-8-001",
              "target_id": "126-2-a",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(a) or (b)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
