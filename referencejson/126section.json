          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-126-9-001",
              "target_id": "126-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "126-10",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "126-10-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"appropriate fraction\" means the fraction where the numerator is one, and the denominator is the total number of relevant tax years;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "126-10-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"family\" means the spouse and dependant children of the assessee;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "126-10-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"relevant tax year\" means the tax year beginning with the tax year in which such lump sum amount is paid and the subsequent tax year or years during which the health insurance remains in force.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
