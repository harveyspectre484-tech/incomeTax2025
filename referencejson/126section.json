          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In the case of an assessee, being a Hindu undivided family, the sum referred to in sub-section (1), shall be the aggregate of the whole of the amount paid —",
          "clauses": [
