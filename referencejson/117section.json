{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "117",
      "id": "117",
      "title": "Income Tax Department",
      "indent": 0,
      "line_start": 4,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "117-1",
          "indent": 0,
          "line_start": 4,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in section 2(6)(a) to (c) or section 116, where there has been an amalgamation of,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "117-1-a",
              "indent": 0,
              "line_start": 5,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "one or more banking company with—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "117-1-a-i",
                  "indent": 0,
                  "line_start": 6,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other banking institution under a scheme sanctioned and brought into force by the Central Government under section 45(7) of the Banking Regulation Act, 1949 (10 of 1949); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "117-1-a-ii",
                  "indent": 0,
                  "line_start": 7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other banking institution or a company following a strategic disinvestment, wherein the amalgamation occurs within five years from the end of the tax year during which such disinvestment is carried out; or",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "117-1-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "one or more corresponding new bank or banks with any other corresponding new bank under a scheme brought into force by the Central Government under section 9 of the Banking Companies (Acquisition and Transfer of Undertakings) Act, 1970 (5 of 1970) or under section 9 of the Banking Companies (Acquisition and Transfer of Undertakings) Act, 1980 (40 of 1980), or both; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-1-b-001",
                  "target_id": "9",
                  "target_type": "section",
                  "anchor_text": "section 9",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "117-1-c",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "one or more Government company or companies with any other Government company under a scheme sanctioned and brought into force by the Central Government under section 16 of the General Insurance Business (Nationalisation) Act, 1972 (57 of 1972), the accumulated loss and unabsorbed depreciation of such banking company or companies or amalgamating corresponding new bank or banks or amalgamating Government company or companies, shall be deemed to be the loss or, allowance for depreciation of the banking institution or company or amalgamated corresponding new bank or amalgamated Government company for the tax year in which the scheme of amalgamation was brought into force and other provisions of this Act relating to set off and carry forward of loss and allowance for depreciation shall apply accordingly.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-1-c-001",
                  "target_id": "16",
                  "target_type": "section",
                  "anchor_text": "section 16",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-117-1-001",
              "target_id": "2-6-a",
              "target_type": "clause",
              "anchor_text": "section 2(6)(a) to (c)",
              "relationship": "related_to",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-117-1-002",
              "target_id": "116",
              "target_type": "section",
              "anchor_text": "section 116",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "117-2",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where any scheme of amalgamation as referred to in sub-section (1) is brought into force on or after the 1st April, 2025, any loss forming part of the accumulated loss of the predecessor entity, being—",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "117-2-i",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "the banking company or companies;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "117-2-ii",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "the amalgamating corresponding new bank or banks; or as the case may be, which is deemed to be the loss of the successor entity, being—",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "117-2-iii",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "the amalgamating Government company or companies,",
              "children": []
            }
          ],
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "117-2-a",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "the banking institution or company; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "117-2-c",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "the amalgamated Government company or companies,",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "117-2-b",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "the amalgamated corresponding new bank or banks; or as the case may be, shall be carried forward in the hands of the successor entity for not more than eight tax years immediately succeeding the tax year for which such loss was first computed for original predecessor entity.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-117-2-001",
              "target_id": "117-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "117-3",
          "indent": 0,
          "line_start": 20,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "117-3-a",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
              "page_end": 1,
              "text": "\"accumulated loss\" means so much of the loss of the amalgamating banking company or companies or amalgamating corresponding new bank or banks or amalgamating Government company or companies under the head \"Profits and gains of business or profession\" (excluding losses of a speculation business) which such predecessor entity would have been entitled to carry forward and set off under section 112 had the amalgamation not occurred; (b) \"banking company\" shall have the same meaning as assigned to it in section 5(c) of the Banking Regulation Act, 1949 (10 of 1949);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-3-a-001",
                  "target_id": "112",
                  "target_type": "section",
                  "anchor_text": "section 112",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-117-3-a-002",
                  "target_id": "5-c",
                  "target_type": "clause",
                  "anchor_text": "section 5(c)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "117-3-c",
              "indent": 0,
              "line_start": 23,
              "page_start": 1,
              "page_end": 1,
              "text": "\"banking institution\" shall have the same meaning as assigned to it in section 45(15) of the Banking Regulation Act, 1949 (10 of 1949);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-3-c-001",
                  "target_id": "45-15",
                  "target_type": "subsection",
                  "anchor_text": "section 45(15)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "117-3-d",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text": "\"corresponding new bank\" shall have the same meaning as assigned to it in section 2(d) of the Banking Companies (Acquisition and Transfer of Undertakings) Act, 1970 (5 of 1970), or section 2(b) of the Banking Companies (Acquisition and Transfer of Undertakings) Act, 1980 (40 of 1980);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-3-d-001",
                  "target_id": "2-d",
                  "target_type": "clause",
                  "anchor_text": "section 2(d)",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-117-3-d-002",
                  "target_id": "2-b",
                  "target_type": "clause",
                  "anchor_text": "section 2(b)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "e",
              "id": "117-3-e",
              "indent": 0,
              "line_start": 25,
              "page_start": 1,
              "page_end": 1,
              "text": "\"general insurance business\" shall have the same meaning as assigned to it in section 3(g) of the General Insurance Business (Nationalisation) Act, 1972 (57 of 1972);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-3-e-001",
                  "target_id": "3-g",
                  "target_type": "clause",
                  "anchor_text": "section 3(g)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "f",
              "id": "117-3-f",
              "indent": 0,
              "line_start": 26,
              "page_start": 1,
              "page_end": 1,
              "text": "\"Government company\" means a Government company as defined in section 2(45) of the Companies Act, 2013 (18 of 2013), engaged in the general insurance business and established under section 4 or 5 or 16 of the General Insurance Business (Nationalisation) Act, 1972 (57 of 1972);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-3-f-001",
                  "target_id": "2-45",
                  "target_type": "subsection",
                  "anchor_text": "section 2(45)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-117-3-f-002",
                  "target_id": "4",
                  "target_type": "section",
                  "anchor_text": "section 4 or 5",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "117-3-g",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "\"original predecessor entity\" means predecessor entity in respect of the first amalgamation;",
              "children": []
            },
            {
              "type": "clause",
              "number": "h",
              "id": "117-3-h",
              "indent": 0,
              "line_start": 28,
              "page_start": 1,
              "page_end": 1,
              "text": "\"strategic disinvestment\" shall have the meaning assigned to it in section 116(3)(c)(i);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-117-3-h-001",
                  "target_id": "116-3-c-i",
                  "target_type": "subclause",
                  "anchor_text": "section 116(3)(c)(i)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "i",
              "id": "117-3-i",
              "indent": 0,
              "line_start": 29,
              "page_start": 1,
              "page_end": 1,
              "text": "\"unabsorbed depreciation\" means the allowance for depreciation of the amalgamating banking company or companies or amalgamating corresponding new bank or banks or amalgamating Government company or companies which remains to be allowed and which would have been allowed to such predecessor entity, had the amalgamation not occurred.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
