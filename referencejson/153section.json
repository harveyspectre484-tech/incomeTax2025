  "sections": [
    {
      "type": "section",
      "number": "153",
      "id": "153",
      "title": "Deduction for interest on deposits.",
      "indent": 0,
      "line_start": 8,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "153-1",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An assessee who is—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "153-1-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "an individual, not being a senior citizen; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "153-1-b",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "an individual, being a senior citizen; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "153-1-c",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "a Hindu undivided family, shall be allowed a deduction from the gross total income, subject to conditions specified in sub-section (2), where it includes income by way of interest on deposits with—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "153-1-c-i",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a banking company to which the Banking Regulation Act, 1949 (10 of 1949), applies (including any bank or banking institution referred to in section 51 of that Act); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "153-1-c-ii",
                  "indent": 0,
                  "line_start": 14,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a co-operative society engaged in carrying on the business of banking (including a co-operative land mortgage bank or a co-operative land development bank); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "153-1-c-iii",
                  "indent": 0,
                  "line_start": 15,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a Post Office as defined in section 2(d) of the Post Office Act, 2023 (43 of 2023).",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "153-2",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The deduction under sub-section (1) shall be allowed for a tax year as follows:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "153-2-a",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "in case of an assessee mentioned in sub-section (1)(a) or (c), the whole of the interest up to a maximum amount of Rs. 10000 on deposits in a savings account, excluding time deposits;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-153-2-a-001",
                  "target_id": "153-1-a",
                  "target_type": "clause",
                  "anchor_text": "sub-section (1)(a) or (c)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "153-2-b",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "in case of an assessee mentioned in sub-section (1)(b), the whole of the interest up to a maximum amount of Rs. 50000 on deposits in any account, including time deposits.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-153-2-b-001",
                  "target_id": "153-1-b",
                  "target_type": "clause",
                  "anchor_text": "sub-section (1)(b)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-153-2-001",
              "target_id": "153-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "153-3",
          "indent": 0,
          "line_start": 19,
          "page_start": 1,
          "page_end": 1,
          "text": "Where the income referred to in sub-section (2)(a) is derived from any deposit in a savings account held by, or on behalf of, a firm, an association of persons or a body of individuals, no deduction shall be allowed under this section in respect of such income in computing the total income of any partner of the firm or any member of such association or any individual of such body of individuals.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-153-3-001",
              "target_id": "153-2-a",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(a)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "153-4",
          "indent": 0,
          "line_start": 20,
          "page_start": 1,
          "page_end": 1,
          "text": "Where the income referred to in sub-section (2)(b) is derived from any deposit held by, or on behalf of, a firm, an association of persons or a body of individuals, no deduction shall be allowed under this section in respect of such income in computing the total income of any partner of the firm or any member of such association or any individual of such body of individuals.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-153-4-001",
              "target_id": "153-2-b",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(b)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "153-5",
          "indent": 0,
          "line_start": 21,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this section, the expression \"time deposits\" means the deposits repayable on expiry of fixed periods.",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}