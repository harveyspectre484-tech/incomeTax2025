{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "533",
      "id": "533",
      "title": "Power to make rules.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "533-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "The Board may, subject to the control of the Central Government, by notification, make rules for carrying out the purposes of this Act.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "533-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In particular, and without prejudice to the generality of the foregoing power, such rules may provide for all or any of the following matters:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "533-2-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "the ascertainment and determination of any class of income;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "533-2-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the manner in which and the procedure by which the income shall be arrived at in the case of—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "533-2-b-i",
                  "indent": 0,
                  "line_start": 9,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "income derived in part from agriculture and in part from business;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "533-2-b-ii",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "persons residing outside India;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "533-2-b-iii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "operations carried out in India by a non-resident;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "533-2-b-iv",
                  "indent": 0,
                  "line_start": 12,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "transactions or activities of a non-resident;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "v",
                  "id": "533-2-b-v",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an individual who is liable to be assessed under section 99(3) and (4);",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "533-2-c",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "the determination of the value of any perquisite chargeable to tax under this Act in such manner and on such basis as appears to the Board to be proper and reasonable;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "533-2-d",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "the percentage on the written down value which may be allowed as depreciation for buildings, machinery, plant or furniture;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "533-2-e",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "the matters specified in section 62;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-e-001",
                  "target_id": "62",
                  "target_type": "section",
                  "anchor_text": "section 62",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "f",
              "id": "533-2-f",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "the conditions or limitations subject to which any payment of rent made by an assessee shall be deducted under section 134;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-f-001",
                  "target_id": "134",
                  "target_type": "section",
                  "anchor_text": "section 134",
                  "relationship": "subject_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "533-2-g",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "the matters specified in Chapter XI;",
              "children": []
            },
            {
              "type": "clause",
              "number": "h",
              "id": "533-2-h",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "the time within which any person may apply for the allotment of a Permanent Account Number, the form and the manner in which such application may be made and the particulars which such application shall contain and the transactions with respect to which Permanent Account Number shall be quoted on documents relating to such transactions under section 262;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-h-001",
                  "target_id": "262",
                  "target_type": "section",
                  "anchor_text": "section 262",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "i",
              "id": "533-2-i",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "the documents, statements, receipts, certificates or audited reports which may not be furnished along with the return but shall be produced before the Assessing Officer on demand under section 263(2)(a);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-i-001",
                  "target_id": "263-2-a",
                  "target_type": "clause",
                  "anchor_text": "section 263(2)(a)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "j",
              "id": "533-2-j",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
              "page_end": 1,
              "text": "the class or classes of persons who shall be required to furnish the return of income in electronic form; the form and the manner of furnishing the said return in electronic form; documents, statements, receipts, certificates or reports which shall not be furnished with the return in electronic form and the computer resource or electronic record to which such return may be transmitted under section 263(2)(a);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-j-001",
                  "target_id": "263-2-a",
                  "target_type": "clause",
                  "anchor_text": "section 263(2)(a)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "k",
              "id": "533-2-k",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "the cases, the nature and value of assets, the limits and heads of expenditure and the outgoings, which are required to be prescribed under section 263(2)(b);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-k-001",
                  "target_id": "263-2-b",
                  "target_type": "clause",
                  "anchor_text": "section 263(2)(b)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "l",
              "id": "533-2-l",
              "indent": 0,
              "line_start": 23,
              "page_start": 1,
              "page_end": 1,
              "text": "the form of the report of audit or inventory valuation and the particulars which such report shall contain under section 268(5);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-l-001",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "section 268(5)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "m",
              "id": "533-2-m",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text": "remuneration of Chairperson and members of the Approving Panel under section 274(21) and procedure and manner for constitution of, functioning and disposal of references by, the Approving Panel under section 274(24);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-m-001",
                  "target_id": "274-21",
                  "target_type": "subsection",
                  "anchor_text": "section 274(21) and procedure",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-533-2-m-002",
                  "target_id": "274-24",
                  "target_type": "subsection",
                  "anchor_text": "section 274(24)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "n",
              "id": "533-2-n",
              "indent": 0,
              "line_start": 25,
              "page_start": 1,
              "page_end": 1,
              "text": "the form and manner in which the information relating to payment of any sum may be furnished under section 397(3)(d);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-n-001",
                  "target_id": "397-3-d",
                  "target_type": "clause",
                  "anchor_text": "section 397(3)(d)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "o",
              "id": "533-2-o",
              "indent": 0,
              "line_start": 26,
              "page_start": 1,
              "page_end": 1,
              "text": "the authority to be prescribed for any of the purposes of this Act;",
              "children": []
            },
            {
              "type": "clause",
              "number": "p",
              "id": "533-2-p",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "the procedure for giving effect to any agreement for the granting of relief in respect of double taxation or for the avoidance of double taxation entered into by the Central Government under this Act;",
              "children": []
            },
            {
              "type": "clause",
              "number": "q",
              "id": "533-2-q",
              "indent": 0,
              "line_start": 28,
              "page_start": 1,
              "page_end": 1,
              "text": "the procedure for granting of relief or deduction, of any income-tax paid in any country or specified territory outside India, under section 159 or 160, against the income-tax payable under this Act;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-q-001",
                  "target_id": "159",
                  "target_type": "section",
                  "anchor_text": "section 159 or 160",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "r",
              "id": "533-2-r",
              "indent": 0,
              "line_start": 29,
              "page_start": 1,
              "page_end": 1,
              "text": "the form and manner in which any application, claim, return or information may be made or furnished and the fees that may be levied in respect of any application or claim; (s) the manner in which any document required to be filed under this Act may be verified;",
              "children": []
            },
            {
              "type": "clause",
              "number": "t",
              "id": "533-2-t",
              "indent": 0,
              "line_start": 31,
              "page_start": 1,
              "page_end": 1,
              "text": "the procedure to be followed on applications for refunds;",
              "children": []
            },
            {
              "type": "clause",
              "number": "u",
              "id": "533-2-u",
              "indent": 0,
              "line_start": 32,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the procedure for calculating interest payable by assessees or by the Government to assessees under this Act, including the rounding off of periods when a fraction of a month is involved, and specifying the circumstances under which and the extent to which petty amounts of interest payable by assessees may be ignored;",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "v",
                  "id": "533-2-u-v",
                  "indent": 0,
                  "line_start": 33,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the regulation of any matter for which provision is made in section 420;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "w",
              "id": "533-2-w",
              "indent": 0,
              "line_start": 34,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the form and manner in which any appeal or cross-objection may be filed under this Act, the fee payable in respect thereof and the manner in which intimation referred to in section 358(3)(b) may be served;",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "x",
                  "id": "533-2-w-x",
                  "indent": 0,
                  "line_start": 35,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the circumstances, conditions and the manner in which, the Joint Commissioner (Appeals) or the Commissioner (Appeals) may permit an appellant to produce evidence which he did not produce or which he was not allowed to produce before the Assessing Officer;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "y",
              "id": "533-2-y",
              "indent": 0,
              "line_start": 36,
              "page_start": 1,
              "page_end": 1,
              "text": "the form in which the statement under section 507 shall be delivered to the Assessing Officer;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-y-001",
                  "target_id": "507",
                  "target_type": "section",
                  "anchor_text": "section 507",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "z",
              "id": "533-2-z",
              "indent": 0,
              "line_start": 37,
              "page_start": 1,
              "page_end": 1,
              "text": "the maintenance of a register of persons other than legal practitioners or accountants practising before income-tax authorities and for the constitution of and the procedure to be followed by the authority referred to in section 515(5);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-533-2-z-001",
                  "target_id": "515-5",
                  "target_type": "subsection",
                  "anchor_text": "section 515(5)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "za",
              "id": "533-2-za",
              "indent": 0,
              "line_start": 38,
              "page_start": 1,
              "page_end": 1,
              "text": "the issue of certificate verifying the payment of tax by assessees;",
              "children": []
            },
            {
              "type": "clause",
              "number": "zb",
              "id": "533-2-zb",
              "indent": 0,
              "line_start": 39,
              "page_start": 1,
              "page_end": 1,
              "text": "any other matter which by this Act is to be, or may be, prescribed.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "533-3",
          "indent": 0,
          "line_start": 40,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In cases falling under sub-section (2)(b), where the income liable to tax cannot be definitely ascertained, or can be ascertained only with an amount of trouble and expense to the assessee, which is unreasonable, the rules made under this section may—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "533-3-a",
              "indent": 0,
              "line_start": 41,
              "page_start": 1,
              "page_end": 1,
              "text": "prescribe methods by which an estimate of such income may be made; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "533-3-b",
              "indent": 0,
              "line_start": 42,
              "page_start": 1,
              "page_end": 1,
              "text": "in cases of income derived in part from agriculture and in part from business, specify the proportion of the income which shall be deemed to be income liable to tax, and an assessment based on such estimate or proportion shall be deemed to be duly made as per this Act.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-533-3-001",
              "target_id": "533-2-b",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(b)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "533-4",
          "indent": 0,
          "line_start": 44,
          "page_start": 1,
          "page_end": 1,
          "text": "The power to make rules conferred by this section shall include the power to give retrospective effect, from a date not earlier than the date of commencement of this Act, to the rules or any of them and, unless the contrary is permitted (whether expressly or by necessary implication), no retrospective effect shall be given to any rule so as to prejudicially affect the interests of assessees.",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
