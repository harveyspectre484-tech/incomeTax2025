              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "271-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to comply with all the terms of a notice issued under section 268(1)or fails to comply with a direction issued under section 268(5); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-271-1-b-001",
                  "target_id": "268-1",
                  "target_type": "subsection",
                  "anchor_text": "section 268(1)or fails",
                  "relationship": "depends_on",
