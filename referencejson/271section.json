          "page_end": 1,
          "text_before_clauses": "If any person—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "271-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to furnish the return required under section 263(1) or (4) or (5) or (6); or",
              "children": [],
