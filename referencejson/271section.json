                  "anchor_text": "section 270(8)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "271-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer before making an assessment under sub-section (1) shall, subject to the provisions of sub-section (3), serve a notice on the assessee to show cause, on a date and time to be specified in the notice, as to why assessment should not be completed to the best of his judgment.",
