          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "277-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, any tax, duty, cess or fee (by whatever name called) under any law in force, shall include all such payment irrespective of any right arising as a consequence to such payment.",
          "clauses": [],
          "text_after_clauses": ""
        },
