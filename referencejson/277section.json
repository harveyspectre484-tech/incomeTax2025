          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-sections (1) and (2), the comparison of actual cost and net realisable value of securities shall be made category-wise.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
