          "number": "b",
          "id": "164-b",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "any transfer of goods or services referred to in section 140(9);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-164-b-001",
              "target_id": "140-9",
              "target_type": "subsection",
              "anchor_text": "section 140(9)",
