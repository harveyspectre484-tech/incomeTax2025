      "title": "Meaning of specified domestic transaction.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "For the purposes of this Chapter, the expression \"specified domestic transaction\" in case of an assessee means any of the following transactions (not being an international transaction),—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "164-a",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "any transaction referred to in section 122;",
          "children": [],
          "references": [
            {
              "reference_id": "ref-164-a-001",
              "target_id": "122",
              "target_type": "section",
              "anchor_text": "section 122",
