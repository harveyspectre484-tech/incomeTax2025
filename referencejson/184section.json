{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "184",
      "id": "184",
      "title": "Interpretation.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "For the purposes of this Chapter, unless the context otherwise requires,—",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "184-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"accommodating party\" means a party to an arrangement, if the main purpose of the direct or indirect participation of that party in the arrangement, in whole or in part, is to obtain, directly or indirectly, a tax benefit (but for the provisions of this Chapter) for the assessee whether or not the party is a connected person in relation to any party to the arrangement;",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "184-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"arrangement\" means any step in, or a part or whole of, any transaction, operation, scheme, agreement or understanding, whether enforceable or not, and includes the alienation of any property in such transaction, operation, scheme, agreement or understanding;",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "184-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"asset\" includes property, or right, of any kind;",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "184-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"benefit\" includes a payment of any kind whether in tangible or intangible form;",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "184-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"connected person\" means any person who is connected directly or indirectly to another person and includes,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "184-5-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any relative of the person, if such person is an individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "184-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any director of the company or any relative of such director, if the person is a company;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "184-5-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any partner or member of a firm or association of persons or body of individuals or any relative of such partner or member, if the person is a firm or association of persons or body of individuals;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "184-5-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any member of the Hindu undivided family or any relative of such member, if the person is a Hindu undivided family;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "184-5-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any individual who has a substantial interest in the business of the person or any relative of such individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "184-5-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a company, firm or an association of persons or a body of individuals, whether incorporated or not, or a Hindu undivided family having a substantial interest in the business of the person or any director, partner, or member of the company, firm or association of persons or body of individuals or family, or any relative of such director, partner or member;",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "184-5-g",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a company, firm or association of persons or body of individuals, whether incorporated or not, or a Hindu undivided family, whose director, partner, or member has a substantial interest in the business of the person, or family or any relative of such director, partner or member;",
              "children": []
            },
            {
              "type": "clause",
              "number": "h",
              "id": "184-5-h",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any other person who carries on a business, if—",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "184-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"fund\" includes—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "184-6-a",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any cash;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "184-6-b",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "cash equivalents; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "184-6-c",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any right, or obligation, to receive or pay, the cash or cash equivalent;",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "184-7",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"party\" includes a person or a permanent establishment which participates or takes part in an arrangement;",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "184-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"relative\" shall have the meaning assigned to it in section 92(5)(g);",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-184-8-001",
              "target_id": "92-5-g",
              "target_type": "clause",
              "anchor_text": "section 92(5)(g)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "184-9",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "a person shall be deemed to have a substantial interest in the business, if,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "184-9-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in a case where the business is carried on by a company, such person is, at any time during the financial year, the beneficial owner of equity shares carrying at least 20% of the voting power; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "184-9-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in any other case, such person is, at any time during the financial year, beneficially entitled to at least 20% of the profits of such business;",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "184-10",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"step\" includes a measure or an action, particularly one of a series taken in order to deal with or achieve a particular thing or object in the arrangement;",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "184-11",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"tax benefit\" includes,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "184-11-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a reduction or avoidance or deferral of tax or other amount payable under this Act; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "184-11-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "an increase in a refund of tax or other amount under this Act; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "184-11-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a reduction or avoidance or deferral of tax or other amount that would be payable under this Act, as a result of a tax treaty; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "184-11-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "an increase in a refund of tax or other amount under this Act as a result of a tax treaty; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "184-11-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a reduction in total income; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "184-11-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "an increase in loss, in the relevant tax year or any other tax year;",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "12",
          "id": "184-12",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"tax treaty\" means an agreement referred to in section 159(1) or (2).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-184-12-001",
              "target_id": "159-1",
              "target_type": "subsection",
              "anchor_text": "section 159(1) or (2)",
              "relationship": "definition_reference",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}