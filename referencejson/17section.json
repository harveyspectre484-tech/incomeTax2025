{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "17",
      "id": "17",
      "title": "Perquisite.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "17-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this Part, \"perquisite\" includes—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "17-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of rent-free accommodation provided to the assessee by his employer computed in such manner as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "17-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of any accommodation, computed in such manner as may be prescribed, provided to the assessee by his employer at a concessional rate which is in excess of rent recoverable from or payable by the assessee;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "17-1-c",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the value of any benefit or amenity granted or provided free of cost or at concessional rate in the following cases:—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-1-c-i",
                  "indent": 0,
                  "line_start": 9,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "by a company to an employee, who is a director thereof or who has a substantial interest in the company;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-1-c-ii",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "by any employer (including a company) to an employee [other than employee referred in sub-clause (i)] whose income under the head \"Salaries\" by way of monetary payment (from one or more employers) exceeds such amount as may be prescribed;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "d",
              "id": "17-1-d",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of any specified security or sweat equity shares allotted or transferred, directly or indirectly, by the current employer, or former employer, free of cost or at concessional rate to the assessee;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "17-1-e",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of any other benefit or amenity, as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "17-1-f",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "any sum paid by the employer in respect of any obligation which, but for such payment, would have been payable by the assessee;",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "17-1-g",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any sum payable by the employer to effect an assurance on the life of the assessee or to effect a contract for an annuity, whether directly or through a fund, other than—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-1-g-i",
                  "indent": 0,
                  "line_start": 15,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a recognised provident fund; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-1-g-ii",
                  "indent": 0,
                  "line_start": 16,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an approved superannuation fund; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "17-1-g-iii",
                  "indent": 0,
                  "line_start": 17,
                  "page_start": 1,
                  "page_end": 1,
                  "text_before_items": "a Deposit-linked Insurance Fund established under—",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "17-1-g-iii-A",
                      "indent": 0,
                      "line_start": 18,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "section 3G of the Coal Mines Provident Fund and Miscellaneous Provisions Act, 1948 (46 of 1948); or",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "B",
                      "id": "17-1-g-iii-B",
                      "indent": 0,
                      "line_start": 19,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "section 6C of the Employees' Provident Funds and Miscellaneous Provisions Act, 1952 (19 of 1952);",
                      "children": []
                    }
                  ],
                  "text_after_items": ""
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "h",
              "id": "17-1-h",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "aggregate amount of any contribution, in excess of Rs. 750000 in a tax year, made to the account of the assessee by the employer—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-1-h-i",
                  "indent": 0,
                  "line_start": 21,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in a recognised provident fund;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-1-h-ii",
                  "indent": 0,
                  "line_start": 22,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in the scheme referred to in section 124(1); and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "17-1-h-iii",
                  "indent": 0,
                  "line_start": 23,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in an approved superannuation fund;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "i",
              "id": "17-1-i",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text": "the annual accretion by way of interest, dividend or any other amount of similar nature during the tax year to the balance at the credit of the fund or scheme referred to in clause (h), computed in such manner, as may be prescribed (to the extent it relates to the contribution referred to in the said clause in any tax year).",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "17-2",
          "indent": 0,
          "line_start": 25,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Nothing in sub-section (1) shall apply to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "17-2-a",
              "indent": 0,
              "line_start": 26,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of any medical treatment provided to an employee or any member of his family in any hospital maintained by the employer;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "17-2-b",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any sum paid by the employer in respect of any expenditure actually incurred by the employee on his medical treatment or treatment of any member of his family—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-2-b-i",
                  "indent": 0,
                  "line_start": 28,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in any hospital maintained by the Government, or any local authority, or any other hospital approved by the Government for the purposes of medical treatment of its employees;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-2-b-ii",
                  "indent": 0,
                  "line_start": 29,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in respect of the prescribed diseases or ailments, in any hospital approved by the Principal Chief Commissioner or Chief Commissioner having regard to such guidelines as may be issued in this behalf;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "17-2-c",
              "indent": 0,
              "line_start": 31,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any portion of the premium paid by an employer in relation to an employee, to effect or to keep in force an insurance on the health of such employee under any scheme approved, for the purposes of section 30(c), by the—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-2-c-i",
                  "indent": 0,
                  "line_start": 30,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Central Government; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-2-c-ii",
                  "indent": 0,
                  "line_start": 32,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Insurance Regulatory and Development Authority established under section 3(1) of the Insurance Regulatory and Development Authority Act, 1999 (41 of 1999);",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "d",
              "id": "17-2-d",
              "indent": 0,
              "line_start": 33,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any sum paid by the employer in respect of any premium paid by the employee to effect or to keep in force an insurance on his health or the health of any member of his family under any scheme, approved for the purposes of section 126, by the—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-2-d-i",
                  "indent": 0,
                  "line_start": 34,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Central Government; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-2-d-ii",
                  "indent": 0,
                  "line_start": 35,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Insurance Regulatory and Development Authority established under section 3(1) of the Insurance Regulatory and Development Authority Act, 1999 (41 of 1999);",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "e",
              "id": "17-2-e",
              "indent": 0,
              "line_start": 36,
              "page_start": 1,
              "page_end": 1,
              "text": "any expenditure incurred by the employer for the use of any vehicle for journey by the assessee from his residence to his office or other place of work, or from such office or place to his residence;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "17-2-f",
              "indent": 0,
              "line_start": 37,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any expenditure incurred by the employer, or any sum paid by the employer in respect of any expenditure actually incurred by the employee, on—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "17-2-f-i",
                  "indent": 0,
                  "line_start": 38,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "medical treatment of the employee or any family member of such employee outside India;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "17-2-f-ii",
                  "indent": 0,
                  "line_start": 39,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "travel and stay abroad for the employee or any member of the family of such employee for medical treatment;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "17-2-f-iii",
                  "indent": 0,
                  "line_start": 40,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "travel and stay abroad of one attendant who accompanies the patient in connection with such treatment.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-17-2-001",
              "target_id": "17-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "17-3",
          "indent": 0,
          "line_start": 41,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (2)(f),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "17-3-a",
              "indent": 0,
              "line_start": 42,
              "page_start": 1,
              "page_end": 1,
              "text": "the expenditure on medical treatment and stay abroad shall be excluded from the perquisite only to the extent permitted by the Reserve Bank of India; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "17-3-b",
              "indent": 0,
              "line_start": 43,
              "page_start": 1,
              "page_end": 1,
              "text": "the expenditure on travel shall be excluded from perquisite only in the case of an employee whose gross total income, as computed before including therein the said expenditure, does not exceed such amount as may be prescribed.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-17-3-001",
              "target_id": "17-2-f",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(f)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "17-4",
          "indent": 0,
          "line_start": 44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "17-4-a",
              "indent": 0,
              "line_start": 45,
              "page_start": 1,
              "page_end": 1,
              "text": "\"fair market value\" means the value determined in accordance with the method, as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "17-4-b",
              "indent": 0,
              "line_start": 46,
              "page_start": 1,
              "page_end": 1,
              "text": "\"family\", in relation to an individual, shall have the meaning assigned to it in Schedule III (Note 2);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-17-4-b-001",
                  "target_id": "schedule-III",
                  "target_type": "schedule",
                  "anchor_text": "Schedule III",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "17-4-c",
              "indent": 0,
              "line_start": 47,
              "page_start": 1,
              "page_end": 1,
              "text": "\"gross total income\" shall have the meaning assigned to it in section 122(10);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-17-4-c-001",
                  "target_id": "122-10",
                  "target_type": "subsection",
                  "anchor_text": "section 122(10)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "17-4-d",
              "indent": 0,
              "line_start": 48,
              "page_start": 1,
              "page_end": 1,
              "text": "\"hospital\" includes a dispensary or a clinic or a nursing home;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "17-4-e",
              "indent": 0,
              "line_start": 49,
              "page_start": 1,
              "page_end": 1,
              "text": "\"option\" means a right but not an obligation, granted to an employee to apply for the specified security or sweat equity shares at a predetermined price;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "17-4-f",
              "indent": 0,
              "line_start": 50,
              "page_start": 1,
              "page_end": 1,
              "text": "\"specified security\" means the securities as defined in section 2(h) of the Securities Contracts (Regulation) Act, 1956 (42 of 1956) and, where employees' stock option has been granted under any plan or scheme therefor, includes the securities offered under such plan or scheme;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-17-4-f-001",
                  "target_id": "2-h",
                  "target_type": "clause",
                  "anchor_text": "section 2(h)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "17-4-g",
              "indent": 0,
              "line_start": 51,
              "page_start": 1,
              "page_end": 1,
              "text": "\"sweat equity shares\" means equity shares issued by a company to its employees or directors at a discount or for consideration other than cash for providing know-how or making available rights in the nature of intellectual property rights or value additions, by whatever name called;",
              "children": []
            },
            {
              "type": "clause",
              "number": "h",
              "id": "17-4-h",
              "indent": 0,
              "line_start": 52,
              "page_start": 1,
              "page_end": 1,
              "text": "the value of any specified security or sweat equity shares shall be the fair market value of the specified security or sweat equity shares, on the date on which the option is exercised by the assessee, as reduced by the amount actually paid by, or recovered from, the assessee in respect of such security or shares.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "text_after_sections": ""
}