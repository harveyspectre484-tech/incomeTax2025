{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "403",
      "id": "403",
      "title": "Liability for payment of advance tax.",
      "indent": 0,
      "line_start": 8,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "403-1",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "Advance tax shall be payable during any financial year in respect of the current income of the assessee, as per the provisions of this Part.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "403-2",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this Part, \"current income\" of a tax year means the total income of the assessee which would be chargeable to tax for such tax year.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "403-3",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The provisions of sub-section (1) shall not apply to an individual resident in India, who—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "403-3-a",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "does not have any income chargeable under the head \"Profits and gains of business or profession\"; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "403-3-b",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "is of the age of sixty years or more at any time during the tax year.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-403-3-001",
              "target_id": "403-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "exception_to",
              "confidence": "high"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
