            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "468-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "If a person, required to quote his Tax Deduction and Collection Account Number in challans, certificates, statements or other documents referred to in section 397(1)(b), quotes a number which is false, knowing or believing it to be false or not true, the Assessing Officer may impose a penalty of Rs. 10000 on him.",
