          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "If a person fails to comply with the provisions of section 397, the Assessing Officer may impose a penalty of Rs. 10000 on him.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-468-1-001",
              "target_id": "397",
              "target_type": "section",
              "anchor_text": "section 397",
