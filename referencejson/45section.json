{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "45",
      "id": "45",
      "title": "Expenditure on scientific research.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "45-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "45-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "A deduction shall be allowed for any expenditure, being in the nature of—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "45-1-a-i",
                  "indent": 0,
                  "line_start": 7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "capital expenditure, but not on acquisition of land which is acquired as such or as part of any property; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "45-1-a-ii",
                  "indent": 0,
                  "line_start": 8,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "revenue expenditure, incurred on scientific research related to the business of the assessee subject to provisions of this section.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "45-1-b",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "A deduction shall also be allowed under this sub-section in respect of the aggregate of expenditure (not being in the nature of capital expenditure), related to business, incurred on—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "45-1-b-i",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "salary to an employee engaged in such scientific research; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "45-1-b-ii",
                  "indent": 0,
                  "line_start": 12,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "purchase of materials used in such scientific research, where such expenditure is incurred within three years immediately preceding the commencement of business, to the extent certified by the prescribed authority as incurred on such research and such expenditure shall be deemed to have been incurred in the tax year in which the business is commenced.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "45-1-c",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "For the purposes of this sub-section, the aggregate of capital expenditure incurred within three years immediately preceding the commencement of business shall be deemed to have been incurred in the tax year in which the business is commenced.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "45-2",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "45-2-i",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text_before_items": "A deduction shall be allowed in respect of any expenditure on scientific research incurred (not being expenditure in the nature of cost of any land or building) by a company engaged in the business of—",
              "items": [
                {
                  "type": "item",
                  "number": "A",
                  "id": "45-2-i-A",
                  "indent": 0,
                  "line_start": 16,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "bio-technology; or",
                  "children": []
                },
                {
                  "type": "item",
                  "number": "B",
                  "id": "45-2-i-B",
                  "indent": 0,
                  "line_start": 17,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "manufacture or production of any article or thing, which is not specified in Schedule XIII, on in-house research and development facility as approved by the prescribed authority, subject to the conditions and manner, as may be prescribed.",
                  "children": []
                }
              ],
              "text_after_items": ""
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "45-2-ii",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "No deduction shall be allowed under this sub-section to a company approved under sub-section (3)(b)(ii).",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "45-2-iii",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "No deduction shall be allowed in respect of the expenditure mentioned in clause (i) under any other provision of this Act.",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "45-2-iv",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
              "page_end": 1,
              "text": "The expenditure under clause (i) shall be allowed subject to such conditions and on furnishing of documents in such form and manner, as may be prescribed.",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "v",
              "id": "45-2-v",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "For the purposes of this sub-section, \"expenditure on scientific research\", in relation to drugs and pharmaceuticals, shall include expenditure incurred on clinical drug trial, obtaining approval from any regulatory authority under any Central Act or State Act or Provincial Act and filing an application for a patent under the Patents Act, 1970 (39 of 1970).",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "45-3",
          "indent": 0,
          "line_start": 23,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "A deduction shall be allowed for any sum, paid to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "45-3-a",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "45-3-a-i",
                  "indent": 0,
                  "line_start": 24,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a research association having the object of undertaking scientific research or to a University, college or institution to be used for scientific research; or",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "45-3-b",
              "indent": 0,
              "line_start": 25,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "a company which is—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "45-3-b-ii",
                  "indent": 0,
                  "line_start": 26,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a research association having the object of undertaking research in social science or statistical research or to a University, college or institution to be used for research in social science or statistical research;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "45-3-b-i",
                  "indent": 0,
                  "line_start": 27,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "registered in India having the main object of scientific research and development; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "45-3-b-ii",
                  "indent": 0,
                  "line_start": 28,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "approved by such authority, for the purposes of this clause in such manner and subject to such conditions, as may be prescribed;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "45-3-c",
              "indent": 0,
              "line_start": 29,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "45-3-c-i",
                  "indent": 0,
                  "line_start": 29,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a national laboratory; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "45-3-c-ii",
                  "indent": 0,
                  "line_start": 30,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a University; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "45-3-c-iii",
                  "indent": 0,
                  "line_start": 31,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an Indian Institute of Technology; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "45-3-c-iv",
                  "indent": 0,
                  "line_start": 32,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a specified person, with a specific direction that the said sum shall be used for scientific research undertaken under a programme approved in this behalf by the prescribed authority.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "45-4",
          "indent": 0,
          "line_start": 34,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (3),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "45-4-a",
              "indent": 0,
              "line_start": 35,
              "page_start": 1,
              "page_end": 1,
              "text": "the expenditure shall be allowed subject to such conditions and on furnishing of documents in such form and manner, as may be prescribed; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "45-4-b",
              "indent": 0,
              "line_start": 36,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of clause (a) of the said sub-section, only such association, University, college or other institution shall be eligible for deduction, which for the time being is approved in the manner and subject to such conditions, as may be prescribed, and is specified by the Central Government, by notification.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-45-4-b-001",
                  "target_id": "45-4-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-45-4-001",
              "target_id": "45-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "45-5",
          "indent": 0,
          "line_start": 37,
          "page_start": 1,
          "page_end": 1,
          "text": "The deduction for any sum under sub-section (3) shall not be denied merely on the ground that subsequent to the payment of such sum by the assessee, the approval granted to such entities or the programme undertaken by entities as mentioned in sub-section (3)(c), has been withdrawn.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-45-5-001",
              "target_id": "45-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-45-5-002",
              "target_id": "45-3-c",
              "target_type": "clause",
              "anchor_text": "sub-section (3)(c)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "45-6",
          "indent": 0,
          "line_start": 38,
          "page_start": 1,
          "page_end": 1,
          "text": "Where a deduction is allowed for any tax year under this section in respect of expenditure, represented wholly or partly by an asset, no deduction shall be allowed under section 33(3) for the same or any other tax year in respect of that asset.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-45-6-001",
              "target_id": "33-3",
              "target_type": "subsection",
              "anchor_text": "section 33(3)",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "45-7",
          "indent": 0,
          "line_start": 39,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of section 33(11) in respect of depreciation shall apply in relation to deductions allowable for capital expenditure under sub-section (1).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-45-7-001",
              "target_id": "45-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-45-7-002",
              "target_id": "33-11",
              "target_type": "subsection",
              "anchor_text": "section 33(11)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "45-8",
          "indent": 0,
          "line_start": 40,
          "page_start": 1,
          "page_end": 1,
          "text": "No deduction in respect of the sum mentioned in sub-section (3)(c) shall be allowed under any other provision of this Act.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-45-8-001",
              "target_id": "45-3-c",
              "target_type": "clause",
              "anchor_text": "sub-section (3)(c)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "45-9",
          "indent": 0,
          "line_start": 41,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If any question arises under this section as to whether, and if so, to what extent any activity constitutes or constituted scientific research, or any asset is or was being used, for scientific research, the Board shall refer the question to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "45-9-a",
              "indent": 0,
              "line_start": 42,
              "page_start": 1,
              "page_end": 1,
              "text": "the Central Government, when such question relates to any activity under sub-section (3)(a), and its decision shall be final;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-45-9-a-001",
                  "target_id": "45-3-a",
                  "target_type": "clause",
                  "anchor_text": "sub-section (3)(a)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "45-9-b",
              "indent": 0,
              "line_start": 43,
              "page_start": 1,
              "page_end": 1,
              "text": "the prescribed authority, when such question relates to any other activity other than the activity specified in clause (a), whose decision shall be final.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-45-9-b-001",
                  "target_id": "45-9-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "45-10",
          "indent": 0,
          "line_start": 44,
          "page_start": 1,
          "page_end": 1,
          "text": "When an amalgamating company, in a scheme of amalgamation, sells or otherwise transfers to the amalgamated company (being an Indian company) any asset representing capital expenditure on scientific research, the provisions of this section shall apply to the amalgamated company as they would have applied to the amalgamating company if the latter had not so sold or otherwise transferred the asset.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "45-11",
          "indent": 0,
          "line_start": 45,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "45-11-a",
              "indent": 0,
              "line_start": 46,
              "page_start": 1,
              "page_end": 1,
              "text": "\"National Laboratory\" means a scientific laboratory functioning at the national level under the aegis of the Indian Council of Agricultural Research, the Indian Council of Medical Research, the Council of Scientific and Industrial Research, the Defence Research and Development Organisation, the Department of Electronics, the Department of Bio-Technology or the Department of Atomic Energy and which is approved as a National Laboratory by such authority and in such manner, as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "45-11-b",
              "indent": 0,
              "line_start": 47,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"salary\" has the meaning assigned to it in section 16 read with section 18 subject to the following modifications:",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "45-11-b-i",
                  "indent": 0,
                  "line_start": 48,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in section 16, clauses (e) and (j) shall be omitted;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "45-11-b-ii",
                  "indent": 0,
                  "line_start": 49,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in section 18, the references to \"assessee\" shall be construed as references to \"employee of former employee\" and the reference to \"his employer or former employer\" and \"an employer or a former employer\" shall be construed as reference to \"the assessee\";",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "45-11-c",
              "indent": 0,
              "line_start": 50,
              "page_start": 1,
              "page_end": 1,
              "text": "\"specified person\" means such person approved by the prescribed authority; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "45-11-d",
              "indent": 0,
              "line_start": 51,
              "page_start": 1,
              "page_end": 1,
              "text": "\"land\", for the purpose of sub-section (1)(a)(i), includes any interest in land.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-45-11-d-001",
                  "target_id": "45-1-a",
                  "target_type": "clause",
                  "anchor_text": "sub-section (1)(a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
