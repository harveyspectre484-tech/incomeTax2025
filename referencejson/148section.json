      "id": "148",
      "title": "Deduction in respect of certain inter-corporate dividends.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "148-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the gross total income of a domestic company in any tax year includes any income by way of dividends from—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "148-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any other domestic company; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "148-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a foreign company; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "148-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a business trust, such domestic company shall be allowed a deduction of an amount equal to so much of the income by way of dividends received from the person mentioned in clause (a) or (b) or (c) as does not exceed the amount of dividend distributed by it at least one month before the due date for filing the return of income under section 263(1).",
              "children": [],
