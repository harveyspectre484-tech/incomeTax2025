  "sections": [
    {
      "type": "section",
      "number": "459",
      "id": "459",
      "title": "Penalty for failure to furnish report or for furnishing inaccurate report under section 511.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "459-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If any reporting entity referred to in section 511, required to furnish the report referred to in sub-section (2) of the said section, for a reporting accounting year, fails to do so, the prescribed authority under that section may impose on such entity, a penalty of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "459-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Rs. 5000 for every day for which the failure continues, if the period of failure does not exceed one month;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "459-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Rs. 15000 for every day for which the failure continues beyond the period of one month.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-459-1-001",
              "target_id": "459-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-459-1-002",
              "target_id": "511",
              "target_type": "section",
              "anchor_text": "section 511",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "459-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If any reporting entity referred to in section 511 fails to produce the information and documents within the period allowed under sub-section (7) of the said section, the prescribed authority under that section may impose on such entity, a penalty of Rs. 5000 for every day during which the failure continues, beginning from the day immediately following the day on which the period for furnishing the information and document expires.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-459-2-001",
              "target_id": "459-7",
              "target_type": "subsection",
              "anchor_text": "sub-section (7)",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-459-2-002",
              "target_id": "511",
              "target_type": "section",
              "anchor_text": "section 511",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "459-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the failure referred to in sub-section (1) or (2) continues after an order imposing a penalty under the said sub-section, has been served on the entity, then, irrespective of the provisions of the said sub-sections, the prescribed authority may impose penalty of fifty thousand rupees for every day for which such failure continues beginning from the date of service of such order.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-459-3-001",
              "target_id": "459-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or (2)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "459-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If a reporting entity referred to in section 511 provides inaccurate information in the report furnished under sub-section (2) of the said section, the prescribed authority under that section may impose on such entity, a penalty of Rs. 500000, if—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "459-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the entity has knowledge of the inaccuracy at the time of furnishing the report but fails to inform the prescribed authority; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "459-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the entity discovers the inaccuracy after the report is furnished and fails to inform the prescribed authority and furnish correct report within fifteen days of such discovery; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "459-4-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the entity furnishes inaccurate information or document in response to the notice issued under section 511(7).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-459-4-c-001",
                  "target_id": "511-7",
                  "target_type": "subsection",
