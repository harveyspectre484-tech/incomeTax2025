{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "128",
      "id": "128",
      "title": "Ministry of Finance, Government of India",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "128-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An assessee who is resident in India, shall be allowed a deduction of the amount actually paid during the tax year or a sum of Rs. 40000, whichever is less, from income chargeable to tax of that tax year, for the medical treatment of such disease or ailment as may be prescribed—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "128-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "for himself or a dependant, in case the assessee is an individual; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "128-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "for any member of a Hindu undivided family, in case the assessee is a Hindu undivided family.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "128-2",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "A deduction shall be allowed under this section only if the assessee obtains the prescription for the medical treatment from a neurologist, oncologist, urologist, haematologist, immunologist, or any other specialist, as may be prescribed.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "128-3",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text": "The deduction under this section shall be reduced by any amount received under an insurance from an insurer, or reimbursed by an employer, for the medical treatment of the person as referred to in sub-section (1)(a) or (b).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-128-3-001",
              "target_id": "128-1-a",
              "target_type": "clause",
              "anchor_text": "sub-section (1)(a) or (b)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "128-4",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text": "If the amount actually paid is in respect of the assessee or his dependant or any member of a Hindu undivided family of the assessee and who is senior citizen, the amount of deduction as referred to in sub-section (1) shall be substituted with \"Rs. 100000\" for \"Rs. 40000\".",
          "children": [],
          "references": [
            {
              "reference_id": "ref-128-4-001",
              "target_id": "128-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "128-5",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "128-5-a",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "\"dependant\" shall have the meaning as assigned to it in section 127(9);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-128-5-a-001",
                  "target_id": "127-9",
                  "target_type": "subsection",
                  "anchor_text": "section 127(9)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "128-5-b",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "\"insurer\" shall have the meaning assigned to it in section 2(9) of the Insurance Act, 1938 (4 of 1938).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-128-5-b-001",
                  "target_id": "2-9",
                  "target_type": "subsection",
                  "anchor_text": "section 2(9)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
