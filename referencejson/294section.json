      "type": "section",
      "number": "294",
      "id": "294",
      "title": "Procedure for block assessment.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "294-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where any search has been initiated or requisition is made in the case of any person, then,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "294-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the Assessing Officer shall, in respect of such search or requisition, issue a notice to such person, requiring him to furnish within a period specified in the notice, not exceeding sixty days, a return in the form and verified in the manner, as may be prescribed, setting forth his undisclosed income, for the block period, and—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "294-1-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such return shall be considered as if it was a return furnished under section 263 and thereafter notice under section 270(8) shall be issued;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "294-1-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any return furnished beyond the period allowed in the notice shall not be deemed to be a return under section 263;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "294-1-a-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "no notice under section 280 is required to be issued for the purpose of proceeding under this part;"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "294-1-a-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a person who has furnished a return under this clause shall not be entitled to furnish a revised return;"
                },
                {
                  "type": "sub-clause",
                  "number": "v",
                  "id": "294-1-a-v",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the time allowed for furnishing a return under this clause may be extended by a further period of thirty days, where—"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "294-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The provisions of section 270(1) shall not apply to the return furnished under this section.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-294-2-001",
              "target_id": "270-1",
              "target_type": "subsection",
              "anchor_text": "section 270(1)",
              "relationship": "exception_to",
