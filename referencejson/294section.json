            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "294-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer, before issuance of notice under sub-section (1)(a), shall take prior approval of the Additional Commissioner or the Additional Director or the Joint Commissioner or the Joint Director.",
          "clauses": [],
