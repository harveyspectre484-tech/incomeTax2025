{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "154",
      "id": "154",
      "title": "Deduction in case of a person with disability.",
      "indent": 0,
      "line_start": 7,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "154-1",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "An individual, being resident in India, who is certified by a medical authority, at any time during the tax year, as a person with disability or person with severe disability, shall be allowed a deduction of Rs. 75000 or Rs. 125000, respectively, while computing his total income.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "154-2",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The deduction under sub-section (1) shall be allowed only if all of the following conditions are fulfilled:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "154-2-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "the individual furnishes a copy of the certificate issued by the medical authority;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "154-2-b",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "if the certificate specifies that the disability needs reassessment of its extent after a period stipulated in it, the deduction shall not be allowed for any tax year succeeding the tax year in which the certificate expires, unless a new disability certificate is obtained and furnished; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "154-2-c",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "the certificate referred to in clauses (a) and (b) of this sub-section is furnished in the form and manner, as may be prescribed, along with the return of income under section 263 for the tax year in which the deduction is claimed.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-154-2-c-001",
                  "target_id": "263",
                  "target_type": "section",
                  "anchor_text": "section 263",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-154-2-c-002",
                  "target_id": "154-2-a",
                  "target_type": "clause",
                  "anchor_text": "clauses (a) and (b)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-154-2-001",
              "target_id": "154-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "154-3",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this section, \"disability\", \"medical authority\", \"person with disability\" or \"person with severe disability\" shall have the same meanings as provided in section 127.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-154-3-001",
              "target_id": "127",
              "target_type": "section",
              "anchor_text": "section 127",
              "relationship": "procedure_reference",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
