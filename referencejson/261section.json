          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "261-c-i",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "the Joint Director or the Additional Director; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "261-c-ii",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "the Joint Commissioner or the Additional Commissioner; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "261-c-iii",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "the Assistant Director or the Deputy Director; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "261-c-iv",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "the Assistant Commissioner or the Deputy Commissioner; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "v",
              "id": "261-c-v",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "the Income-tax Officer or the Tax Recovery Officer;",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "d",
          "id": "261-d",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
