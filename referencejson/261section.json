          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "261-d-i",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "the Principal Director General or the Director General; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "261-d-ii",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "the Principal Chief Commissioner or the Chief Commissioner; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "261-d-iii",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
