              "text": "the Principal Director or the Director; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "261-d-iv",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
