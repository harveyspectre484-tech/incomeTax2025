              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "261-a-iii",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "the Principal Director or the Director; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "261-a-iv",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
