              "children": []
            },
            {
              "type": "sub_clause",
              "number": "v",
              "id": "261-d-v",
              "indent": 0,
              "line_start": 23,
              "page_start": 1,
              "page_end": 1,
              "text": "the Joint Director or the Additional Director; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "vi",
              "id": "261-d-vi",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text": "the Joint Commissioner or the Additional Commissioner;",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "e",
          "id": "261-e",
          "indent": 0,
          "line_start": 25,
          "page_start": 1,
          "page_end": 1,
          "text": "\"computer system\" means computers, computer networks, computer resources, communication devices, digital or electronic data storage devices, used on stand-alone mode or part of a computer system, linked through a network, or utilised through intermediaries for information creation or processing or storage or exchange, and includes the remote server or cloud server or virtual digital space;",
          "children": []
        },
        {
          "type": "clause",
          "number": "f",
          "id": "261-f",
          "indent": 0,
          "line_start": 26,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "\"date on which the last of the authorisations for search was executed\" means—",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "261-f-i",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "in the case of search, the date of conclusion of search as recorded in the last panchnama drawn in relation to any person in whose case the warrant of authorisation has been issued; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "261-f-ii",
              "indent": 0,
              "line_start": 28,
              "page_start": 1,
              "page_end": 1,
              "text": "in the case of requisition under section 248, the date of actual receipt of the books of account or other documents or computer system or assets by the requisitioning officer;",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "g",
          "id": "261-g",
          "indent": 0,
          "line_start": 29,
          "page_start": 1,
          "page_end": 1,
          "text": "\"electronic form\" shall have the same meaning as provided in section 2(1)(r) of the Information Technology Act, 2000 (21 of 2000);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-261-g-001",
              "target_id": "2-1-r",
              "target_type": "clause",
              "anchor_text": "section 2(1)(r)",
              "relationship": "procedure_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "clause",
          "number": "h",
          "id": "261-h",
          "indent": 0,
          "line_start": 30,
          "page_start": 1,
          "page_end": 1,
          "text": "\"electronic record\" shall have the same meaning as provided in section 2(1)(t) of the Information Technology Act, 2000 (21 of 2000);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-261-h-001",
              "target_id": "2-1-t",
              "target_type": "clause",
              "anchor_text": "section 2(1)(t)",
              "relationship": "procedure_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "clause",
          "number": "i",
          "id": "261-i",
          "indent": 0,
          "line_start": 31,
          "page_start": 1,
          "page_end": 1,
          "text": "\"material seized or requisitioned\" means books of account or other documents or computer systems, and extracts seized from a person during the course of search under section 247 or requisitioned under section 248, and includes seizure of backup taken from any specialised programs like tally software, excel sheets, word files and all electronic records including data and information in electronic form or on the computer system, containing figures and any other relevant noting, and shall be construed to mean as books of account maintained by the said person;",
          "children": [],
          "references": [
            {
              "reference_id": "ref-261-i-001",
              "target_id": "247",
              "target_type": "section",
              "anchor_text": "section 247 or requisitioned",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-261-i-002",
              "target_id": "248",
              "target_type": "section",
              "anchor_text": "section 248",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "clause",
          "number": "j",
          "id": "261-j",
          "indent": 0,
          "line_start": 32,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "\"virtual digital space\" means an environment, area or realm, that is constructed and experienced through computer technology and not the physical, tangible world which encompasses any digital realm that allows users to interact, communicate and perform activities using computer systems, computer networks, computer resources, communication devices, cyberspace, internet, worldwide web and emerging technologies, using data and information in the electronic form for creation or storage or exchange and includes––",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "261-j-i",
              "indent": 0,
              "line_start": 33,
              "page_start": 1,
              "page_end": 1,
              "text": "email servers;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "261-j-ii",
              "indent": 0,
              "line_start": 34,
              "page_start": 1,
              "page_end": 1,
              "text": "social media account;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "261-j-iii",
              "indent": 0,
              "line_start": 35,
              "page_start": 1,
              "page_end": 1,
              "text": "online investment account, trading account, banking account, etc.;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "261-j-iv",
              "indent": 0,
              "line_start": 36,
              "page_start": 1,
              "page_end": 1,
              "text": "any website used for storing details of ownership of any asset; (v) remote server or cloud servers;",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "vi",
              "id": "261-j-vi",
              "indent": 0,
              "line_start": 37,
              "page_start": 1,
              "page_end": 1,
              "text": "digital application platforms; and",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "vii",
              "id": "261-j-vii",
              "indent": 0,
              "line_start": 38,
              "page_start": 1,
              "page_end": 1,
              "text": "any other space of similar nature.",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        }
      ],
      "text_after_clauses": ""
    }
