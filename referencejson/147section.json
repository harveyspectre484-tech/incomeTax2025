              "indent": 0,
              "line_start": 32,
              "page_start": 1,
              "page_end": 1,
              "text": "for ten consecutive tax years beginning from the relevant tax year in the case of an entity mentioned in sub-section (1)(a);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-147-5-a-001",
                  "target_id": "147-1-a",
                  "target_type": "clause",
