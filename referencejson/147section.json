  "sections": [
    {
      "type": "section",
      "number": "147",
      "id": "147",
      "title": "Deductions for income of Offshore Banking Units and Units of International Financial Services Centre.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "147-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where the following assessee has any income of the nature referred to in sub-section (3), there shall be allowed a deduction equal to 100% of such income:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "147-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "a scheduled bank, or a bank incorporated under the laws of a country outside India, and having an Offshore Banking Unit in a Special Economic Zone; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "147-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "a unit of an International Financial Services Centre.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-147-1-001",
              "target_id": "147-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "147-2",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "footnote_refs": [
            "13"
          ],
          "text_before_clauses": "Irrespective of anything contained in section 80LA of the Income-tax Act, 1961 (43 of 1961), the deduction shall be allowed,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "147-2-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "for an entity mentioned in sub-section (1)(a),—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "147-2-a-i",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "for twenty consecutive tax years beginning from the relevant tax year; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "147-2-a-ii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in a case, where the tenth year, out of the period of ten consecutive years of deduction allowed under section 80LA(1) of the said Act has ended on the 31st March, 2025, for further ten consecutive years from the tax year beginning on the 1st April, 2026; and",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "147-2-b",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "in the case of an entity mentioned in sub-section (1)(b), for twenty consecutive tax years out of twenty-five years beginning from the relevant tax year, at the option of an assessee.]",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-147-2-b-001",
                  "target_id": "147-1-b",
                  "target_type": "clause",
                  "anchor_text": "sub-section (1)(b)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-147-2-001",
              "target_id": "80L",
              "target_type": "section",
              "anchor_text": "section 80L",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "147-3",
          "indent": 0,
          "line_start": 13,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The income referred to in sub-section (1) shall be the income from—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "147-3-a",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "an Offshore Banking Unit located in a Special Economic Zone; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "147-3-b",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "the business activities referred to in section 6(1) of the Banking Regulation Act, 1949 (10 of 1949), with undertakings in a Special Economic Zone or entities that develop, develop and operate, or develop, operate and maintain Special Economic Zone; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-147-3-b-001",
                  "target_id": "6-1",
                  "target_type": "subsection",
                  "anchor_text": "section 6(1)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "147-3-c",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "the approved business activities of any Unit of an International Financial Services Centre set up in a Special Economic Zone; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "147-3-d",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "transfer of an asset being, an aircraft or a ship, leased by a unit referred to in clause (c) if such unit commenced its business operations by 31st March, 2030.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-147-3-d-001",
                  "target_id": "147-3-c",
                  "target_type": "clause",
                  "anchor_text": "clause (c)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-147-3-001",
              "target_id": "147-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "147-4",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The deduction under this section shall be allowed only if the assessee submits along with the return of income—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "147-4-a",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "a report in the form as may be prescribed, from an accountant certifying the correctness of claim of deduction; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "147-4-b",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "a copy of the—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "147-4-b-i",
                  "indent": 0,
                  "line_start": 21,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "permission obtained under section 23(1)(a) of the Banking Regulation Act, 1949 (10 of 1949); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "147-4-b-ii",
                  "indent": 0,
                  "line_start": 22,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "permission or registration obtained under the International Financial Services Centres Authority Act, 2019 (50 of 2019).",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "147-6",
          "indent": 0,
          "line_start": 23,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this section,—",
          "children": []
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "147-5",
          "indent": 0,
          "line_start": 24,
          "page_start": 1,
          "page_end": 1,
          "footnote_refs": [
            "14"
          ],
          "text_before_clauses": "In respect of any Offshore Banking Unit or any other unit referred in sub-section (1), commencing operations on or after the 1st April, 2026, the deduction under sub-section (1) shall be available only if such unit is not formed by splitting up or reconstruction or reorganisation or transfer of a business already in existence in India.",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "147-5-a",
              "indent": 0,
              "line_start": 25,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"relevant tax year\" shall be,—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "147-5-a-i",
                  "indent": 0,
                  "line_start": 26,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in case of an entity referred to in sub-section (1)(a), the tax year in which permission under section 23(1)(a) of the Banking Regulation Act, 1949 (10 of 1949), or permission or registration under the Securities and Exchange Board of India Act, 1992 (15 of 1992) or any other relevant law in force was obtained; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "147-5-a-ii",
                  "indent": 0,
                  "line_start": 27,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in case of an entity referred to in sub-section (1)(b), the tax year in which permission under section 23(1)(a) of the Banking Regulation Act, 1949 (10 of 1949), or permission or registration under the Securities and Exchange Board of India Act, 1992 (15 of 1992), or permission or registration under the International Financial Services Centres Authority Act, 2019 (50 of 2019) was obtained;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "147-5-b",
              "indent": 0,
              "line_start": 28,
              "page_start": 1,
              "page_end": 1,
              "text": "\"Unit\" shall have the same meaning as assigned to it in section 2(zc) of the Special Economic Zones Act, 2005 (28 of 2005);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-147-5-b-001",
                  "target_id": "2-zc",
                  "target_type": "clause",
                  "anchor_text": "section 2(zc)",
