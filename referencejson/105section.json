      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "105-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where any expenditure has been incurred by the assessee in any tax year, and—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "105-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee offers no explanation about the source of such expenditure or part thereof; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "105-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the explanation offered about the source of such expenditure by the assessee is not satisfactory in the opinion of the Assessing Officer, then, the amount covered by such expenditure or part thereof, shall be deemed to be the income of the assessee for that tax year.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "105-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of any other provision of this Act, the amount deemed as income in sub-section (1) shall not be allowed as a deduction under this Act.",
          "clauses": [],
          "text_after_clauses": "",
