    {
      "type": "section",
      "number": "351",
      "id": "351",
      "title": "Specified violation.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "351-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The following shall constitute specified violation by a registered non-profit organisation:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "351-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where any income of the registered non-profit organisation has been applied, other than for its objects; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "351-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "it carries out any commercial activity in contravention of the provisions of section 345 66[]; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-351-1-b-001",
                  "target_id": "345",
                  "target_type": "section",
                  "anchor_text": "section 345",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "351-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where it has applied any part of its total income for private religious purposes, which does not 67[enure] for the benefit of the public; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "351-1-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where a registered non-profit organisation, created or established after the commencement of this Act for charitable purpose, has applied any part of its income for the benefit of any particular religious community or caste other than the Scheduled Castes or the Scheduled Tribes or backward classes or women and children; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "351-1-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where any activity being carried out by the registered non-profit organisation is not genuine or is not being carried out in accordance with all or any of the conditions subject to which it was registered; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "351-1-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the registered non-profit organisation has not complied with the requirements of any other law as referred under section 332(7)(a) and the order, direction or decree, holding that such non-compliance has occurred, has either not been disputed, or has attained finality; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-351-1-f-001",
                  "target_id": "332-7-a",
                  "target_type": "clause",
                  "anchor_text": "section 332(7)(a) and the",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "351-1-g",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the application referred to in section 332(1) contains any false or incorrect information.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-351-1-g-001",
                  "target_id": "332-1",
                  "target_type": "subsection",
                  "anchor_text": "section 332(1)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "351-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "351-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the Principal Commissioner or Commissioner has noticed occurrence of one or more specified violations during any tax year;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "351-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the Principal Commissioner or Commissioner has received a reference from the Assessing Officer under section 270(13) for any tax year; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-351-2-b-001",
                  "target_id": "270-13",
                  "target_type": "subsection",
                  "anchor_text": "section 270(13)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "351-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a registered non-profit organisation has been selected as per the risk management strategy formulated by the Board for any tax year, the Principal Commissioner or Commissioner shall—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "351-2-c-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "call for such documents or information from the registered non-profit organisation, or make such inquiry as he thinks necessary in order to satisfy himself about the occurrence of any specified violation;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "351-2-c-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "pass an order in writing,—"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "351-2-c-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "forward a copy of the order passed under clause (ii) to the Assessing Officer and such registered non-profit organisation."
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "351-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The order under sub-section (2)(ii), shall be passed before the expiry of six months, calculated from the end of the quarter in which the first notice is issued by the Principal Commissioner or Commissioner, calling for any document or information, or for making any inquiry, under clause (i) of the said sub-section.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-351-3-001",
              "target_id": "351-2-ii",
              "target_type": "clause",
              "anchor_text": "sub-section (2)(ii)",
              "relationship": "depends_on",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-351-3-002",
              "target_id": "351-3-i",
              "target_type": "clause",
              "anchor_text": "clause (i)",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
