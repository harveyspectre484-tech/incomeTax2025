{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "515",
      "id": "515",
      "title": "Appearance by authorised representative.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "515-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "An assessee, entitled or required to attend before any income-tax authority or the Appellate Tribunal for any proceeding under this Act, may attend through an authorised representative.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "515-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "The provisions of sub-section (1) shall not apply where an assessee is required to attend personally for examination on oath or affirmation under section 246.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-515-2-001",
              "target_id": "515-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "exception_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-515-2-002",
              "target_id": "246",
              "target_type": "section",
              "anchor_text": "section 246",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "515-3",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,––",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "515-3-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"authorised representative\" means a person authorised by the assessee, in writing, to appear on his behalf, being—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "515-3-a-i",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a person related to or regularly employed by the assessee in any manner; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "515-3-a-ii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any officer of a scheduled bank with which the assessee maintains a current account or has other regular dealings; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "515-3-a-iii",
                  "indent": 0,
                  "line_start": 12,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any legal practitioner, who is entitled to practise in any civil court in India; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "515-3-a-iv",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an accountant; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "v",
                  "id": "515-3-a-v",
                  "indent": 0,
                  "line_start": 14,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any person, who has passed any accountancy examination recognised by the Board; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vi",
                  "id": "515-3-a-vi",
                  "indent": 0,
                  "line_start": 15,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any person, who has acquired such educational qualifications, as may be prescribed; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vii",
                  "id": "515-3-a-vii",
                  "indent": 0,
                  "line_start": 16,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any person who, before the coming into force of the Income-tax Act, 1961 (43 of 1961) in the Union territory of Dadra and Nagar Haveli, Goa, Daman and Diu, or Pondicherry, attended before an income-tax authority in the said territory on behalf of any assessee otherwise than as an employee or relative of that assessee; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "viii",
                  "id": "515-3-a-viii",
                  "indent": 0,
                  "line_start": 17,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other person who was an authorised representative in accordance with the provisions of section 288(2)(vii) of the Income-tax Act, 1961 (43 of 1961); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ix",
                  "id": "515-3-a-ix",
                  "indent": 0,
                  "line_start": 18,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other person as may be prescribed;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "515-3-b",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "\"accountant\" means a chartered accountant as defined in section 2(1)(b) of the Chartered Accountants Act, 1949 (38 of 1949), who holds a valid certificate of practice under section 6(1) of that Act, but does not include [except for representing the assessee under sub-section (1)],—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "515-3-b-i",
                  "indent": 0,
                  "line_start": 20,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in case of an assessee, being a company, a person who is not eligible for appointment as an auditor of the said company under section 141(3) of the Companies Act, 2013 (18 of 2013); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "515-3-b-ii",
                  "indent": 0,
                  "line_start": 21,
                  "page_start": 1,
                  "page_end": 1,
                  "text_before_items": "in any other case, —",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "515-3-b-ii-A",
                      "indent": 0,
                      "line_start": 22,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "the assessee himself, or in the case of being a firm or association of persons or a Hindu undivided family, any partner of such firm or a member of such association or such Hindu undivided family;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "B",
                      "id": "515-3-b-ii-B",
                      "indent": 0,
                      "line_start": 23,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "for an assessee, being a registered non-profit organisation, any person referred to in section 355(h)(i) or (ii) or (iii) or (iv);",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "C",
                      "id": "515-3-b-ii-C",
                      "indent": 0,
                      "line_start": 24,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "for any person other than the persons referred to in sub-clauses (A) and (B), the person who is competent to verify the return under section 263 as per section 265;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "D",
                      "id": "515-3-b-ii-D",
                      "indent": 0,
                      "line_start": 25,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "any relative of any of the persons referred to in sub-clauses (A), (B) and (C);",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "E",
                      "id": "515-3-b-ii-E",
                      "indent": 0,
                      "line_start": 26,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "an officer or employee of the assessee;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "F",
                      "id": "515-3-b-ii-F",
                      "indent": 0,
                      "line_start": 27,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "an individual, who, is a partner, or who is in the employment, of an officer or employee of the assessee;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "G",
                      "id": "515-3-b-ii-G",
                      "indent": 0,
                      "line_start": 28,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "an individual, who or his relative or partner—",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "I",
                      "id": "515-3-b-ii-I",
                      "indent": 0,
                      "line_start": 29,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "is holding any security of, or interest in, the assessee and the face value of such security or interest held by his relative does not exceed Rs. 1,00,000;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "II",
                      "id": "515-3-b-ii-II",
                      "indent": 0,
                      "line_start": 30,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "is indebted to the assessee, and such debt in case of his relative does not exceed Rs. 1,00,000;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "III",
                      "id": "515-3-b-ii-III",
                      "indent": 0,
                      "line_start": 31,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "has given a guarantee or provided security in connection with the indebtedness of a third person to the assessee and such relative gives a guarantee or provides security for an amount not exceeding Rs. 1,00,000;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "H",
                      "id": "515-3-b-ii-H",
                      "indent": 0,
                      "line_start": 32,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "a person who, whether directly or indirectly, has business relationship with the assessee of such nature, as may be prescribed; (I) a person convicted by a court of an offence involving fraud and ten years has not elapsed from the date of such conviction.",
                      "children": []
                    }
                  ],
                  "text_after_items": ""
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "515-4",
          "indent": 0,
          "line_start": 33,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No person,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "515-4-a",
              "indent": 0,
              "line_start": 34,
              "page_start": 1,
              "page_end": 1,
              "text": "who has been dismissed or removed from Government service; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "515-4-b",
              "indent": 0,
              "line_start": 35,
              "page_start": 1,
              "page_end": 1,
              "text": "who has been convicted of an offence connected with any income-tax proceeding or on whom a penalty has been imposed under this Act, except a penalty imposed under section 271(1)(ii) or 272A(1)(d) of the Income-tax Act, 1961 (43 of 1961) or section 465(1)(d) of this Act; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-515-4-b-001",
                  "target_id": "271-1-ii",
                  "target_type": "clause",
                  "anchor_text": "section 271(1)(ii) or 272A",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-515-4-b-002",
                  "target_id": "465-1-d",
                  "target_type": "clause",
                  "anchor_text": "section 465(1)(d)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "515-4-c",
              "indent": 0,
              "line_start": 36,
              "page_start": 1,
              "page_end": 1,
              "text": "who has become an insolvent; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "515-4-d",
              "indent": 0,
              "line_start": 37,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "who has been convicted by a court for an offence involving fraud, shall be qualified to represent an assessee under sub-section (1), for––",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "515-4-d-i",
                  "indent": 0,
                  "line_start": 39,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "all times, in case of a person referred to in clause (a);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "515-4-d-ii",
                  "indent": 0,
                  "line_start": 40,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such time as the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner may by order determine, in case of a person referred to in clause (b);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "515-4-d-iii",
                  "indent": 0,
                  "line_start": 41,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the period during which the insolvency continues, in case of a person referred to in clause (c); and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "515-4-d-iv",
                  "indent": 0,
                  "line_start": 42,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "ten years from the date of conviction, in case of a person referred to in clause (d).",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "515-5",
          "indent": 0,
          "line_start": 43,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If a person,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "515-5-a",
              "indent": 0,
              "line_start": 44,
              "page_start": 1,
              "page_end": 1,
              "text": "who is a legal practitioner or an accountant, is found guilty of misconduct in his professional capacity by any authority authorised to institute disciplinary proceedings against him, the order passed by that authority shall affect his right to attend before an income-tax authority in the same manner as it affects his right to practise as a legal practitioner or accountant, as the case may be;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "515-5-b",
              "indent": 0,
              "line_start": 45,
              "page_start": 1,
              "page_end": 1,
              "text": "who is not a legal practitioner or an accountant, and is found guilty of misconduct in any income-tax proceedings by the prescribed income-tax authority, he may be directed by such authority that he shall henceforth be disqualified from representing an assessee under sub-section (1).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-515-5-b-001",
                  "target_id": "515-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "515-6",
          "indent": 0,
          "line_start": 46,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Every order or direction under sub-section (4)(b) or (5)(b) shall be subject to the following conditions:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "515-6-a",
              "indent": 0,
              "line_start": 47,
              "page_start": 1,
              "page_end": 1,
              "text": "no such order or direction shall be made against any person unless he has been given a reasonable opportunity of being heard;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "515-6-b",
              "indent": 0,
              "line_start": 48,
              "page_start": 1,
              "page_end": 1,
              "text": "any person against whom such an order or direction is made may, within one month of the said order or direction, appeal to the Board to have the order or direction cancelled; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "515-6-c",
              "indent": 0,
              "line_start": 49,
              "page_start": 1,
              "page_end": 1,
              "text": "no such order or direction shall take effect until one month has passed from the making thereof, or, if an appeal has been filed, until the disposal of the appeal.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-515-6-001",
              "target_id": "515-4-b",
              "target_type": "clause",
              "anchor_text": "sub-section (4)(b) or (5)",
              "relationship": "subject_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "515-7",
          "indent": 0,
          "line_start": 50,
          "page_start": 1,
          "page_end": 1,
          "text": "A person disqualified to represent an assessee by virtue of section 61(3) of the Indian Income-tax Act, 1922 (11 of 1922) or section 288(5) of the Income-tax Act, 1961 (43 of 1961) shall be disqualified to represent an assessee under sub-section (1).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-515-7-001",
              "target_id": "515-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-515-7-002",
              "target_id": "61-3",
              "target_type": "subsection",
              "anchor_text": "section 61(3)",
              "relationship": "related_to",
              "confidence": "medium"
            },
            {
              "reference_id": "ref-515-7-003",
              "target_id": "288-5",
              "target_type": "subsection",
              "anchor_text": "section 288(5)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "515-8",
          "indent": 0,
          "line_start": 51,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, the expression \"relative\", in relation to an individual, means—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "515-8-a",
              "indent": 0,
              "line_start": 52,
              "page_start": 1,
              "page_end": 1,
              "text": "spouse of the individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "515-8-b",
              "indent": 0,
              "line_start": 53,
              "page_start": 1,
              "page_end": 1,
              "text": "brother or sister of the individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "515-8-c",
              "indent": 0,
              "line_start": 54,
              "page_start": 1,
              "page_end": 1,
              "text": "brother or sister of the spouse of the individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "515-8-d",
              "indent": 0,
              "line_start": 55,
              "page_start": 1,
              "page_end": 1,
              "text": "any lineal ascendant (maternal or paternal) or descendant of the individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "515-8-e",
              "indent": 0,
              "line_start": 56,
              "page_start": 1,
              "page_end": 1,
              "text": "any lineal ascendant (maternal or paternal) or descendant of the spouse of the individual;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "515-8-f",
              "indent": 0,
              "line_start": 57,
              "page_start": 1,
              "page_end": 1,
              "text": "spouse of a person referred to in clause (b), (c), (d) or (e);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-515-8-f-001",
                  "target_id": "515-8-b",
                  "target_type": "clause",
                  "anchor_text": "clause (b)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "g",
              "id": "515-8-g",
              "indent": 0,
              "line_start": 58,
              "page_start": 1,
              "page_end": 1,
              "text": "any lineal descendant of a brother or sister of either the individual or the spouse of the individual.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}