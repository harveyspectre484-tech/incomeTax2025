      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "527-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "If the Central Government is satisfied that it is necessary or expedient in the public interest, it may, by notification, make an exemption, reduction in rate, or other modification of income-tax for any class of persons specified in sub-section (2) or in regard to the whole or any part of the income of such class of persons or the status in which such class of persons or the members thereof are to be assessed on their income from the business referred to in subsection (2)(a), effective from tax year beginning on or after 1st April, 1992.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-527-1-001",
              "target_id": "527-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2) or in",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-527-1-002",
              "target_id": "527-2-a",
              "target_type": "clause",
              "anchor_text": "subsection (2)(a)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "527-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The persons referred to in sub-section (1) shall be the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "527-2-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "persons with whom the Central Government has entered into agreements for the association or participation of that Government, or any person authorised by that Government in any business of prospecting for or extraction or production of mineral oils;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "527-2-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "persons providing any services or facilities or supplying any ship, aircraft, machinery or plant (whether by sale or hire) for any business consisting of the prospecting for or extraction or production of mineral oils carried on by that Government, or any person specified by that Government by notification; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "527-2-c",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "employees of the persons referred to in clause (a) or (b).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-527-2-c-001",
                  "target_id": "527-2-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a) or (b)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-527-2-001",
              "target_id": "527-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "527-3",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text": "Every notification issued under this section shall be laid before each House of Parliament.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "527-4",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "527-4-a",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "\"mineral oil\" includes petroleum and natural gas;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "527-4-b",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "\"status\" means the category of person as defined in section 2(77) under which the assessee is assessed.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-527-4-b-001",
                  "target_id": "2-77",
                  "target_type": "subsection",
                  "anchor_text": "section 2(77)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
