          "type": "clause",
          "number": "b",
          "id": "357-b",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "an order against the assessee where the assessee denies his liability to be assessed under this Act; or",
