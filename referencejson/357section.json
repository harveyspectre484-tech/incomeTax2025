          "children": [],
          "references": [
            {
              "reference_id": "ref-357-a-001",
              "target_id": "231-4-b",
              "target_type": "clause",
              "anchor_text": "section 231(4)(b)",
              "relationship": "depends_on",
              "confidence": "medium"
            }
