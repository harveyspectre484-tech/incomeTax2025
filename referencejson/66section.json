              "indent": 0,
              "line_start": 59,
              "page_start": 1,
              "page_end": 1,
              "text": "processing;",
              "children": []
            },
            {
              "type": "clause",
              "number": "q",
              "id": "66-29-q",
              "indent": 0,
              "line_start": 60,
              "page_start": 1,
              "page_end": 1,
              "text": "supply of electrical or other energy; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "r",
              "id": "66-29-r",
              "indent": 0,
              "line_start": 61,
              "page_start": 1,
