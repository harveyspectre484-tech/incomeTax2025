              "number": "j",
              "id": "66-29-j",
              "indent": 0,
              "line_start": 53,
              "page_start": 1,
              "page_end": 1,
              "text": "insurance;",
              "children": []
            },
            {
              "type": "clause",
              "number": "k",
              "id": "66-29-k",
              "indent": 0,
              "line_start": 54,
              "page_start": 1,
              "page_end": 1,
              "text": "chit funds;",
              "children": []
            },
            {
              "type": "clause",
              "number": "l",
              "id": "66-29-l",
              "indent": 0,
              "line_start": 55,
