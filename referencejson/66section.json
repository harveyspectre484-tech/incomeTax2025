{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "66",
      "id": "66",
      "title": "Interpretation.",
      "indent": 0,
      "line_start": 2,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "For the purposes of Part D of this Chapter,—",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "66-1",
          "indent": 0,
          "line_start": 3,
          "page_start": 1,
          "page_end": 1,
          "text_before_items": "\"agreement\", for the purposes of section 26(2)(h), includes any arrangement or understanding or action in concert,—",
          "items": [
            {
              "type": "item",
              "number": "A",
              "id": "66-1-A",
              "indent": 0,
              "line_start": 4,
              "page_start": 1,
              "page_end": 1,
              "text": "whether or not such arrangement, understanding or action is formal or in writing; or",
              "children": []
            },
            {
              "type": "item",
              "number": "B",
              "id": "66-1-B",
              "indent": 0,
              "line_start": 5,
              "page_start": 1,
              "page_end": 1,
              "text": "whether or not such arrangement, understanding or action is intended to be enforceable by legal proceedings;",
              "children": []
            }
          ],
          "text_after_items": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "66-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "\"banking company\" means a company to which the Banking Regulation Act, 1949 (10 of 1949) applies and includes any bank or banking institution referred to in section 51 of that Act;",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-2-001",
              "target_id": "51",
              "target_type": "section",
              "anchor_text": "section 51",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "66-3",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "\"commission or brokerage\" shall have the meaning assigned to it in section 402(7);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-3-001",
              "target_id": "402-7",
              "target_type": "subsection",
              "anchor_text": "section 402(7)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "66-4",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "footnote_refs": [
            "9"
          ],
          "text": "\"commodities transactions tax\" and \"commodity derivative\" shall have the same meanings as respectively assigned to them in Chapter VII of the Finance Act, 2013 (17 of 2013);",
          "children": []
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "66-5",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text": "\"fees for technical services\" shall have the meaning assigned to it in section 9(7)(b);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-5-001",
              "target_id": "9-7-b",
              "target_type": "clause",
              "anchor_text": "section 9(7)(b)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "66-6",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text": "\"housing finance company\" means a public company formed or registered in India with the main object of carrying on the business of providing longterm finance for construction or purchase of houses in India for residential purposes;",
          "children": []
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "66-7",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text": "\"Indian Institute of Technology\" shall have the same meaning as that of \"Institute\" defined in section 3(g) of the Institutes of Technology Act, 1961 (59 of 1961);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-7-001",
              "target_id": "3-g",
              "target_type": "clause",
              "anchor_text": "section 3(g)",
              "relationship": "definition_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "66-8",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "\"Keyman insurance policy\" shall have the meaning assigned to it in Schedule II (Note 1);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-8-001",
              "target_id": "schedule-II",
              "target_type": "schedule",
              "anchor_text": "Schedule II",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "66-9",
          "indent": 0,
          "line_start": 13,
          "page_start": 1,
          "page_end": 1,
          "text": "\"limited liability partnership\" shall have the same meaning as assigned to it in section 2(1)(n) of the Limited Liability Partnership Act, 2008 (6 of 2009);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-9-001",
              "target_id": "2-1-n",
              "target_type": "clause",
              "anchor_text": "section 2(1)(n)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "66-10",
          "indent": 0,
          "line_start": 14,
          "page_start": 1,
          "page_end": 1,
          "text": "\"long-term finance\", for the purposes of section 32(e), means any loan or advance where the terms under which moneys are loaned or advanced provide for repayment along with interest thereof during a period of not less than five years;",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-10-001",
              "target_id": "32-e",
              "target_type": "clause",
              "anchor_text": "section 32(e)",
              "relationship": "definition_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "66-11",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text": "\"micro enterprise\" shall be an enterprise classified as such under the notification in this behalf by the Central Government under the Micro, Small and Medium Enterprises Development Act, 2006 (27 of 2006);",
          "children": []
        },
        {
          "type": "subsection",
          "number": "12",
          "id": "66-12",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text": "\"mineral oil\" includes petroleum and natural gas;",
          "children": []
        },
        {
          "type": "subsection",
          "number": "13",
          "id": "66-13",
          "indent": 0,
          "line_start": 17,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"moneys payable\" in respect of any tangible asset [as referred to in section 33(12)(a)(i)] includes—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "66-13-a",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "any insurance, salvage or compensation moneys payable in respect thereof; (b) where the asset is sold, the price for which it is sold;",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-66-13-001",
              "target_id": "33-12-a-i",
              "target_type": "subclause",
              "anchor_text": "section 33(12)(a)(i)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "14",
          "id": "66-14",
          "indent": 0,
          "line_start": 19,
          "page_start": 1,
          "page_end": 1,
          "text": "\"non-scheduled bank\" means a banking company as defined in section 5(c) of the Banking Regulation Act, 1949 (10 of 1949), which is not a scheduled bank;",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-14-001",
              "target_id": "5-c",
              "target_type": "clause",
              "anchor_text": "section 5(c)",
              "relationship": "definition_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "15",
          "id": "66-15",
          "indent": 0,
          "line_start": 20,
          "page_start": 1,
          "page_end": 1,
          "text": "\"paid\" means, except for section 37, actually paid or incurred according to the method of accounting upon the basis of which the profits or gains are computed under the head \"Profits and gains of business or profession\";",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-15-001",
              "target_id": "37",
              "target_type": "section",
              "anchor_text": "section 37",
              "relationship": "definition_reference",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "16",
          "id": "66-16",
          "indent": 0,
          "line_start": 21,
          "page_start": 1,
          "page_end": 1,
          "text": "\"permanent establishment\" shall have the meaning assigned to it in section 173(c);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-16-001",
              "target_id": "173-c",
              "target_type": "clause",
              "anchor_text": "section 173(c)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "17",
          "id": "66-17",
          "indent": 0,
          "line_start": 22,
          "page_start": 1,
          "page_end": 1,
          "text": "\"plant\" includes ships, vehicles, books, scientific apparatus and surgical equipment used for the business or profession but does not include tea bushes or livestock or buildings or furniture and fittings;",
          "children": []
        },
        {
          "type": "subsection",
          "number": "18",
          "id": "66-18",
          "indent": 0,
          "line_start": 23,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"predecessor entity\" means—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "66-18-a",
              "indent": 0,
              "line_start": 24,
              "page_start": 1,
              "page_end": 1,
              "text": "the amalgamating Indian company in the case of amalgamation;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "66-18-b",
              "indent": 0,
              "line_start": 25,
              "page_start": 1,
              "page_end": 1,
              "text": "the demerged Indian company, in the case of demerger;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "66-18-c",
              "indent": 0,
              "line_start": 26,
              "page_start": 1,
              "page_end": 1,
              "text": "a firm, in the case of a succession of a firm by a company as referred to in section 70(1)(zd);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-66-18-c-001",
                  "target_id": "70-1-zd",
                  "target_type": "clause",
                  "anchor_text": "section 70(1)(zd)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "66-18-d",
              "indent": 0,
              "line_start": 27,
              "page_start": 1,
              "page_end": 1,
              "text": "a private company or unlisted public company, in case of conversion as referred to in section 70(1)(ze);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-66-18-d-001",
                  "target_id": "70-1-ze",
                  "target_type": "clause",
                  "anchor_text": "section 70(1)(ze)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "19",
          "id": "66-19",
          "indent": 0,
          "line_start": 28,
          "page_start": 1,
          "page_end": 1,
          "text": "\"primary agricultural credit society\" shall have the same meaning as assigned to it in Part V of the Banking Regulation Act, 1949 (10 of 1949);",
          "children": []
        },
        {
          "type": "subsection",
          "number": "20",
          "id": "66-20",
          "indent": 0,
          "line_start": 29,
          "page_start": 1,
          "page_end": 1,
          "text": "\"primary co-operative agricultural and rural development bank\" means a society having its area of operation confined to a taluk and the principal object of which is to provide for long-term credit for agricultural and rural development activities;",
          "children": []
        },
        {
          "type": "subsection",
          "number": "21",
          "id": "66-21",
          "indent": 0,
          "line_start": 30,
          "page_start": 1,
          "page_end": 1,
          "text": "\"professional services\" shall have the meaning assigned to it in section 402(28);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-21-001",
              "target_id": "402-28",
              "target_type": "subsection",
              "anchor_text": "section 402(28)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "22",
          "id": "66-22",
          "indent": 0,
          "line_start": 31,
          "page_start": 1,
          "page_end": 1,
          "text": "\"public company\" shall have the same meaning as assigned to it in section 2(71) of the Companies Act, 2013 (18 of 2013);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-22-001",
              "target_id": "2-71",
              "target_type": "subsection",
              "anchor_text": "section 2(71)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "23",
          "id": "66-23",
          "indent": 0,
          "line_start": 32,
          "page_start": 1,
          "page_end": 1,
          "text": "\"public financial institution\" shall have the same meaning as assigned to it in section 2(72) of the Companies Act, 2013 (18 of 2013);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-23-001",
              "target_id": "2-72",
              "target_type": "subsection",
              "anchor_text": "section 2(72)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "24",
          "id": "66-24",
          "indent": 0,
          "line_start": 33,
          "page_start": 1,
          "page_end": 1,
          "text": "\"rate of exchange\" means the rate of exchange determined or recognised by the Central Government for the conversion of Indian currency into foreign currency or foreign currency into Indian currency;",
          "children": []
        },
        {
          "type": "subsection",
          "number": "25",
          "id": "66-25",
          "indent": 0,
          "line_start": 34,
          "page_start": 1,
          "page_end": 1,
          "text": "\"royalty\" shall have the same meaning as assigned to it in section 9(6)(b);",
          "children": [],
          "references": [
            {
              "reference_id": "ref-66-25-001",
              "target_id": "9-6-b",
              "target_type": "clause",
              "anchor_text": "section 9(6)(b)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "26",
          "id": "66-26",
          "indent": 0,
          "line_start": 35,
          "page_start": 1,
          "page_end": 1,
          "text": "\"rural branch\" means a branch of a scheduled bank or a non-scheduled bank situated in a place which has a population of not more than ten thousand according to the last preceding census, of which the relevant figures have been published before the first day of the tax year;",
          "children": []
        },
        {
          "type": "subsection",
          "number": "27",
          "id": "66-27",
          "indent": 0,
          "line_start": 36,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"scientific research\" means—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "66-27-a",
              "indent": 0,
              "line_start": 37,
              "page_start": 1,
              "page_end": 1,
              "text": "any activity for the extension of knowledge in the fields of natural or applied science including agriculture, animal husbandry or fisheries; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "66-27-b",
              "indent": 0,
              "line_start": 38,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the references to expenditure incurred on scientific research shall include all expenditure incurred for the prosecution, or the provision of facilities for the prosecution, of scientific research, but does not include any expenditure incurred in the acquisition of rights in, or arising out of, scientific research, and the references to scientific research related to a business or class of business shall include any scientific research—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "66-27-b-i",
                  "indent": 0,
                  "line_start": 40,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "which may lead to or facilitate an extension of that business or, all businesses of that class;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "66-27-b-ii",
                  "indent": 0,
                  "line_start": 41,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "of a medical nature which has a special relation to the welfare of workers employed in that business or, all businesses of that class;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "28",
          "id": "66-28",
          "indent": 0,
          "line_start": 42,
          "page_start": 1,
          "page_end": 1,
          "text": "\"securities transaction tax\" shall have the meaning assigned to it under Chapter VII of the Finance (No. 2) Act, 2004 (23 of 2004);",
          "children": []
        },
        {
          "type": "subsection",
          "number": "29",
          "id": "66-29",
          "indent": 0,
          "line_start": 43,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "\"service\", for the purposes of section 26(2)(h), means a service of any description which is made available to potential users and includes the provision of services in connection with business of any industrial or commercial nature such as—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "66-29-a",
              "indent": 0,
              "line_start": 44,
              "page_start": 1,
              "page_end": 1,
              "text": "accounting;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "66-29-b",
              "indent": 0,
              "line_start": 45,
              "page_start": 1,
              "page_end": 1,
              "text": "banking;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "66-29-c",
              "indent": 0,
              "line_start": 46,
              "page_start": 1,
              "page_end": 1,
              "text": "communication;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "66-29-d",
              "indent": 0,
              "line_start": 47,
              "page_start": 1,
              "page_end": 1,
              "text": "conveying of news or information;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "66-29-e",
              "indent": 0,
              "line_start": 48,
              "page_start": 1,
              "page_end": 1,
              "text": "advertising;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "66-29-f",
              "indent": 0,
              "line_start": 49,
              "page_start": 1,
              "page_end": 1,
              "text": "entertainment;",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "66-29-g",
              "indent": 0,
              "line_start": 50,
              "page_start": 1,
