      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "362-1",
          "indent": 0,
          "line_start": 4,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any assessee, aggrieved by any of the following orders, may appeal to the Appellate Tribunal against such order—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "362-1-a",
              "indent": 0,
              "line_start": 5,
              "page_start": 1,
              "page_end": 1,
              "text": "an order passed under this Act, by a Commissioner (Appeals) or a Joint Commissioner (Appeals); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "362-1-b",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "an order passed by a Principal Commissioner or Commissioner under—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "362-1-b-i",
                  "indent": 0,
                  "line_start": 7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 332(7) or (8) or (9) or 351(2)(ii) or section 354(3); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "362-1-b-ii",
                  "indent": 0,
                  "line_start": 8,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 377 or 439 or 465; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "362-1-b-iii",
                  "indent": 0,
                  "line_start": 9,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 287 amending any order as referred to in sub-clauses (i) and (ii):",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "362-1-c",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "an order passed by a Principal Chief Commissioner or Chief Commissioner or a Principal Director General or Director General or a Principal Director or Director under section 377 or 465 or an order passed under section 287 amending any such order; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-362-1-c-001",
                  "target_id": "377",
                  "target_type": "section",
                  "anchor_text": "section 377 or 465",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-362-1-c-002",
                  "target_id": "287",
                  "target_type": "section",
                  "anchor_text": "section 287",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "362-1-d",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "an order passed by an Assessing Officer under section 270(10) or 279, in pursuance of the directions of the Dispute Resolution Panel or an order passed under section 287 in respect of such order; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-362-1-d-001",
                  "target_id": "270-10",
                  "target_type": "subsection",
                  "anchor_text": "section 270(10) or 279",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-362-1-d-002",
                  "target_id": "287",
                  "target_type": "section",
                  "anchor_text": "section 287",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "e",
              "id": "362-1-e",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "an order passed by an Assessing Officer under section 270(10) or 279, with the approval of the Principal Commissioner or Commissioner as referred to in section 274(12) or an order passed under section 287 or 288 in respect of such order; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-362-1-e-001",
                  "target_id": "270-10",
                  "target_type": "subsection",
                  "anchor_text": "section 270(10) or 279",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-362-1-e-002",
                  "target_id": "274-12",
                  "target_type": "subsection",
                  "anchor_text": "section 274(12) or an",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-362-1-e-003",
                  "target_id": "287",
                  "target_type": "section",
                  "anchor_text": "section 287 or 288",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "f",
              "id": "362-1-f",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "an order passed by an Assessing Officer under section 234(4).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-362-1-f-001",
                  "target_id": "234-4",
                  "target_type": "subsection",
                  "anchor_text": "section 234(4)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "362-2",
          "indent": 0,
          "line_start": 14,
          "page_start": 1,
          "page_end": 1,
          "text": "The Principal Commissioner or Commissioner may, if he objects to any order passed by the Joint Commissioner (Appeals) or the Commissioner (Appeals) under this Act, direct the Assessing Officer to appeal to the Appellate Tribunal against the order.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "362-3",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text": "Every appeal under sub-section (1) or (2) shall be filed within two months from the end of the month in which the order sought to be appealed against is communicated to the assessee or to the Principal Commissioner or Commissioner.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-362-3-001",
              "target_id": "362-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "362-4",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text": "The Assessing Officer or the assessee, on receipt of notice that an appeal against an order, has been preferred under sub-section (1) or (2) by the other party, may, irrespective of that he may not have appealed against such order or any part thereof, within thirty days of the receipt of the notice, file a memorandum of cross-objections, verified in the manner, as may be prescribed, against any part of such order, and such memorandum shall be disposed of by the Appellate Tribunal as if it were an appeal presented within the time specified in sub-section (3).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-362-4-001",
              "target_id": "362-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1) or (2)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-362-4-002",
              "target_id": "362-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "362-5",
          "indent": 0,
          "line_start": 17,
          "page_start": 1,
          "page_end": 1,
          "text": "The Appellate Tribunal may admit an appeal or permit the filing of a memorandum of cross-objections after the expiry of the relevant period referred to in sub-section (3) or (4), if it is satisfied that there was sufficient cause for not presenting it within that period.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-362-5-001",
              "target_id": "362-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3) or (4)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "362-6",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An appeal to the Appellate Tribunal shall be in such form and verified in such manner, as may be prescribed and shall, be accompanied by a fee of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "362-6-a",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "Rs. 500, where the total income of the assessee as computed by the Assessing Officer, in the case to which the appeal relates, is Rs. 100000 or less;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "362-6-b",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "Rs. 1500, where the total income of the assessee, computed as aforesaid, in the case to which the appeal relates is more than Rs. 100000 but not more than Rs. 200000;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "362-6-c",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
              "page_end": 1,
              "text": "an amount equal to 1% of the assessed income, subject to a maximum of Rs. 10000, where the total income of the assessee, computed as aforesaid, in the case to which the appeal relates is more than Rs. 200000;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "362-6-d",
              "indent": 0,
              "line_start": 22,
              "page_start": 1,
              "page_end": 1,
              "text": "Rs. 500, where the subject matter of an appeal relates to any matter, other than those specified in clauses (a), (b) and (c).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-362-6-d-001",
                  "target_id": "362-6-a",
                  "target_type": "clause",
                  "anchor_text": "clauses (a)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "362-7",
          "indent": 0,
          "line_start": 23,
          "page_start": 1,
          "page_end": 1,
          "text": "No fee shall be payable for an appeal referred to in sub-section (2), or a memorandum of cross objections referred to in sub-section (4).",
          "children": [],
          "references": [
            {
              "reference_id": "ref-362-7-001",
              "target_id": "362-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-362-7-002",
              "target_id": "362-4",
              "target_type": "subsection",
              "anchor_text": "sub-section (4)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "362-8",
          "indent": 0,
          "line_start": 24,
          "page_start": 1,
          "page_end": 1,
          "text": "An application for stay of demand shall be accompanied by a fee of Rs. 500.",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
