{
  "chapters": [
    {
      "type": "chapter",
      "number": "XV",
      "x": 27.62,
      "y_start": 80.0,
      "page_start": 1,
      "page_end": 1,
      "text": "",
      "children": [
        {
          "type": "section",
          "number": "262",
          "id": "262",
          "title": "Permanent Account Number.",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "",
          "subsections": [
            {
              "type": "subsection",
              "number": "1",
              "id": "262-1",
              "x": 27.62,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every person who has not been allotted a Permanent Account Number shall, within such time as may be prescribed, apply to the Assessing Officer for its allotment if he fulfils any of the following conditions:—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-1-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "his total income or the total income of any other person for which he is assessable under this Act during any tax year exceeded the maximum amount not chargeable to income-tax; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-1-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "he is carrying on any business or profession whose total sales, turnover or gross receipts are or is likely to exceed Rs. 5,00,000 in any tax year; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "262-1-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "he is required to furnish a return of income under section 263 for any tax year; or",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-1-c-001",
                      "target_id": "263",
                      "target_type": "section",
                      "anchor_text": "section 263",
                      "relationship": "depends_on",
                      "confidence": "medium"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "262-1-d",
                  "x": 40.8,
                  "y_start": 450.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "he is a resident, other than an individual, which enters into a financial transaction aggregating to Rs. 2,50,000 or more in a tax year; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "e",
                  "id": "262-1-e",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "he is the managing director, director, partner, trustee, author, founder, karta, chief executive officer, principal officer or office bearer of the person referred to in clause (d) or any person competent to act on behalf of the person referred to in clause (d); or",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-1-e-001",
                      "target_id": "262-1-d",
                      "target_type": "clause",
                      "anchor_text": "clause (d) or any",
                      "relationship": "related_to",
                      "confidence": "high"
                    },
                    {
                      "reference_id": "ref-262-1-e-002",
                      "target_id": "262-1-d",
                      "target_type": "clause",
                      "anchor_text": "clause (d)",
                      "relationship": "related_to",
                      "confidence": "high"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "f",
                  "id": "262-1-f",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "he intends to enter into such transaction as may be prescribed by the Board in the interest of revenue.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "2",
              "id": "262-2",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Any person, not covered under sub-section (1) may apply to the Assessing Officer for the allotment of a Permanent Account Number after which the Assessing Officer shall allot a Permanent Account Number to such person.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-262-2-001",
                  "target_id": "262-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "3",
              "id": "262-3",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every person shall quote Permanent Account Number in all his returns to, or correspondence with, any income-tax authority and in all challans for the payment of any sum due under this Act.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "4",
              "id": "262-4",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every person shall intimate the Assessing Officer of any change in his address or in the name and nature of his business on the basis of which the Permanent Account Number was allotted to him.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "5",
              "id": "262-5",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every person who is eligible to obtain Aadhaar number shall quote such number in the application form for allotment of Permanent Account Number and in the return of income.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "6",
              "id": "262-6",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-6-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "For the cases other than sub-section (5), every person who has been allotted Permanent Account Number and who is eligible to obtain Aadhaar number, shall intimate his Aadhaar number to the prescribed income-tax authority in such form and manner, as may be prescribed;",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-6-a-001",
                      "target_id": "262-5",
                      "target_type": "subsection",
                      "anchor_text": "sub-section (5)",
                      "relationship": "related_to",
                      "confidence": "high"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-6-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if a person fails to intimate his Aadhaar number as per clause (a), the Permanent Account Number allotted to that person shall be made inoperative in such manner as may be prescribed.",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-6-b-001",
                      "target_id": "262-6-a",
                      "target_type": "clause",
                      "anchor_text": "clause (a)",
                      "relationship": "depends_on",
                      "confidence": "high"
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "7",
              "id": "262-7",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Every person who is required to furnish or intimate or quote his Permanent Account Number under this Act, and who—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-7-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "has not been allotted a Permanent Account Number but possesses the Aadhaar number, may furnish or intimate or quote his Aadhaar number in lieu of the Permanent Account Number, and such person shall be allotted a Permanent Account Number in the manner, as may be prescribed;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-7-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "has been allotted a Permanent Account Number, and who has intimated his Aadhaar number as per sub-section (6) may furnish or intimate or quote his Aadhaar number in lieu of the Permanent Account Number.",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-7-b-001",
                      "target_id": "262-6",
                      "target_type": "subsection",
                      "anchor_text": "sub-section (6)",
                      "relationship": "depends_on",
                      "confidence": "high"
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "8",
              "id": "262-8",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "A person who has already been allotted a Permanent Account Number cannot apply, obtain or possess another Permanent Account Number.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "9",
              "id": "262-9",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-9-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Every person entering into such transaction, as may be prescribed, shall quote his Permanent Account Number or Aadhaar number, in the documents pertaining to such transactions and also authenticate such Permanent Account Number or Aadhaar number, in the manner, as may be prescribed;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-9-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "every person receiving any document relating to the transactions referred to in clause (a), shall ensure that Permanent Account Number or Aadhaar number, has been duly quoted in such document and that such Permanent Account Number or Aadhaar number is authenticated in such manner, as may be prescribed.",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-9-b-001",
                      "target_id": "262-9-a",
                      "target_type": "clause",
                      "anchor_text": "clause (a)",
                      "relationship": "related_to",
                      "confidence": "high"
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "10",
              "id": "262-10",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The Board may make rules providing for—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-10-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the form, manner and time in which an application may be made for the allotment of Permanent Account Number and the particulars which such application shall contain;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-10-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "class or classes of persons who shall be required to apply for allotment of Permanent Account Number;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "262-10-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "categories of documents 43[pertaining to, business or profession, or other transactions,] in which Permanent Account Number shall be quoted by every person;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "262-10-d",
                  "x": 40.8,
                  "y_start": 450.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the form and manner in which the person who has not been allotted a Permanent Account Number shall make his declaration;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "e",
                  "id": "262-10-e",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "manner of authentication of Permanent Account Number or Aadhaar number;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "f",
                  "id": "262-10-f",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "class or classes of persons to whom the provisions of this section shall not apply having regard to the transactions or the circumstances.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "11",
              "id": "262-11",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-11-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "The Central Government may, by notification, specify any class or classes of persons who shall apply to the Assessing Officer for the allotment of Permanent Account Number within such time as mentioned in such notification;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-11-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the class or classes of persons in clause (a) may include such persons––",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "262-11-b-i",
                      "x": 55.0,
                      "y_start": 465.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "by whom tax is payable under this Act; or"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "262-11-b-ii",
                      "x": 55.0,
                      "y_start": 480.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "by whom any tax or duty is payable under any other law in force; or"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iii",
                      "id": "262-11-b-iii",
                      "x": 55.0,
                      "y_start": 465.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "being importers and exporters, even when no tax is payable by them."
                    }
                  ],
                  "references": [
                    {
                      "reference_id": "ref-262-11-b-001",
                      "target_id": "262-11-a",
                      "target_type": "clause",
                      "anchor_text": "clause (a)",
                      "relationship": "related_to",
                      "confidence": "high"
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "12",
              "id": "262-12",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The provisions of sub-sections (5) and (6) shall not apply to such person or class or classes of persons or any State or part of any State, as may be notified by the Central Government.",
              "clauses": [],
              "text_after_clauses": "",
              "references": [
                {
                  "reference_id": "ref-262-12-001",
                  "target_id": "262-5",
                  "target_type": "subsection",
                  "anchor_text": "sub-sections (5) and (6)",
                  "relationship": "exception_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "subsection",
              "number": "13",
              "id": "262-13",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purposes of this section,—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "262-13-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"Aadhaar number\" shall have the same meaning as assigned to it in section 2(a) of the Aadhaar (Targeted Delivery of Financial and Other Subsidies, Benefits and Services) Act, 2016 (18 of 2016);",
                  "children": [],
                  "references": [
                    {
                      "reference_id": "ref-262-13-a-001",
                      "target_id": "2-a",
                      "target_type": "clause",
                      "anchor_text": "section 2(a)",
                      "relationship": "related_to",
                      "confidence": "medium"
                    }
                  ]
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "262-13-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"Assessing Officer\" includes an income-tax authority who is assigned the duty of allotting Permanent Account Number;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "262-13-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"authentication\" means the process by which the Permanent Account Number or Aadhaar number along with demographic information or biometric information of an individual is submitted to the income-tax authority or such other authority or agency as may be prescribed for its verification and such authority or agency verifies the correctness, or the lack thereof, on the basis of information available with it.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            }
          ],
          "text_after_subsections": ""
        }
      ]
    }
  ],
