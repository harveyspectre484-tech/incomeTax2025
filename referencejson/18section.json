      "title": "Profits in lieu of salary.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "18-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this Part, \"profits in lieu of salary\" includes,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "18-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount of any compensation due to, or received by, an assessee from his employer or former employer at or in connection with the—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "18-1-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "termination of his employment; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "18-1-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "modification of the terms and conditions relating thereto;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "18-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any amount due to, or received, whether in lump sum or otherwise, by any assessee from any person—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "18-1-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "before his joining any employment with that person; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "18-1-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "after cessation of his employment with that person;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "18-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any payment due to or received by an assessee—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "18-1-c-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from an employer or a former employer; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "18-1-c-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from a provident or other fund, to the extent to which it does not consist of contributions by the assessee or interest on such contributions; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "18-1-c-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any sum received under a Keyman insurance policy as defined in Schedule II (Note 1), including the sum allocated by way of bonus on such policy."
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
