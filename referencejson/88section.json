{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "88",
      "id": "88",
      "title": "Exemption of capital gains on transfer of assets in cases of shifting of industrial undertaking from urban area to any Special Economic Zone.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "88-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in section 87, if the assessee has—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "88-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "capital gains arising from the transfer of a capital asset, being machinery or plant or building or land or any rights in building or land used for the business of an industrial undertaking situated in an urban area, effected in the course of or in consequence of shifting of such industrial undertaking (original asset) to any Special Economic Zone in any urban or any other area; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "88-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "has within one year before or three years after the date of such transfer,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "88-1-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "purchased machinery or plant for the business of the industrial undertaking in such Special Economic Zone;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "88-1-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "acquired building or land or constructed building for his business in such Special Economic Zone;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "88-1-b-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "shifted the original asset and transferred the establishment of such undertaking to such Special Economic Zone; and"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "88-1-b-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "incurred expenses on such other purposes specified by a scheme notified by the Central Government in this behalf, then, instead of capital gain being charged to income-tax as income of the tax year in which the transfer took place, it shall be dealt with as follows:—"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-88-1-001",
              "target_id": "87",
              "target_type": "section",
              "anchor_text": "section 87",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "88-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the capital gain referred to in sub-section (1) is not utilised by the assessee for the new asset within one year before the transfer of the original asset, or before filing the return of income under section 263, then,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "88-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the unutilised amount shall be deposited in a specified bank or institution and utilised as per the scheme notified by the Central Government;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "88-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such deposit shall be made before the filing of the return and not later than the due date applicable in the case of the assessee for filing the return of income under section 263(1); and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-88-2-b-001",
                  "target_id": "263-1",
                  "target_type": "subsection",
                  "anchor_text": "section 263(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "88-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the proof of deposit shall be submitted along with such return.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-88-2-001",
              "target_id": "88-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            },
            {
              "reference_id": "ref-88-2-002",
              "target_id": "263",
              "target_type": "section",
              "anchor_text": "section 263",
              "relationship": "depends_on",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "88-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (1), the amount already utilised for purchasing or constructing the new asset together with the deposited amount under sub-section (2) shall be deemed to be the cost of the new asset.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-88-3-001",
              "target_id": "88-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            },
            {
              "reference_id": "ref-88-3-002",
              "target_id": "88-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "88-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If the amount deposited under sub-section (2) is not wholly or partly utilised for the new asset within the period specified in sub-section (1), then,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "88-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the unutilised amount shall be charged under section 67 as the income of the tax year in which the period of three years from the date of the transfer of the original asset expires; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-88-4-a-001",
                  "target_id": "67",
                  "target_type": "section",
                  "anchor_text": "section 67",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "88-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee shall be entitled to withdraw such unutilised amount in accordance with the scheme referred to in sub-section (2).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-88-4-b-001",
                  "target_id": "88-2",
                  "target_type": "subsection",
                  "anchor_text": "sub-section (2)",
                  "relationship": "procedure_reference",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-88-4-001",
              "target_id": "88-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-88-4-002",
              "target_id": "88-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "88-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purpose of this section, the expression \"urban area\" shall have the meaning assigned to it in section 87.",
          "clauses": [],
          "text_after_clauses": "",
