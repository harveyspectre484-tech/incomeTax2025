          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in this Act,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "525-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "it shall not be necessary to issue an authorisation under section 247 or make a requisition under section 248 separately in the name of each person;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-525-1-a-001",
                  "target_id": "247",
                  "target_type": "section",
                  "anchor_text": "section 247 or make",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-525-1-a-002",
                  "target_id": "248",
                  "target_type": "section",
                  "anchor_text": "section 248",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "525-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "where an authorisation under section 247 has been issued or requisition under section 248 has been made mentioning therein the name of more than one person, the mention of such names of more than one person on such authorisation or requisition shall not be deemed to construe that it was issued in the name of an association of persons or body of individuals consisting of such persons.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-525-1-b-001",
                  "target_id": "247",
                  "target_type": "section",
                  "anchor_text": "section 247",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-525-1-b-002",
                  "target_id": "248",
                  "target_type": "section",
                  "anchor_text": "section 248",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "525-2",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "Irrespective of an authorisation issued under section 247 or a requisition made under section 248 mentioning therein the name of more than one person, the assessment or reassessment shall be made separately in the name of each of the persons mentioned in such authorisation or requisition.",
          "children": [],
          "references": [
