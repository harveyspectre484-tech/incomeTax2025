          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "245-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The scheme referred to in sub-section (1) shall be made to impart greater efficiency, transparency and accountability by—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "245-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "eliminating the interface between the income-tax authority and the assessee or any other person, to the extent technologically feasible;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "245-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "optimising utilisation of the resources through economies of scale and functional specialisation;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "245-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "introducing a team-based exercise of powers and performance of functions by two or more income-tax authorities, concurrently, in respect of any area, or persons or classes of persons, or incomes or classes of income, or cases or classes of cases, with dynamic jurisdiction.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-245-2-001",
              "target_id": "245-1",
              "target_type": "subsection",
