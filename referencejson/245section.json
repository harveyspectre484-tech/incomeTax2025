              "id": "245-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "exercise of all or any of the powers and performance of all or any of the functions conferred on, or assigned to, income-tax authorities under this Act referred to in section 241;",
