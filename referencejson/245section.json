              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "vesting the jurisdiction with the Assessing Officer under section 242; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-245-1-b-001",
                  "target_id": "242",
                  "target_type": "section",
                  "anchor_text": "section 242",
