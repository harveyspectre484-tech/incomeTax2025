{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "341",
      "id": "341",
      "title": "Application of income.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "341-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The following sums shall be allowed as application of income to a registered non-profit organisation:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "341-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any sum, other than the sum referred to in clause (b), applied by it for charitable or religious purpose in India for which it is registered where such sum is paid during the tax year provided that the provisions of section 35(b)(i) and section 36(4), (5), (6) and (7) shall apply in respect of such sum; and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-341-1-a-001",
                  "target_id": "35-b-i",
                  "target_type": "subclause",
                  "anchor_text": "section 35(b)(i) and section",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-341-1-a-002",
                  "target_id": "341-1-b",
                  "target_type": "clause",
                  "anchor_text": "clause (b)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "341-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "85% of the sum paid by way of donation made to any other registered non-profit organisation.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "341-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The application of income under sub-section (1) shall include the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "341-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount invested or deposited back during the tax year, in the modes permitted under section 350 maintained specifically for such corpus, if—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "341-2-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such investment or depositing back is made within five years from the end of the tax year in which such application of income was made from the corpus; and"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "341-2-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the application of income from the corpus is made after the 31st March, 2021 and there was no violation of any provision of this Part, or any corresponding provision of the Income-tax Act, 1961 (43 of 1961) with respect to such application;"
                }
              ],
              "references": [
                {
                  "reference_id": "ref-341-2-a-001",
                  "target_id": "350",
                  "target_type": "section",
                  "anchor_text": "section 350",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "341-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount repaid, during the tax year, towards any loan or borrowing where,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "341-2-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such repayment is within five years from the end of the tax year in which such application of income was made from the loan or borrowing; and"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "341-2-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the application of income from the loan or borrowing is made after the 31st March, 2021 and there was no violation of any provision of this Part, or any corresponding provision of the Income-tax Act, 1961 (43 of 1961) with respect to such application."
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-2-001",
              "target_id": "341-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "341-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The following claims shall not be allowed as application of income under sub-sections (1) and (2):—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "341-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the deduction or allowance by way of depreciation or otherwise claimed in respect of an asset acquisition of which has been claimed as an application of income in the same or any other tax year under this Part or under any corresponding provision of the Income-tax Act, 1961 (43 of 1961); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "341-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a claim of set off or deduction or allowance of any excess application of any of the years preceding the tax year; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "341-3-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any sum paid as a corpus donation to any other registered non-profit organisation.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-3-001",
              "target_id": "341-1",
              "target_type": "subsection",
              "anchor_text": "sub-sections (1) and (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "341-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An application from corpus, loan or borrowing, accumulated income, specified income or deemed accumulated income shall not be considered as application for the purpose of sub-sections (1) and (2).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-4-001",
              "target_id": "341-1",
              "target_type": "subsection",
              "anchor_text": "sub-sections (1) and (2)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "341-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where, in a tax year, the regular income applied by a registered non-profit organisation towards charitable or religious purposes in India, as per the provisions of sub-sections (1) to (4), is less than 85% of regular income, the shortfall, or any part thereof, at the option of the registered non-profit organisation, may be treated as deemed application.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-5-001",
              "target_id": "341-1",
              "target_type": "subsection",
              "anchor_text": "sub-sections (1) to (4)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "341-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any deemed application under sub-section (5) shall be applied by the registered non-profit organisation for its objects in India,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "341-6-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "during the tax year in which the income is received or in the tax year immediately succeeding such tax year, where such shortfall is for the reason that the whole or any part of the income has not been received during that tax year;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "341-6-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in the tax year immediately succeeding the tax year in which the income was derived, where such shortfall is for any other reason.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-6-001",
              "target_id": "341-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "341-7",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The option under sub-section (5) shall be exercised on or before the due date specified in section 263(1) for furnishing the return of income for such tax year, in such form and manner, as may be prescribed.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-7-001",
              "target_id": "341-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-341-7-002",
              "target_id": "263-1",
              "target_type": "subsection",
              "anchor_text": "section 263(1)",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "341-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The application of income under sub-section (1) shall include deemed application under sub-section (5).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-8-001",
              "target_id": "341-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-341-8-002",
              "target_id": "341-5",
              "target_type": "subsection",
              "anchor_text": "sub-section (5)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "341-9",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Following income from capital gains shall be deemed as application of income—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "341-9-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the capital gain from transfer of a capital asset, being property held under trust wholly for charitable or religious purposes, where the whole or any part of the net consideration is utilised for acquiring another capital asset to be so held,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "341-9-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if the whole of the net consideration is utilised in acquiring the new capital asset, the whole of such capital gain;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "341-9-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if only a part of the net consideration is utilised for acquiring the new capital asset, so much of such capital gain as is equal to the amount, if any, by which the amount so utilised exceeds the cost of the transferred asset;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "341-9-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the appropriate fraction of the capital gain arising from the transfer of a capital asset, being property held under trust in part for charitable or religious purposes, where the whole or any part of the net consideration is utilised for acquiring another capital asset to be so held,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "341-9-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "if the cost of acquisition of the new capital asset acquired is not less than the net consideration in respect of the capital asset transferred, the whole of appropriate fraction of such capital gain;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "341-9-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "in any other case, so much of the appropriate fraction of the capital gain as is equal to the amount, if any, by which the appropriate fraction of the amount utilised for acquiring the new asset exceeds the appropriate fraction of the cost of the transferred asset."
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "341-10",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (9),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "341-10-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"appropriate fraction\" means the fraction which represents the extent to which the income derived from the capital asset transferred was immediately before such transfer applicable to charitable or religious purpose;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "341-10-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"cost of transferred asset\" means the aggregate of the cost of acquisition (as ascertained for the purposes of sections 72 and 73) of the capital asset which is subject of the transfer and the cost of any improvement thereto within the meaning assigned to that expression in section 90(1)(b);",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-341-10-b-001",
                  "target_id": "72",
                  "target_type": "section",
                  "anchor_text": "sections 72 and 73)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-341-10-b-002",
                  "target_id": "90-1-b",
                  "target_type": "clause",
                  "anchor_text": "section 90(1)(b)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "341-10-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"net consideration\" means the full value of the consideration received or accruing as a result of the transfer of the capital asset as reduced by any expenditure incurred wholly and exclusively in connection with such transfer.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-341-10-001",
              "target_id": "341-9",
              "target_type": "subsection",
              "anchor_text": "sub-section (9)",
              "relationship": "definition_or_scope",
              "confidence": "high"
            }
          ]
        }
      ],
