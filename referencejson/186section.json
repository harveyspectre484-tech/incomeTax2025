      "type": "section",
      "number": "186",
      "id": "186",
      "title": "Mode of undertaking transactions.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "186-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No person shall receive an amount of Rs. 200000 or more—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "186-1-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "in aggregate from a person in a day; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "186-1-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of a single transaction; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "186-1-c",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "in respect of transactions relating to one event or occasion from a person, except through—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "186-1-c-i",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an account payee cheque; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "186-1-c-ii",
                  "indent": 0,
                  "line_start": 12,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "account payee bank draft; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "186-1-c-iii",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "electronic clearing system through a bank account; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "186-1-c-iv",
                  "indent": 0,
                  "line_start": 14,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other electronic mode, as may be prescribed.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "186-2",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Sub-section (1) shall not apply to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "186-2-a",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "any receipt by Government, any banking company, post office savings bank or co-operative bank;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "186-2-b",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "transactions of the nature referred to in section 185;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-186-2-b-001",
                  "target_id": "185",
                  "target_type": "section",
                  "anchor_text": "section 185",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "186-2-c",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "such other persons or class of persons or receipts, as may be notified by the Central Government.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-186-2-001",
