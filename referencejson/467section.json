            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "467-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If a person referred to in section 262(9)(b) responsible for ensuring the correct quoting or authentication of Permanent Account Number or Aadhaar number, in documents relating to transactions prescribed under section 262(9)(a) fails to do so, the Assessing Officer may impose a penalty of Rs. 10000 on him for each such default.",
