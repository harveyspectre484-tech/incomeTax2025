          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If a person fails to comply with the provisions of section 262, the Assessing Officer may impose a penalty of Rs. 10000 on him.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-467-1-001",
              "target_id": "262",
              "target_type": "section",
              "anchor_text": "section 262",
              "relationship": "related_to",
