      "id": "463",
      "title": "Penalty for furnishing incorrect information in reports or certificates.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "463-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any accountant or merchant banker or registered valuer, shall be liable to pay a penalty of Rs. 10000 for any incorrect information in any report or certificate furnished under any provision of this Act or the rules made thereunder.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "463-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The penalty under sub-section (1) shall be payable for each such report or certificate.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-463-2-001",
              "target_id": "463-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "463-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The penalty under sub-section (1) shall be payable on directions of the Assessing Officer or the Joint Commissioner (Appeals) or the Commissioner (Appeals) where the incorrect information mentioned in sub-section (1) is found by such authority in the course of any proceedings under this Act.",
          "clauses": [],
          "text_after_clauses": "",
