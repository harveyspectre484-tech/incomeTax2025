  "sections": [
    {
      "type": "section",
      "number": "465",
      "id": "465",
      "title": "Penalty for failure to answer questions, sign statements, furnish information, returns or statements, allow inspections, etc.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "465-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "A person shall be liable to pay a penalty of Rs. 10000 for each default or failure as mentioned below, if that person,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "465-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "being legally bound to state the truth of any matter touching the subject of his assessment, refuses to answer any question put to him by an income-tax authority in the exercise of its powers under this Act; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "465-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "refuses to sign any statement made by him in the course of any proceedings under this Act, which an income-tax authority may legally require him to sign; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "465-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "to whom a summons is issued under section 246(1), either to attend to give evidence or to produce books of account or other documents at a certain place and time omits to attend or produce books of account or documents at the place or time; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-1-c-001",
                  "target_id": "246-1",
                  "target_type": "subsection",
                  "anchor_text": "section 246(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "465-1-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "fails to comply with a notice under section 268(1) or 270(8) or fails to comply with a direction issued under section 268(5).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-1-d-001",
                  "target_id": "268-1",
                  "target_type": "subsection",
                  "anchor_text": "section 268(1) or 270",
                  "relationship": "depends_on",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-465-1-d-002",
                  "target_id": "268-5",
                  "target_type": "subsection",
                  "anchor_text": "section 268(5)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "465-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "A person shall be liable to pay a penalty of Rs. 500 for every day during which the following failures continue, if that person fails to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "465-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "comply with a notice under section 175(7); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-a-001",
                  "target_id": "175-7",
                  "target_type": "subsection",
                  "anchor_text": "section 175(7)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "465-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "give the notice of discontinuance of his business or profession as required by section 320(3); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-b-001",
                  "target_id": "320-3",
                  "target_type": "subsection",
                  "anchor_text": "section 320(3)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "465-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "furnish in due time any of the returns, statements or particulars mentioned in section 252 or 397(3) or 507; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-c-001",
                  "target_id": "252",
                  "target_type": "section",
                  "anchor_text": "section 252 or 397",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "465-2-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "allow inspection of any register referred to in section 255 or of any entry in such register or to allow copies of such register or of any entry therein to be taken; or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-d-001",
                  "target_id": "255",
                  "target_type": "section",
                  "anchor_text": "section 255 or of",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "e",
              "id": "465-2-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "furnish the return of income as required under section 263(1)(a)(iii)",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "465-2-e-iv",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "or to furnish it within the time allowed and, in the manner, required under section 263(1) and (2); or"
                }
              ],
              "references": [
                {
                  "reference_id": "ref-465-2-e-001",
                  "target_id": "263-1-a-iii",
                  "target_type": "subclause",
                  "anchor_text": "section 263(1)(a)(iii)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
