                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "l",
              "id": "465-2-l",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deliver or cause to be delivered a statement within the time as may be prescribed under section 397(3)(e); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-l-001",
                  "target_id": "397-3-e",
                  "target_type": "clause",
                  "anchor_text": "section 397(3)(e)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
