              "type": "clause",
              "number": "f",
              "id": "465-2-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deliver or cause to be delivered in due time a copy of the declaration required under section 393(7); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-f-001",
                  "target_id": "393-7",
                  "target_type": "subsection",
                  "anchor_text": "section 393(7)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
