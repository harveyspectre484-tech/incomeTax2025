              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deliver or cause to be delivered the statement within the time specified in section 397(3)(b); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-k-001",
                  "target_id": "397-3-b",
                  "target_type": "clause",
                  "anchor_text": "section 397(3)(b)",
