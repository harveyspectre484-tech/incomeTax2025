              "id": "465-2-g",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "furnish a certificate under section 395(4); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-g-001",
                  "target_id": "395-4",
                  "target_type": "subsection",
                  "anchor_text": "section 395(4)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "h",
              "id": "465-2-h",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deduct and pay tax under section 416(3); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-h-001",
                  "target_id": "416-3",
                  "target_type": "subsection",
                  "anchor_text": "section 416(3)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "i",
              "id": "465-2-i",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "furnish a statement under section 392(5)(a); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-i-001",
                  "target_id": "392-5-a",
                  "target_type": "clause",
                  "anchor_text": "section 392(5)(a)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "j",
              "id": "465-2-j",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deliver or cause to be delivered in due time a copy of the declaration required under section 394(3); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-465-2-j-001",
                  "target_id": "394-3",
                  "target_type": "subsection",
