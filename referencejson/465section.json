              "id": "465-2-m",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deliver or cause to be delivered a statement within the time as may be prescribed under section 397(3)(g)(i).",
              "children": [],
