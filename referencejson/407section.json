                  "target_type": "section",
                  "anchor_text": "section 405",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-407-4-b-004",
                  "target_id": "408",
                  "target_type": "section",
                  "anchor_text": "section 408",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-407-4-001",
              "target_id": "407-1",
              "target_type": "subsection",
