{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "165",
      "id": "165",
      "title": "Determination of arm's length price.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "165-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The arm's length price in relation to an international transaction or specified domestic transaction shall be determined by any of the following methods, being the most appropriate method—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "165-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "comparable uncontrolled price method;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "165-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "resale price method;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "165-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "cost plus method;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "165-1-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "profit split method;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "165-1-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "transactional net margin method;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "165-1-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such other method as may be prescribed by the Board.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "165-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The most appropriate method referred to in sub-section (1) shall be,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "165-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "selected having regard to the nature of transaction or class of transaction or class of associated enterprise or functions performed by such enterprises or such other relevant factors as the Board may prescribe;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "165-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "applied for determination of arm's length price in such manner as may be prescribed.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-165-2-001",
              "target_id": "165-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "165-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The arm's length price shall be—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "165-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in case, only one price is determined by the most appropriate method,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "165-3-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the price determined by that method; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "165-3-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the price at which the international transaction or specified domestic transaction has actually been undertaken, if the variation between the arm's length price so determined and price at which the international transaction or specified domestic transaction has actually been undertaken does not exceed such percentage not exceeding 3% of the latter, notified by the Central Government in this behalf; or"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "165-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in case, more than one price is determined by the most appropriate method, the price determined in such manner as may be prescribed.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "165-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer, during the course of any proceeding for the assessment of income, may proceed to determine the arm's length price in relation to an international transaction or specified domestic transaction as per sub-sections (1), (2) and (3) if, on the basis of material or information or document in his possession, he is of the opinion that—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "165-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the price charged or paid in an international transaction or specified domestic transaction has not been determined as per sub-sections (1), (2) and (3); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-165-4-a-001",
                  "target_id": "165-1",
                  "target_type": "subsection",
                  "anchor_text": "sub-sections (1)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "165-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any information and document relating to an international transaction or specified domestic transaction has not been kept and maintained by the assessee as per section 171(1); or",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-165-4-b-001",
                  "target_id": "171-1",
                  "target_type": "subsection",
                  "anchor_text": "section 171(1)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "165-4-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the information or data used in determination of the arm's length price by the assessee is not reliable or correct; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "165-4-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the assessee has failed to furnish, within the specified time, any information or document which he was required to furnish by a notice issued under section 171(2) and (3).",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-165-4-d-001",
                  "target_id": "171-2",
                  "target_type": "subsection",
                  "anchor_text": "section 171(2) and (3)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-165-4-001",
              "target_id": "165-1",
              "target_type": "subsection",
              "anchor_text": "sub-sections (1)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "165-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer, before determining the arm's length price under sub-section (4), shall issue a notice calling upon the assessee to show cause, on the date and time to be specified in the notice, why the arm's length price should not be determined on the basis of material or information or document in the possession of the Assessing Officer.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-165-5-001",
              "target_id": "165-4",
              "target_type": "subsection",
              "anchor_text": "sub-section (4)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "165-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Assessing Officer, on determination of arm's length price under sub-section (4), may compute the total income of the assessee having regard to the arm's length price so determined.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-165-6-001",
              "target_id": "165-4",
              "target_type": "subsection",
              "anchor_text": "sub-section (4)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "165-7",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No deduction shall be allowed 21[] under Chapter VIII in respect of income by which the total income of the assessee is enhanced after computation of income under sub-section (6).",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-165-7-001",
              "target_id": "165-6",
              "target_type": "subsection",
              "anchor_text": "sub-section (6)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "165-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "When the total income of an associated enterprise is computed under sub-section (6) on determination of the arm's length price paid to another associated enterprise from which tax has been deducted or was deductible under the provisions of Chapter XIX-B, the income of the other associated enterprise shall not be recomputed by reason of such determination of arm's length price in the case of the first mentioned enterprise.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-165-8-001",
              "target_id": "165-6",
              "target_type": "subsection",
              "anchor_text": "sub-section (6)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        }
      ],
      "text_after_subsections": ""
    }
  ],
