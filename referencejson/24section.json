      "id": "24",
      "title": "Property owned by co-owners.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "24-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "For property co-owned with definite and ascertainable share, the co-owners shall not be assessed as an association of persons and their income computed separately under this Part as per their respective share shall be included in their total income.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "24-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "The relief available under section 21(6) shall be provided as if each co-owner is individually entitled to the said relief.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-24-2-001",
              "target_id": "21-6",
