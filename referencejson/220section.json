        },
        {
          "type": "subsection",
          "number": "4",
          "id": "220-4",
          "indent": 0,
          "line_start": 17,
          "page_start": 1,
          "page_end": 1,
          "text": "Every notification issued under this section shall be laid before each House of Parliament.",
          "children": []
        }
