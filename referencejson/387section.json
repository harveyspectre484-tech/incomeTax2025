      "id": "387",
      "title": "Powers of the Board for Advance Rulings.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "387-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "The Board for Advance Rulings shall, for the purpose of exercising its powers, have all the powers of a civil court under the Code of Civil Procedure, 1908 (5 of 1908) as are referred to in section 246 of this Act.",
          "children": [],
          "references": [
            {
              "reference_id": "ref-387-1-001",
              "target_id": "246",
              "target_type": "section",
              "anchor_text": "section 246",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "387-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "The Board for Advance Rulings shall be deemed to be a civil court for the purposes of section 215 but not for the purposes of Chapter XXVIII of the Bharatiya Nagarik Suraksha Sanhita, 2023 (46 of 2023) and every proceeding before the Board for Advance Rulings shall be deemed to be a judicial proceeding under sections 229 and 267 and for the purposes of section 233 of the Bharatiya Nyaya Sanhita, 2023 (45 of 2023).",
          "children": [],
          "references": [
