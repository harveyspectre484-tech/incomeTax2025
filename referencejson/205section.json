        },
        {
          "type": "subsection",
          "number": "2",
          "id": "205-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of section 201 or 204, the following conditions shall apply to the assessee:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "205-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "its business is not formed by splitting up, or the reconstruction, of a business already in existence, unless it is formed as a result of the reestablishment, reconstruction or revival of the business of any such undertaking as is referred to in section 140(4) in the circumstances and within the period specified in the said section;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-205-2-a-001",
                  "target_id": "140-4",
                  "target_type": "subsection",
                  "anchor_text": "section 140(4)",
                  "relationship": "related_to",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "205-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "it does not use any machinery or plant, previously used for any purpose, other than—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "205-2-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "permitted machinery or plant used outside India;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "205-2-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "machinery or plant or any part thereof previously used for any purpose and the total value of such machinery or plant or any part thereof put to use by the assessee does not exceed 20% of the total value of the machinery or plant used by such assessee;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "c",
              "id": "205-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in case of a domestic company, it does not use any building previously used as a hotel or a convention centre, in respect of which deduction under section 80-ID of the Income-tax Act, 1961 (43 of 1961) has been claimed and allowed;",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-205-2-c-001",
                  "target_id": "80",
                  "target_type": "section",
                  "anchor_text": "section 80-ID",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "d",
              "id": "205-2-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "it is not engaged in any business other than the business of manufacture or production of any article or thing and research in relation to, or distribution of, such article or thing manufactured or produced by it, and, if any difficulty arises in fulfilling any of the conditions contained in clause (b) or (c) or (d), the Board may, with the previous approval of the Central Government, issue guidelines for the purpose of removing the difficulty and to promote manufacturing or production of article or thing using new plant and machinery.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-205-2-d-001",
                  "target_id": "205-2-b",
                  "target_type": "clause",
                  "anchor_text": "clause (b) or (c)",
                  "relationship": "related_to",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-205-2-001",
              "target_id": "201",
              "target_type": "section",
              "anchor_text": "section 201 or 204",
              "relationship": "definition_or_scope",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "205-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Every guideline issued by the Board under sub-section (2) shall be laid before each House of Parliament while it is in session for a total period of thirty days which may be comprised in one session or in two or more successive sessions, and if, before the expiry of the session immediately following the session or the successive sessions aforesaid, both houses agree in making any modification in such guideline or both Houses agree that the guideline, should not be issued, the guideline shall thereafter have effect only in such modified form or be of no effect, as the case may be; so, however, that any such modification or annulment shall be without prejudice to the validity of anything previously done under that guideline.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-205-3-001",
              "target_id": "205-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "205-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sections 201 and 204,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "205-4-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where it appears to the Assessing Officer that, owing to the close connection between the person to which the said section applies and any other person, or for any other reason, the course of business between them is so arranged that the business transacted between them produces to the assessee more than the ordinary profits which might be expected to arise in such business, then the Assessing Officer shall, in computing the profits and gains of such business for the purposes of this section, take profits as may be reasonably deemed to have been derived therefrom, and where the said arrangement involves a specified domestic transaction referred to in section 164, profits from such transaction shall be determined having regard to the arm's length price as defined in section 173(a); and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-205-4-a-001",
                  "target_id": "164",
                  "target_type": "section",
                  "anchor_text": "section 164",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-205-4-a-002",
                  "target_id": "173-a",
                  "target_type": "clause",
                  "anchor_text": "section 173(a)",
                  "relationship": "definition_reference",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "205-4-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the amount, being profits in excess of the profits determined by the Assessing Officer under clause (a), shall be deemed to be the income of the person and shall be chargeable at the rates specified in section 201(1) [Table: Sl. No. 1.C(d)] or 204(1) [Table: Sl. No. 1.A(d)], as the case may be.",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-205-4-b-001",
                  "target_id": "201-1",
                  "target_type": "subsection",
                  "anchor_text": "section 201(1)",
                  "relationship": "related_to",
                  "confidence": "medium"
                },
                {
                  "reference_id": "ref-205-4-b-002",
                  "target_id": "205-4-a",
                  "target_type": "clause",
                  "anchor_text": "clause (a)",
                  "relationship": "depends_on",
                  "confidence": "high"
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-205-4-001",
              "target_id": "201",
              "target_type": "section",
              "anchor_text": "sections 201 and 204",
              "relationship": "definition_or_scope",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "205-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this Part,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "205-5-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the business of manufacture or production of any article or thing shall include the business of generation of electricity but shall not include business of—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "205-5-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "development of computer software in any form or in any media; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "205-5-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "mining; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "205-5-a-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "conversion of marble blocks or similar items into slabs; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "205-5-a-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "bottling of gas into cylinder; or"
                },
                {
                  "type": "sub-clause",
                  "number": "v",
                  "id": "205-5-a-v",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "printing of books or production of cinematograph film; or"
                },
                {
                  "type": "sub-clause",
                  "number": "vi",
                  "id": "205-5-a-vi",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other business as may be notified by the Central Government in this behalf; and"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "205-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the expressions,—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "205-5-b-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"hotel\" and \"convention centre\" shall have the meanings respectively assigned to them in clause (b) and clause (a) of section 80-ID(6) of the Income-tax Act, 1961 (43 of 1961);"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "205-5-b-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"permitted machinery and plant used outside India\" means the machinery or plant, which was previously used outside India by any other person, if the following conditions are fulfilled:—"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "205-5-b-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"unabsorbed depreciation\" shall have the meaning assigned to it in section 116(13)(e); and"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "205-5-b-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "\"Unit\" shall have the same meaning as assigned to it in section 2(zc) of the Special Economic Zones Act, 2005 (28 of 2005)."
                }
              ]
            }
          ],
          "text_after_clauses": ""
        }
      ],
