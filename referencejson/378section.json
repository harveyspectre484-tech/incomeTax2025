{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "378",
      "id": "378",
      "title": "Revision of other orders.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "378-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Competent Authority may, for any order, other than an order to which section 377 applies, passed by an authority subordinate to him, either of his own motion or on an application by the assessee for revision,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "378-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "call for the record of any proceeding under this Act in which any such order has been passed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "378-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "make such inquiry or cause such inquiry to be made; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "378-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "subject to the provisions of this Act, pass such order thereon, not being an order prejudicial to the assessee, as he thinks fit.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-378-1-001",
              "target_id": "377",
              "target_type": "section",
              "anchor_text": "section 377",
              "relationship": "related_to",
              "confidence": "medium"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "378-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Competent Authority shall not of his own motion revise any order under this section if the order has been made more than one year previously.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "378-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "An application for revision under this section shall be made by the assessee, within one year from the date on which the order in question was communicated to him or the date on which he otherwise came to know of it, whichever is earlier.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "378-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Competent Authority may, if he is satisfied that the assessee was prevented by sufficient cause from making the application within the period as provided in sub-section (3), admit an application made after the expiry of the period specified in that sub-section.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-378-4-001",
              "target_id": "378-3",
              "target_type": "subsection",
              "anchor_text": "sub-section (3)",
              "relationship": "procedure_reference",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "378-5",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Competent Authority shall not revise any order under this section in the following cases:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "378-5-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where an appeal against the order lies to the Joint Commissioner (Appeals) or the Commissioner (Appeals) or to the Appellate Tribunal, but has not been made and the time within which such appeal may be made has not expired;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "378-5-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where the appeal lies to the Joint Commissioner (Appeals) or the Commissioner (Appeals) or to the Appellate Tribunal, the assessee has not waived his right of appeal; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "378-5-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "where the order has been made the subject of an appeal to the Joint Commissioner (Appeals) or the Commissioner (Appeals) or to the Appellate Tribunal.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "6",
          "id": "378-6",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Every application by an assessee for revision under this section shall be accompanied by a fee of Rs. 500.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "7",
          "id": "378-7",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "On every application by an assessee for revision under this section, an order shall be passed within one year from the end of the financial year in which such application is made.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "8",
          "id": "378-8",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In computing the period of limitation under sub-section (7), the following period shall be excluded:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "378-8-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the time taken in giving an opportunity to the assessee to be reheard under section 244(2); and",
              "children": [],
              "references": [
                {
                  "reference_id": "ref-378-8-a-001",
                  "target_id": "244-2",
                  "target_type": "subsection",
                  "anchor_text": "section 244(2)",
                  "relationship": "depends_on",
                  "confidence": "medium"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "378-8-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the period commencing on the date on which stay on any proceeding under this section has been granted by an order or injunction of any court and ending on the date on which certified copy of the order or injunction vacating the stay is received by the jurisdictional Principal Commissioner or Commissioner.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-378-8-001",
              "target_id": "378-7",
              "target_type": "subsection",
              "anchor_text": "sub-section (7)",
              "relationship": "depends_on",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "9",
          "id": "378-9",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If after the exclusion of the period provided in sub-section (8), the time limit for completion as provided in sub-section (7) is less than sixty days, such remaining period shall be extended to sixty days and such period of limitation shall be deemed to have been extended accordingly.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-378-9-001",
              "target_id": "378-8",
              "target_type": "subsection",
              "anchor_text": "sub-section (8)",
              "relationship": "procedure_reference",
              "confidence": "high"
            },
            {
              "reference_id": "ref-378-9-002",
              "target_id": "378-7",
              "target_type": "subsection",
              "anchor_text": "sub-section (7)",
              "relationship": "procedure_reference",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "10",
          "id": "378-10",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in sub-section (7), an order in revision under that sub-section may be passed at any time in consequence of or to give effect to any finding or direction contained in an order of the Appellate Tribunal, the High Court or the Supreme Court.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-378-10-001",
              "target_id": "378-7",
              "target_type": "subsection",
              "anchor_text": "sub-section (7)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "11",
          "id": "378-11",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "378-11-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"Competent Authority\" means the Principal Chief Commissioner or Chief Commissioner or Principal Commissioner or Commissioner;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "378-11-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "an order by the Competent Authority declining to interfere shall, not be deemed to be an order prejudicial to the assessee.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}