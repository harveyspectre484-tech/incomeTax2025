{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "532",
      "id": "532",
      "title": "Power to frame schemes.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "532-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Central Government may, by notification, make a scheme for any of the purposes of this Act, so as to impart greater efficiency, transparency and accountability by—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "532-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "eliminating the interface with the assessee or any other person to the extent technologically feasible;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "532-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "optimising utilisation of the resources through economies of scale and functional specialisation.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "532-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The Central Government may, for the purposes of giving effect to the scheme made under sub-section (1), by notification, direct that any of the provisions of this Act shall not apply or shall apply with such exceptions, modifications and adaptations as specified in the notification.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-532-2-001",
              "target_id": "532-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "exception_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "532-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Where a scheme has been notified under the provisions of the Income-tax Act, 1961 (43 of 1961) with a view to eliminating the interface with the assessee or any other person, the Central Government may, by notification, amend or modify the said scheme as per the provisions of sub-section (1), and the provisions of sub-section (2) shall apply accordingly.",
          "clauses": [],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-532-3-001",
              "target_id": "532-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "depends_on",
              "confidence": "high"
            },
            {
              "reference_id": "ref-532-3-002",
              "target_id": "532-2",
              "target_type": "subsection",
              "anchor_text": "sub-section (2)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "532-4",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Every notification issued under sub-sections (1), (2) and (3) shall, as soon as may be after the notification is issued, be laid before each House of Parliament.",
