{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "181",
      "id": "181",
      "title": "Consequences of impermissible avoidance arrangement.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "181-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "If an arrangement is declared to be an impermissible avoidance arrangement, then, the consequences, in relation to tax, of the arrangement, including denial of tax benefit or a benefit under a tax treaty, shall be determined, in the manner as deemed appropriate in the circumstances of the case.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "181-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The consequences of an arrangement declared to be an impermissible avoidance arrangement as referred to in sub-section (1) shall include but shall not be limited to the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "181-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "disregarding, combining or recharacterising any step in, or a part or whole of, the impermissible avoidance arrangement;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "181-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "treating the impermissible avoidance arrangement as if it had not been entered into or carried out;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "181-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "disregarding any accommodating party or treating any accommodating party and any other party as one and the same person;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "181-2-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "deeming persons who are connected persons in relation to each other to be one and the same person for the purposes of determining tax treatment of any amount;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "181-2-e",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "reallocating amongst the parties to the arrangement—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "181-2-e-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any accrual, or receipt, of a capital nature or revenue nature; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "181-2-e-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any expenditure, deduction, relief or rebate;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "f",
              "id": "181-2-f",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "treating—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "181-2-f-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the place of residence of any party to the arrangement; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "181-2-f-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the situs of an asset or of a transaction, at a place other than the place of residence, location of the asset or location of the transaction as provided under the arrangement; or (g) considering or looking through any arrangement by disregarding any corporate structure."
                }
              ]
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-181-2-001",
              "target_id": "181-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "181-3",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "181-3-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any equity may be treated as debt or vice versa;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "181-3-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any accrual, or receipt, of a capital nature may be treated as of revenue nature or vice versa; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "181-3-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "any expenditure, deduction, relief or rebate may be recharacterised.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}