{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "181",
      "id": "181",
      "title": "Consequences of impermissible avoidance arrangement.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "181-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "If an arrangement is declared to be an impermissible avoidance arrangement, then, the consequences, in relation to tax, of the arrangement, including denial of tax benefit or a benefit under a tax treaty, shall be determined, in the manner as deemed appropriate in the circumstances of the case.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "181-2",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The consequences of an arrangement declared to be an impermissible avoidance arrangement as referred to in sub-section (1) shall include but shall not be limited to the following:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "181-2-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "disregarding, combining or recharacterising any step in, or a part or whole of, the impermissible avoidance arrangement;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "181-2-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "treating the impermissible avoidance arrangement as if it had not been entered into or carried out;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "181-2-c",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text": "disregarding any accommodating party or treating any accommodating party and any other party as one and the same person;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "181-2-d",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "deeming persons who are connected persons in relation to each other to be one and the same person for the purposes of determining tax treatment of any amount;",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "181-2-e",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "reallocating amongst the parties to the arrangement—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "181-2-e-i",
                  "indent": 0,
                  "line_start": 12,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any accrual, or receipt, of a capital nature or revenue nature; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "181-2-e-ii",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any expenditure, deduction, relief or rebate;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "f",
              "id": "181-2-f",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "treating—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "181-2-f-i",
                  "indent": 0,
                  "line_start": 15,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the place of residence of any party to the arrangement; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "181-2-f-ii",
                  "indent": 0,
                  "line_start": 16,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the situs of an asset or of a transaction, at a place other than the place of residence, location of the asset or location of the transaction as provided under the arrangement; or (g) considering or looking through any arrangement by disregarding any corporate structure.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": "",
          "references": [
            {
              "reference_id": "ref-181-2-001",
              "target_id": "181-1",
              "target_type": "subsection",
              "anchor_text": "sub-section (1)",
              "relationship": "related_to",
              "confidence": "high"
            }
          ]
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "181-3",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "181-3-a",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "any equity may be treated as debt or vice versa;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "181-3-b",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "any accrual, or receipt, of a capital nature may be treated as of revenue nature or vice versa; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "181-3-c",
              "indent": 0,
              "line_start": 21,
              "page_start": 1,
              "page_end": 1,
              "text": "any expenditure, deduction, relief or rebate may be recharacterised.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": [
    {
      "page": 1,
      "line": 2,
      "text": "Ministry of Finance, Government of India"
    }
  ]
}