          "id": "513-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Any assessee, entitled or required to attend before any income-tax authority or the Appellate Tribunal in matters relating to the valuation of any asset, may attend through a registered valuer.",
          "clauses": [],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "513-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The provisions of sub-section (1) shall not apply, where the assessee is required to attend personally for examination on oath or affirmation under section 246.",
          "clauses": [],
          "text_after_clauses": "",
