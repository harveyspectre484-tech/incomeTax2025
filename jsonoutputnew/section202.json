                  }
                ],
                "linearized_text": "Clause (e): an artificial juridical person referred to in section 2(77)(g), Table items: Item 1 — Sl. No. Total income A B: Upto Rs. 400000; Rate of tax C: Nil. Item 2 — Sl. No. Total income A B: From Rs. 400001 to Rs. 800000; Rate of tax C: 5%. Item 3 — Sl. No. Total income A B: From Rs. 800001 to Rs. 1200000; Rate of tax C: 10%. Item 4 — Sl. No. Total income A B: From Rs. 1200001 to Rs. 1600000; Rate of tax C: 15%. Item 5 — Sl. No. Total income A B: From Rs. 1600001 to Rs. 2000000; Rate of tax C: 20%. Item 6 — Sl. No. Total income A B: From Rs. 2000001 to Rs. 2400000; Rate of tax C: 25%. Item 7 — Sl. No. Total income A B: Above Rs. 2400000; Rate of tax C: 30%.",
                "source": {
                  "act": "Income-tax Act",
                  "rule": "202-1-e",
                  "page_start": 1,
                  "page_end": 1,
                  "x": 41.27,
                  "y_start": 150.6
                }
              }
            }
          ],
          "text_after_clauses": "in respect of the total income for a tax year, shall, unless the person exercises the option in the manner provided under sub-section (4), be computed at the rate of tax given in the following Table:—"
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "202-2",
          "x": 27.62,
          "y_start": 337.31,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (1), the total income of the assessee shall be computed—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "202-2-a",
              "x": 40.8,
              "y_start": 352.17,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "without any exemption or deduction under—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "202-2-a-i",
                  "x": 71.75,
                  "y_start": 362.77,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Schedule III (Table: Sl. No. 5 or 6 or 7 or 8 or 11 or 17);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "202-2-a-ii",
                  "x": 69.33,
                  "y_start": 373.38,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Schedule III (Table: Sl. No. 12 or 13) (other than those as may be prescribed for this purpose);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "202-2-a-iii",
                  "x": 66.91,
                  "y_start": 381.54,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "^2^5[***]",
                  "children": []
