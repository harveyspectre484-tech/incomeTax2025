                  "number": "viii",
                  "id": "202-2-a-viii",
                  "x": 63.09,
                  "y_start": 437.03,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 49;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ix",
                  "id": "202-2-a-ix",
                  "x": 67.93,
                  "y_start": 447.64,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 45(3)(a) or (b) or (c);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "x",
                  "id": "202-2-a-x",
                  "x": 70.35,
                  "y_start": 458.25,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 46;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "xi",
                  "id": "202-2-a-xi",
                  "x": 67.93,
                  "y_start": 468.86,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 47(1)(a); and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "xii",
                  "id": "202-2-a-xii",
                  "x": 65.51,
                  "y_start": 479.47,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "Chapter VIII other than the provisions of section 124(1) and 124(2), or 125(2) or 146; and",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "202-2-b",
              "x": 40.8,
              "y_start": 490.08,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "without set off of—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "202-2-b-i",
                  "x": 71.75,
                  "y_start": 500.69,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any loss carried forward or depreciation from any earlier tax year, if such loss or depreciation is attributable to any of the deductions referred to in clause (a); or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "202-2-b-ii",
                  "x": 69.33,
                  "y_start": 520.84,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any loss under the head \"Income from house property\" with any other head of income; and",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "202-2-c",
              "x": 41.27,
              "y_start": 531.45,
              "page_start": 1,
              "page_end": 1,
              "text": "without any exemption or deduction for allowances or perquisite, called by any name, provided under any other law in force.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "202-3",
          "x": 27.62,
          "y_start": 543.12,
          "page_start": 1,
          "page_end": 1,
          "text": "The loss and depreciation referred to in sub-section (2)(b) shall be deemed to have been given full effect to and no further deduction for such loss or depreciation shall be allowed for any subsequent year.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "202-4",
          "x": 27.62,
          "y_start": 571.23,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Nothing contained in sub-section (1) shall apply to a person, where an option is exercised by such person under this section, in such manner as may be prescribed, for any tax year, and such option is exercised,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "202-4-a",
              "x": 40.8,
              "y_start": 598.28,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "in case of a person having income from business or profession,—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "202-4-a-i",
                  "x": 71.75,
                  "y_start": 608.89,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "on or before the due date specified under section 263(1) for furnishing the returns of income for such tax year;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "202-4-a-ii",
                  "x": 69.33,
                  "y_start": 619.5,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such option, once exercised, shall apply to subsequent tax years;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "202-4-a-iii",
                  "x": 66.91,
                  "y_start": 630.11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such option, once exercised, may be withdrawn only once for a tax year other than the tax year for which it was exercised; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "202-4-a-iv",
                  "x": 67.93,
                  "y_start": 640.72,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "after such withdrawal, the person shall never be eligible to exercise the option under this sub-section, except where such person ceases to have any income from business or profession, and in such a case the option under clause (b) shall be available;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "202-4-b",
              "x": 40.8,
              "y_start": 660.87,
              "page_start": 1,
              "page_end": 1,
              "text": "in case of a person not having income from business or profession, along with the return of income to be furnished under section 263(1) for the tax year.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "202-5",
          "x": 27.62,
          "y_start": 682.09,
          "page_start": 1,
          "page_end": 1,
          "text": "In case of a person, having a Unit in the International Financial Services Centre, the provisions of sub-section (2) shall be modified to the extent that deduction under section 147 shall be available to such Unit subject to fulfilment of the conditions contained in that section. \"(iii) section 144;\"",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
