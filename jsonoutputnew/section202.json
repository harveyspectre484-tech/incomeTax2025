                  "text": "section 33(8);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vii",
                  "id": "202-2-a-vii",
                  "x": 65.51,
                  "y_start": 426.43,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "section 48;",
                  "children": []
                },
                {
