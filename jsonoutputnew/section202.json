      "id": "202",
      "title": "New tax regime for individuals, Hindu undivided family and others.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "202-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything contained in this Act other than Chapter XVII-B but subject to Parts A, B, E and this Part of this Chapter, the income-tax payable by a person, being—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "202-1-a",
              "x": 40.8,
              "y_start": 108.17,
              "page_start": 1,
              "page_end": 1,
              "text": "an individual; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "202-1-b",
              "x": 40.8,
              "y_start": 118.78,
              "page_start": 1,
              "page_end": 1,
              "text": "a Hindu undivided family; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "202-1-c",
              "x": 41.27,
              "y_start": 129.39,
              "page_start": 1,
              "page_end": 1,
              "text": "an association of persons (other than a co-operative society); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "202-1-d",
              "x": 40.8,
              "y_start": 139.99,
              "page_start": 1,
              "page_end": 1,
              "text": "a body of individuals, whether incorporated or not; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "202-1-e",
              "x": 41.27,
              "y_start": 150.6,
              "page_start": 1,
              "page_end": 1,
              "text": "an artificial juridical person referred to in section 2(77)(g),",
              "children": [],
              "table": {
                "type": "table",
                "table_id": "202-1-e-table-1",
                "title": "TABLE",
                "page_start": 1,
                "page_end": 1,
                "columns": [
                  "Sl. No. Total income A B",
                  "Rate of tax C"
                ],
                "rows": [
                  {
                    "item_no": 1,
                    "column_A": "Upto Rs. 400000",
                    "column_B": "Nil"
                  },
                  {
                    "item_no": 2,
