      "type": "section",
      "number": "182",
      "id": "182",
      "title": "Treatment of connected person and accommodating party.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "In this Chapter, in determining whether a tax benefit exists,—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "182-a",
          "x": 40.8,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text": "the parties who are connected persons in relation to each other may be treated as one and the same person;",
          "children": []
        },
        {
          "type": "clause",
          "number": "b",
          "id": "182-b",
          "x": 40.8,
          "y_start": 106.05,
          "page_start": 1,
          "page_end": 1,
          "text": "any accommodating party may be disregarded;",
          "children": []
        },
        {
          "type": "clause",
          "number": "c",
          "id": "182-c",
          "x": 41.27,
          "y_start": 116.66,
          "page_start": 1,
          "page_end": 1,
          "text": "the accommodating party and any other party may be treated as one and the same person;",
          "children": []
        },
        {
          "type": "clause",
          "number": "d",
          "id": "182-d",
          "x": 40.8,
          "y_start": 127.26,
          "page_start": 1,
          "page_end": 1,
          "text": "the arrangement may be considered or looked through by disregarding any corporate structure.",
          "children": []
        }
      ],
      "text_after_clauses": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
