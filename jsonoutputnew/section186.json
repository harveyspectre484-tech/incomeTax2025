{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "186",
      "id": "186",
      "title": "Mode of undertaking transactions.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "186-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "No person shall receive an amount of Rs. 200000 or more—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "186-1-a",
              "x": 40.8,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text": "in aggregate from a person in a day; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "186-1-b",
              "x": 40.8,
              "y_start": 106.05,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of a single transaction; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "186-1-c",
              "x": 41.27,
              "y_start": 116.66,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "in respect of transactions relating to one event or occasion from a person,",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "186-1-c-i",
                  "x": 42.68,
                  "y_start": 142.65,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an account payee cheque; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "186-1-c-ii",
                  "x": 40.26,
                  "y_start": 153.26,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "account payee bank draft; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "186-1-c-iii",
                  "x": 37.84,
                  "y_start": 163.86,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "electronic clearing system through a bank account; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "186-1-c-iv",
                  "x": 38.85,
                  "y_start": 174.47,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other electronic mode, as may be prescribed.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": "except through—"
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "186-2",
          "x": 27.62,
          "y_start": 186.14,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Sub-section (1) shall not apply to—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "186-2-a",
              "x": 40.8,
              "y_start": 200.46,
              "page_start": 1,
              "page_end": 1,
              "text": "any receipt by Government, any banking company, post office savings bank or co-operative bank;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "186-2-b",
              "x": 40.8,
              "y_start": 211.07,
              "page_start": 1,
              "page_end": 1,
              "text": "transactions of the nature referred to in section 185;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "186-2-c",
              "x": 41.27,
              "y_start": 221.68,
              "page_start": 1,
              "page_end": 1,
              "text": "such other persons or class of persons or receipts, as may be notified by the Central Government.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
