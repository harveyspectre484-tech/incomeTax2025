      "type": "section",
      "number": "3",
      "id": "3",
      "title": "Definition of \"tax year\".",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "3-1",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this Act, \"tax year\" means the twelve months period of the financial year commencing on the 1st April.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "3-2",
          "x": 27.62,
          "y_start": 96.5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In the case of a business or profession newly set up, or a source of income newly coming into existence in any financial year, the tax year shall be the period beginning with—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "3-2-a",
              "x": 40.8,
              "y_start": 123.55,
              "page_start": 1,
              "page_end": 1,
              "text": "the date of setting up of such business or profession; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "3-2-b",
              "x": 40.8,
              "y_start": 134.16,
              "page_start": 1,
              "page_end": 1,
              "text": "the date on which such source of income newly comes into existence,",
              "children": []
            }
          ],
          "text_after_clauses": "and ending with the said financial year."
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
