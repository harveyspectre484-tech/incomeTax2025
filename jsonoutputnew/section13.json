      "text_before_children": "COMPUTATION OF TOTAL INCOME A.—Heads of income",
      "children": [
        {
          "type": "section",
          "number": "13",
          "id": "13",
          "title": "Heads of income.",
          "x": 27.62,
          "y_start": 127.26,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Save as otherwise provided in this Act, all incomes shall, for the purposes of charge of income-tax and computation of total income, be classified under the following heads of income:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "13-a",
              "x": 40.8,
              "y_start": 154.85,
