              "page_end": 1,
              "text": "Salaries;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "13-b",
              "x": 40.8,
              "y_start": 165.46,
              "page_start": 1,
              "page_end": 1,
              "text": "Income from house property;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "13-c",
              "x": 41.27,
              "y_start": 176.06,
              "page_start": 1,
              "page_end": 1,
              "text": "Profits and gains of business or profession;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "13-d",
              "x": 40.8,
              "y_start": 186.67,
              "page_start": 1,
              "page_end": 1,
              "text": "Capital gains; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "13-e",
              "x": 41.27,
              "y_start": 197.28,
              "page_start": 1,
              "page_end": 1,
              "text": "Income from other sources.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
