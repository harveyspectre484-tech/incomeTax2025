{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "92",
      "id": "92",
      "title": "Income from other sources.",
      "x": 27.62,
      "y_start": 96.5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "92-1",
          "x": 27.62,
          "y_start": 96.5,
          "page_start": 1,
          "page_end": 1,
          "text": "Income of every kind which is not to be excluded from the total income under this Act, shall be chargeable to income-tax under the head \"Income from other sources\", if it is not chargeable to income-tax under any of the heads specified in section 13(a) to (d).",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "92-2",
          "x": 27.62,
          "y_start": 124.61,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In particular, and without prejudice to the generality of the provisions of sub-section (1), the following incomes shall be chargeable to income-tax under the head \"Income from other sources\":—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "92-2-a",
              "x": 40.8,
              "y_start": 151.66,
              "page_start": 1,
              "page_end": 1,
              "text": "any dividend;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "92-2-b",
              "x": 40.8,
              "y_start": 162.27,
              "page_start": 1,
              "page_end": 1,
              "text": "any winning from lotteries, crossword puzzles, races including horse races, card games and other games of any sort or from gambling or betting of any form or nature;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "92-2-c",
              "x": 41.27,
              "y_start": 182.43,
              "page_start": 1,
              "page_end": 1,
              "text": "any sum received by the assessee from employees as contributions to any provident fund, superannuation fund, any fund set up under the Employees' State Insurance Act, 1948 (34 of 1948), or any other fund for the welfare of such employees, if the income is not chargeable to income- tax under the head \"Profits and gains of business or profession\";",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "92-2-d",
              "x": 40.8,
              "y_start": 212.13,
              "page_start": 1,
              "page_end": 1,
              "text": "any sum received under a Keyman insurance policy, as defined in Schedule II (Note 1) including the bonus allocated on such policy, if such income is not chargeable to income-tax under the head \"Profits and gains of business or profession\" or under the head \"Salaries\";",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "92-2-e",
              "x": 41.27,
              "y_start": 232.29,
              "page_start": 1,
              "page_end": 1,
              "text": "any income by way of interest on securities, if the income is not chargeable to income-tax under the head \"Profits and gains of business or profession\";",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "92-2-f",
              "x": 42.68,
              "y_start": 252.45,
              "page_start": 1,
              "page_end": 1,
              "text": "any income from machinery, plant or furniture belonging to the assessee and let on hire, if the income is not chargeable to income-tax under the head \"Profits and gains of business or profession\";",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "92-2-g",
              "x": 40.8,
              "y_start": 272.6,
              "page_start": 1,
              "page_end": 1,
              "text": "any income from letting on hire of machinery, plant or furniture, belonging to the assessee and also buildings, where the letting of the buildings is inseparable from the letting of such machinery, plant or furniture, if the income is not chargeable to income-tax under the head \"Profits and gains of business or profession\";",
              "children": []
            },
            {
              "type": "clause",
              "number": "h",
              "id": "92-2-h",
              "x": 40.8,
              "y_start": 302.31,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any sum of money received as an advance or otherwise during negotiations for the transfer of a capital asset, if—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "92-2-h-i",
                  "x": 71.75,
                  "y_start": 312.91,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such sum is forfeited; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "92-2-h-ii",
                  "x": 69.33,
                  "y_start": 323.52,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the negotiations do not result in transfer of such capital asset;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "92-2-h-i",
                  "x": 42.68,
                  "y_start": 334.13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any income by way of interest received on compensation or on enhanced compensation referred to in section 278(1);",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "j",
              "id": "92-2-j",
              "x": 42.68,
              "y_start": 344.74,
              "page_start": 1,
              "page_end": 1,
              "text": "any compensation or other payment, due to or received by any person, by whatever name called, in connection with the termination of his employment, or the modification of its terms and conditions;",
              "children": []
            },
            {
              "type": "clause",
              "number": "k",
              "id": "92-2-k",
              "x": 41.27,
              "y_start": 364.9,
              "page_start": 1,
              "page_end": 1,
              "text": "any specified sum received by a unit holder from a business trust during the tax year with respect to a unit held by him at any time during such tax year, the computation of which shall be— specified sum = A – B – C (which shall be deemed to be zero, if the sum of B and C is greater than A), where— A = aggregate of the sum distributed by the business trust with respect to such unit, during the tax year or during any earlier tax year or years, to such unit holder, who holds such unit on the date of distribution of sum or to any other unit holder who held such unit at any time prior to the date of such distribution, which is—",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "92-2-a",
              "x": 130.02,
              "y_start": 425.36,
              "page_start": 1,
              "page_end": 1,
              "text": "not in the nature of income referred to in Schedule V (Table: Sl. No. 3 or 4); and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "92-2-b",
              "x": 130.02,
              "y_start": 435.97,
              "page_start": 1,
              "page_end": 1,
              "text": "not chargeable to tax under section 223(2); B = amount at which such unit was issued by the business trust; and C = amount charged to tax under this clause in any earlier tax year;",
              "children": []
            },
            {
              "type": "clause",
              "number": "l",
              "id": "92-2-l",
              "x": 42.68,
              "y_start": 467.8,
              "page_start": 1,
              "page_end": 1,
              "text": "where any sum, including bonus allocated, is received, during a tax year, under a life insurance policy, other than—",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "92-2-a",
              "x": 69.87,
              "y_start": 478.41,
              "page_start": 1,
              "page_end": 1,
              "text": "sums received under a unit linked insurance policy; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "92-2-b",
              "x": 69.87,
              "y_start": 489.02,
              "page_start": 1,
              "page_end": 1,
              "text": "income referred to in clause (d), and such sum is not to be excluded from the total income of that tax year under Schedule II (Table: Sl. No. 2), the sum exceeding the aggregate of the premium paid, during the term of such life insurance policy, and not claimed as a deduction under this Act, computed in such manner, as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "m",
              "id": "92-2-m",
              "x": 38.91,
              "y_start": 529.33,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "where any person receives in any tax year, from any person or per- sons—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "92-2-m-i",
                  "x": 71.75,
                  "y_start": 539.94,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any sum of money without consideration, the total of which exceeds Rs. 50000, the whole of such sum;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "92-2-m-ii",
                  "x": 69.33,
                  "y_start": 550.55,
                  "page_start": 1,
                  "page_end": 1,
                  "text_before_items": "any immovable property—",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "92-2-m-ii-A",
                      "x": 99.0,
                      "y_start": 561.15,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "without consideration, the stamp duty value of which exceeds Rs. 50000, the stamp duty value of such property;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "B",
                      "id": "92-2-m-ii-B",
                      "x": 99.0,
                      "y_start": 571.76,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "for a consideration, the stamp duty value of such property that exceeds such consideration, if this excess amount is more than the higher of the following amounts:—",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "I",
                      "id": "92-2-m-ii-I",
                      "x": 131.44,
                      "y_start": 591.92,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "Rs. 50000; or",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "II",
                      "id": "92-2-m-ii-II",
                      "x": 128.54,
                      "y_start": 602.53,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "10% of the consideration;",
                      "children": []
                    }
                  ],
                  "text_after_items": ""
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "92-2-m-iii",
                  "x": 66.91,
                  "y_start": 613.14,
                  "page_start": 1,
                  "page_end": 1,
                  "text_before_items": "any property, other than immovable property,—",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "92-2-m-iii-A",
                      "x": 99.0,
                      "y_start": 623.74,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "without consideration, the aggregate fair market value of which exceeds Rs. 50000, the whole of the aggregate fair market value of such property;",
                      "children": []
                    },
                    {
                      "type": "item",
                      "number": "B",
                      "id": "92-2-m-iii-B",
                      "x": 99.0,
                      "y_start": 643.9,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "for a consideration which is less than the aggregate fair market value of the property by an amount exceeding Rs. 50000, the aggregate fair market value of such property as exceeds such consideration.",
                      "children": []
                    }
                  ],
                  "text_after_items": ""
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "92-3",
          "x": 27.62,
          "y_start": 665.12,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The provisions of sub-section (2)(m) shall not apply to any sum of money or any property received—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "92-3-a",
              "x": 40.8,
              "y_start": 679.97,
              "page_start": 1,
              "page_end": 1,
              "text": "from any relative; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "92-3-b",
              "x": 40.8,
              "y_start": 690.58,
              "page_start": 1,
              "page_end": 1,
              "text": "on the occasion of marriage of the individual; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "92-3-c",
              "x": 41.27,
              "y_start": 701.19,
              "page_start": 1,
              "page_end": 1,
              "text": "under a will or by way of inheritance; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "92-3-d",
              "x": 40.8,
              "y_start": 711.8,
              "page_start": 1,
              "page_end": 1,
              "text": "in contemplation of death of the payer or donor; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "92-3-e",
              "x": 41.27,
              "y_start": 722.4,
              "page_start": 1,
              "page_end": 1,
              "text": "from any local authority as defined in Schedule III (Note 6); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "92-3-f",
              "x": 42.68,
              "y_start": 733.01,
              "page_start": 1,
              "page_end": 1,
              "text": "from or by any registered non-profit organisation as defined in section 355(g), except when received by any person referred to in section 355(h); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "92-3-g",
              "x": 40.8,
              "y_start": 743.62,
              "page_start": 1,
              "page_end": 1,
              "text": "by way of a transaction not regarded as transfer under section 70(1)(a), (c), (d), (e), (f), (g), (i), (j), (k), (l), (n), (o), (t), (u), (v) or (w); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "h",
              "id": "92-3-h",
              "x": 40.8,
              "y_start": 754.23,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "from an individual by a trust created or established solely for the benefit of relative of the individual; or",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "92-3-h-i",
                  "x": 42.68,
                  "y_start": 764.84,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from such class of persons and subject to such conditions, as may be prescribed.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "92-4",
          "x": 27.62,
          "y_start": 776.51,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of sub-section (2)(m)(ii),—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "92-4-a",
              "x": 40.8,
              "y_start": 64.14,
              "page_start": 2,
              "page_end": 2,
              "text": "if the date of agreement fixing the amount of consideration for the transfer of immovable property and the date of registration are not the same, the stamp duty value on the date of agreement shall apply, provided the consideration, in whole or in part, has been paid in specified banking or online mode as defined in section 66(32) on or before the date of agreement for transfer of such immovable property;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "92-4-b",
              "x": 40.8,
              "y_start": 93.85,
              "page_start": 2,
              "page_end": 2,
              "text": "if the stamp duty value of immovable property is disputed by the assessee on the grounds mentioned in section 78(2), the Assessing Officer may refer the valuation of such property to a Valuation Officer, and the provisions of sections 78(2) and 288(1) (Table: Sl. No. 8) shall, as far as may be, apply to the stamp duty value of such property as they apply for valuation of capital asset under those sections.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "5",
          "id": "92-5",
          "x": 27.62,
          "y_start": 124.61,
          "page_start": 2,
          "page_end": 2,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "92-5-a",
              "x": 40.8,
              "y_start": 138.93,
              "page_start": 2,
              "page_end": 2,
              "text": "\"assessable\" shall have the meaning assigned to it in section 2(105);",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "92-5-b",
              "x": 40.8,
              "y_start": 149.54,
              "page_start": 2,
              "page_end": 2,
              "text": "\"card game and other game of any sort\" includes any game show, an entertainment programme on television or electronic mode, where people compete to win prizes or any similar game;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "92-5-c",
              "x": 41.27,
              "y_start": 169.7,
              "page_start": 2,
              "page_end": 2,
              "text": "\"fair market value\" of a property, other than an immovable property, means the value determined by such method as may be prescribed;",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "92-5-d",
              "x": 40.8,
              "y_start": 180.31,
              "page_start": 2,
              "page_end": 2,
              "text": "\"jewellery\" shall have the meaning assigned to it in section 2(22);",
              "children": []
            },
            {
              "type": "clause",
              "number": "e",
              "id": "92-5-e",
              "x": 41.27,
              "y_start": 190.92,
              "page_start": 2,
              "page_end": 2,
              "text": "\"lottery\" includes winnings from prizes awarded by draw of lots, by chance, or in any other manner under any scheme or arrangement by whatever named called;",
              "children": []
            },
            {
              "type": "clause",
              "number": "f",
              "id": "92-5-f",
              "x": 42.68,
              "y_start": 211.07,
              "page_start": 2,
              "page_end": 2,
              "text_before_sub_clauses": "\"property\" means the following capital asset of the assessee:—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "92-5-f-i",
                  "x": 71.75,
                  "y_start": 221.68,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "immovable property being land or building or both;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "92-5-f-ii",
                  "x": 69.33,
                  "y_start": 232.29,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "shares and securities;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "92-5-f-iii",
                  "x": 66.91,
                  "y_start": 242.9,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "jewellery;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "92-5-f-iv",
                  "x": 67.93,
                  "y_start": 253.51,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "archaeological collections;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "v",
                  "id": "92-5-f-v",
                  "x": 70.35,
                  "y_start": 264.11,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "drawings;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vi",
                  "id": "92-5-f-vi",
                  "x": 67.93,
                  "y_start": 274.72,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "paintings;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "vii",
                  "id": "92-5-f-vii",
                  "x": 65.51,
                  "y_start": 285.33,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "sculptures;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "viii",
                  "id": "92-5-f-viii",
                  "x": 63.09,
                  "y_start": 295.94,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "any work of art;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ix",
                  "id": "92-5-f-ix",
                  "x": 67.93,
                  "y_start": 306.55,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "bullion; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "x",
                  "id": "92-5-f-x",
                  "x": 70.35,
                  "y_start": 317.16,
                  "page_start": 2,
                  "page_end": 2,
                  "text": "virtual digital asset;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "g",
              "id": "92-5-g",
              "x": 40.8,
              "y_start": 327.77,
              "page_start": 2,
              "page_end": 2,
              "text_before_sub_clauses": "\"relative\" means—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "92-5-g-i",
                  "x": 71.75,
                  "y_start": 338.37,
                  "page_start": 2,
                  "page_end": 2,
                  "text_before_items": "in case of an individual—",
                  "items": [
                    {
                      "type": "item",
                      "number": "A",
                      "id": "92-5-g-i-A",
                      "x": 99.0,
                      "y_start": 348.98,
                      "page_start": 2,
                      "page_end": 2,
                      "text": "spouse;",
