{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "56",
      "id": "56",
      "title": "Special provision in case of interest income of specified financial institutions.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "56-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "Irrespective of anything to the contrary contained in this Act, the interest income in relation to bad or doubtful debts of a specified financial institution shall be chargeable to tax under the head \"Profits and gains of business or profession\" in the tax year in which such interest is—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "56-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "credited to the profit and loss account; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "56-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "actually received, whichever is earlier.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "56-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "56-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"specified financial institution\" means—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "56-2-a-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a public financial institution; or"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "56-2-a-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a scheduled bank; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "56-2-a-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a co-operative bank, other than—"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "56-2-a-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a State Financial Corporation; or"
                },
                {
                  "type": "sub-clause",
                  "number": "v",
                  "id": "56-2-a-v",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a State Industrial Investment Corporation; or"
                },
                {
                  "type": "sub-clause",
                  "number": "vi",
                  "id": "56-2-a-vi",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any such class of non-banking financial companies, as may be notified by the Central Government;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "b",
              "id": "56-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "\"bad or doubtful debts\" shall be such categories of debts, as may be prescribed, having regard to the guidelines issued in relation to such debts by the Reserve Bank of India.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
