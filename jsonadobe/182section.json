      "indent": 0,
      "line_start": 4,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "In this Chapter, in determining whether a tax benefit exists,—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "182-a",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text": "the parties who are connected persons in relation to each other may be treated as one and the same person;",
          "children": []
        },
        {
          "type": "clause",
          "number": "b",
          "id": "182-b",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "any accommodating party may be disregarded;",
          "children": []
        },
        {
          "type": "clause",
          "number": "c",
          "id": "182-c",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "the accommodating party and any other party may be treated as one and the same person;",
          "children": []
        },
        {
          "type": "clause",
          "number": "d",
          "id": "182-d",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "the arrangement may be considered or looked through by disregarding any corporate structure.",
          "children": []
        }
      ],
      "text_after_clauses": ""
    }
  ],
