{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "40",
      "id": "40",
      "title": "Special provision for computation of cost of acquisition of certain assets.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "40-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of computation of income under the head \"Profits and gains of business or profession\", cost of acquisition of an asset which becomes property of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "40-1-a",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "an amalgamated company under a scheme of amalgamation; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "40-1-b",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "an assessee, under a gift, or will, or an irrevocable trust, or on total or partial partition of a Hindu undivided family, when sold as stock-in-trade shall be the sum of—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "40-1-b-i",
                  "indent": 0,
                  "line_start": 9,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "cost of acquisition of the said asset in the hands of the amalgamating company in case of clause (a), or the transferor or donor in case of clause (b);",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "40-1-b-ii",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any cost of improvement made;",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "40-1-b-iii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any expenditure incurred by the amalgamating company or transferor or donor, as the case may be, wholly and exclusively in connection with such transfer.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "40-2",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "This section shall not apply to an asset referred to in section 67(6).",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
