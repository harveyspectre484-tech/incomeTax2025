{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "18",
      "id": "18",
      "title": "Profits in lieu of salary.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "18-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this Part, \"profits in lieu of salary\" includes,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "18-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the amount of any compensation due to, or received by, an assessee from his employer or former employer at or in connection with the—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "18-1-a-i",
                  "indent": 0,
                  "line_start": 7,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "termination of his employment; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "18-1-a-ii",
                  "indent": 0,
                  "line_start": 8,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "modification of the terms and conditions relating thereto;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "18-1-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any amount due to, or received, whether in lump sum or otherwise, by any assessee from any person—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "18-1-b-i",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "before his joining any employment with that person; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "18-1-b-ii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "after cessation of his employment with that person;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "c",
              "id": "18-1-c",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any payment due to or received by an assessee—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "18-1-c-i",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from an employer or a former employer; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "18-1-c-ii",
                  "indent": 0,
                  "line_start": 14,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from a provident or other fund, to the extent to which it does not consist of contributions by the assessee or interest on such contributions; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "18-1-c-iii",
                  "indent": 0,
                  "line_start": 15,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any sum received under a Keyman insurance policy as defined in Schedule II (Note 1), including the sum allocated by way of bonus on such policy.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "18-2",
          "indent": 0,
          "line_start": 16,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The payment referred in sub-section (1)(c) shall not include any payment referred to in—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "18-2-a",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule II (Table: Sl. No. 3);",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "18-2-b",
              "indent": 0,
              "line_start": 18,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule II (Table: Sl. No. 4);",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "18-2-c",
              "indent": 0,
              "line_start": 19,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule II (Table: Sl. No. 8); and",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "18-2-d",
              "indent": 0,
              "line_start": 20,
              "page_start": 1,
              "page_end": 1,
              "text": "Schedule III (Table: Sl. No. 11).",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
