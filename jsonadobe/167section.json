      "type": "section",
      "number": "167",
      "id": "167",
      "title": "Power of Board to make safe harbour rules.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "167-1",
          "indent": 0,
          "line_start": 5,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The determination of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "167-1-a",
              "indent": 0,
              "line_start": 6,
              "page_start": 1,
              "page_end": 1,
              "text": "income referred to in section 9(2); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "167-1-b",
              "indent": 0,
              "line_start": 7,
              "page_start": 1,
              "page_end": 1,
              "text": "arm's length price under section 165 or 166, shall be subject to safe harbour rules.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "167-2",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of sub-section (1), the Board may make rules for safe harbour.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "167-3",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this section, \"safe harbour\" means circumstances in which the income-tax authorities shall accept,—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "167-3-a",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "the transfer price; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "167-3-b",
              "indent": 0,
              "line_start": 12,
              "page_start": 1,
              "page_end": 1,
              "text": "the income, deemed to accrue or arise under section 9(2), declared by the assessee.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": [
    {
      "page": 1,
      "line": 2,
      "text": "Ministry of Finance, Government of India"
    }
  ]
}
