{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "213",
      "id": "213",
      "title": "Special provision for computation of total income of non-residents.",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "213-1",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "No deduction in respect of any expenditure or allowance shall be allowed under any provision of this Act in computing the investment income of a non-resident Indian.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "213-2",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "In the case of an assessee, being a non-resident Indian, where—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "213-2-a",
              "indent": 0,
              "line_start": 8,
              "page_start": 1,
              "page_end": 1,
              "text": "the gross total income consists only of investment income or income by way of long-term capital gains or both, then no deduction shall be allowed under Chapter VIII;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "213-2-b",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "the gross total income includes any income referred to in clause (a),—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "213-2-b-i",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the gross total income shall be reduced by such income; and",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "213-2-b-ii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the deductions under Chapter VIII shall be allowed as if the gross total income as so reduced was the gross total income of the assessee.",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
