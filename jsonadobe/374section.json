{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "374",
      "id": "374",
      "title": "Interpretation of \"High Court\".",
      "indent": 0,
      "line_start": 6,
      "page_start": 1,
      "page_end": 1,
      "text_before_sub_clauses": "For the purposes of this Chapter, \"High Court\" means,—",
      "sub_clauses": [
        {
          "type": "sub_clause",
          "number": "i",
          "id": "374-i",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "for any State, the High Court for that State;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "ii",
          "id": "374-ii",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Jammu and Kashmir, the High Court of Jammu and Kashmir and Ladakh;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "iii",
          "id": "374-iii",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Ladakh, the High Court of Jammu and Kashmir and Ladakh;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "iv",
          "id": "374-iv",
          "indent": 0,
          "line_start": 10,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of the Andaman and Nicobar Islands, the High Court at Calcutta;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "v",
          "id": "374-v",
          "indent": 0,
          "line_start": 11,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Lakshadweep, the High Court of Kerala;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "vi",
          "id": "374-vi",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Chandigarh, the High Court of Punjab and Haryana;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "vii",
          "id": "374-vii",
          "indent": 0,
          "line_start": 13,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territories of Dadra and Nagar Haveli and Daman and Diu, the High Court at Bombay;",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "viii",
          "id": "374-viii",
          "indent": 0,
          "line_start": 14,
          "page_start": 1,
          "page_end": 1,
          "text": "for the Union territory of Puducherry, the High Court at Madras; and",
          "children": []
        },
        {
          "type": "sub_clause",
          "number": "ix",
          "id": "374-ix",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text": "for the National Capital Territory of Delhi, the High Court of Delhi.",
          "children": []
        }
      ],
      "text_after_sub_clauses": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
