{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "212",
      "id": "212",
      "title": "Interpretation.",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text_before_clauses": "In sections 213 to 218,—",
      "clauses": [
        {
          "type": "clause",
          "number": "a",
          "id": "212-a",
          "indent": 0,
          "line_start": 6,
          "page_start": 1,
          "page_end": 1,
          "text": "\"foreign exchange asset\" means any specified asset which the assessee has acquired or purchased with, or subscribed to in, convertible foreign exchange;",
          "children": []
        },
        {
          "type": "clause",
          "number": "b",
          "id": "212-b",
          "indent": 0,
          "line_start": 7,
          "page_start": 1,
          "page_end": 1,
          "text": "\"investment income\" means any income derived from a foreign exchange asset;",
          "children": []
        },
        {
          "type": "clause",
          "number": "c",
          "id": "212-c",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text": "\"long-term capital gains\" means income chargeable under the head \"Capital gains\" relating to a capital asset, being a foreign exchange asset which is not a short-term capital asset;",
          "children": []
        },
        {
          "type": "clause",
          "number": "d",
          "id": "212-d",
          "indent": 0,
          "line_start": 9,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "\"non-resident Indian\" means an individual, who is not a resident and is—",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "212-d-i",
              "indent": 0,
              "line_start": 10,
              "page_start": 1,
              "page_end": 1,
              "text": "a citizen of India; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "212-d-ii",
              "indent": 0,
              "line_start": 11,
              "page_start": 1,
              "page_end": 1,
              "text": "a person of Indian origin;",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        },
        {
          "type": "clause",
          "number": "e",
          "id": "212-e",
          "indent": 0,
          "line_start": 12,
          "page_start": 1,
          "page_end": 1,
          "text_before_sub_clauses": "\"specified asset\" means any of the following assets:—",
          "sub_clauses": [
            {
              "type": "sub_clause",
              "number": "i",
              "id": "212-e-i",
              "indent": 0,
              "line_start": 13,
              "page_start": 1,
              "page_end": 1,
              "text": "shares in an Indian company; or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "ii",
              "id": "212-e-ii",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "debentures issued by an Indian company which is not a private company as defined in the Companies Act, 2013 (18 of 2013); or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iii",
              "id": "212-e-iii",
              "indent": 0,
              "line_start": 15,
              "page_start": 1,
              "page_end": 1,
              "text": "deposits with an Indian company which is not a private company as defined in the Companies Act, 2013 (18 of 2013); or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "iv",
              "id": "212-e-iv",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "any security of the Central Government as defined in section 2(f) of the Government Securities Act, 2006 (38 of 2006); or",
              "children": []
            },
            {
              "type": "sub_clause",
              "number": "v",
              "id": "212-e-v",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "such other assets as the Central Government may specify in this behalf by notification.",
              "children": []
            }
          ],
          "text_after_sub_clauses": ""
        }
      ],
      "text_after_clauses": ""
    }
  ],
  "footnotes": [],
  "orphans": [
    {
      "page": 1,
      "line": 2,
      "text": "Ministry of Finance, Government of India"
    }
  ]
}
