{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "3",
      "id": "3",
      "title": "Ministry of Finance, Government of India",
      "indent": 0,
      "line_start": 5,
      "page_start": 1,
      "page_end": 1,
      "text": "—Representative assessees—Special cases",
      "children": []
    },
    {
      "type": "section",
      "number": "306",
      "id": "306",
      "title": "Who may be regarded as agent.",
      "indent": 0,
      "line_start": 8,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "306-1",
          "indent": 0,
          "line_start": 8,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of this Act, \"agent\", in relation to a non-resident, includes—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "306-1-a",
              "indent": 0,
              "line_start": 9,
              "page_start": 1,
              "page_end": 1,
              "text_before_sub_clauses": "any person in India—",
              "sub_clauses": [
                {
                  "type": "sub_clause",
                  "number": "i",
                  "id": "306-1-a-i",
                  "indent": 0,
                  "line_start": 10,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "who is employed by or on behalf of the non-resident; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "ii",
                  "id": "306-1-a-ii",
                  "indent": 0,
                  "line_start": 11,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "who has any business connection with the non-resident; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iii",
                  "id": "306-1-a-iii",
                  "indent": 0,
                  "line_start": 12,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "from or through whom the non-resident is in receipt of any income, whether directly or indirectly; or",
                  "children": []
                },
                {
                  "type": "sub_clause",
                  "number": "iv",
                  "id": "306-1-a-iv",
                  "indent": 0,
                  "line_start": 13,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "who is the trustee of the non-resident;",
                  "children": []
                }
              ],
              "text_after_sub_clauses": ""
            },
            {
              "type": "clause",
              "number": "b",
              "id": "306-1-b",
              "indent": 0,
              "line_start": 14,
              "page_start": 1,
              "page_end": 1,
              "text": "any other person who, whether a resident or non-resident, has acquired by means of a transfer, a capital asset in India.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "306-2",
          "indent": 0,
          "line_start": 15,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "A broker in India who, in respect of any transactions, does not deal directly with or on behalf of a non-resident principal but deals with or through a nonresident broker shall not be deemed to be an agent under this section in respect of such transactions, if the following conditions are fulfilled:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "306-2-a",
              "indent": 0,
              "line_start": 16,
              "page_start": 1,
              "page_end": 1,
              "text": "the transactions are carried on in the ordinary course of business through the first-mentioned broker; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "306-2-b",
              "indent": 0,
              "line_start": 17,
              "page_start": 1,
              "page_end": 1,
              "text": "the non-resident broker is carrying on such transactions in the ordinary course of his business and not as a principal.",
              "children": []
            }
          ],
          "text_after_clauses": ""
        },
        {
          "type": "subsection",
          "number": "3",
          "id": "306-3",
          "indent": 0,
          "line_start": 18,
          "page_start": 1,
          "page_end": 1,
          "text": "A person shall not be treated as the agent of a non-resident unless he has had an opportunity of being heard by the Assessing Officer as to his liability to be treated as such.",
          "children": []
        },
        {
          "type": "subsection",
          "number": "4",
          "id": "306-4",
          "indent": 0,
          "line_start": 19,
          "page_start": 1,
          "page_end": 1,
          "text": "For the purposes of this section, \"business connection\" shall have the meaning assigned to it in section 9(9)(a).",
          "children": []
        }
      ],
      "text_after_subsections": ""
    }
  ],
  "footnotes": [],
  "orphans": []
}
