{
  "chapters": [
    {
      "type": "chapter",
      "number": "XII",
      "x": 27.62,
      "y_start": 80.0,
      "page_start": 1,
      "page_end": 1,
      "text": "Mode of taking or accepting certain loans, deposits and specified sum.",
      "children": [
        {
          "type": "section",
          "number": "185",
          "id": "185",
          "title": "MODE OF PAYMENT IN CERTAIN CASES, ETC.",
          "x": 27.62,
          "y_start": 80.59,
          "page_start": 1,
          "page_end": 1,
          "text_before_subsections": "",
          "subsections": [
            {
              "type": "subsection",
              "number": "1",
              "id": "185-1",
              "x": 27.62,
              "y_start": 95.44,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "No person shall take or accept from another person any loan or deposit or specified sum, except through—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "185-1-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an account payee cheque; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "185-1-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "account payee bank draft; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "185-1-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "electronic clearing system through a bank account; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "185-1-d",
                  "x": 40.8,
                  "y_start": 450.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other prescribed electronic mode, if,—",
                  "children": [
                    {
                      "type": "sub-clause",
                      "number": "i",
                      "id": "185-1-d-i",
                      "x": 55.0,
                      "y_start": 465.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "the amount or the aggregate amount of such loan, deposit, or specified sum; or"
                    },
                    {
                      "type": "sub-clause",
                      "number": "ii",
                      "id": "185-1-d-ii",
                      "x": 55.0,
                      "y_start": 480.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "the amount or the aggregate amount of any previously taken or accepted loan or deposit or specified sum by such person from such another person, which is remaining unpaid, whether due for repayment or not, as on the date of taking or accepting such amount as referred to in clause (i);"
                    },
                    {
                      "type": "sub-clause",
                      "number": "iii",
                      "id": "185-1-d-iii",
                      "x": 55.0,
                      "y_start": 465.0,
                      "page_start": 1,
                      "page_end": 1,
                      "text": "the aggregate of the amounts referred to in clauses (i) and (ii), is Rs. 20000 or more."
                    }
                  ]
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "2",
              "id": "185-2",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "Sub-section (1) shall not apply to loans or deposits or specified sums taken or accepted from or by,—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "185-2-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the Government;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "185-2-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any banking company, post office savings bank, or co-operative bank;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "c",
                  "id": "185-2-c",
                  "x": 40.8,
                  "y_start": 430.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any corporation established by a Central, State or Provincial Act;",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "d",
                  "id": "185-2-d",
                  "x": 40.8,
                  "y_start": 450.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any Government company as defined under section 2(45) of the Companies Act, 2013 (18 of 2013);",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "e",
                  "id": "185-2-e",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any institution, association, or body or class of institutions, associations or bodies notified by the Central Government.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "3",
              "id": "185-3",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "The provisions of sub-section (1) shall not apply to any loan or deposit or specified sum where, the person taking or accepting such loan or deposit or specified sum and person from whom such loan or deposit or specified sum is taken or accepted, both, have agricultural income and neither has any income chargeable to tax under this Act.",
              "clauses": [],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "4",
              "id": "185-4",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "In sub-section (1), \"Rs. 200000\" shall be substituted for \"Rs. 20000\" in the case of any deposit or loan, where—",
              "clauses": [
                {
                  "type": "clause",
                  "number": "a",
                  "id": "185-4-a",
                  "x": 40.8,
                  "y_start": 395.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such deposit is accepted by a primary agricultural credit society or a primary co-operative agricultural and rural development bank from its member; or",
                  "children": []
                },
                {
                  "type": "clause",
                  "number": "b",
                  "id": "185-4-b",
                  "x": 40.8,
                  "y_start": 415.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such loan is taken from a primary agricultural credit society or primary co-operative agricultural and development bank by its member.",
                  "children": []
                }
              ],
              "text_after_clauses": ""
            },
            {
              "type": "subsection",
              "number": "5",
              "id": "185-5",
              "x": 27.62,
              "y_start": 380.0,
              "page_start": 1,
              "page_end": 1,
              "text_before_clauses": "For the purposes of this section, the expression \"loan or deposit\" means loan or deposit of money.",
              "clauses": [],
              "text_after_clauses": ""
            }
          ],
          "text_after_subsections": ""
        }
      ]
    }
  ],
