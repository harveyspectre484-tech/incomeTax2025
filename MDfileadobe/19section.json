            ]
          }
        },
        {
          "type": "subsection",
          "number": "2",
          "id": "19-2",
          "x": 27.62,
          "y_start": 380.0,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "For the purposes of the Table referred to in sub-section (1),— Minimum of—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "19-2-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "compensation received;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "19-2-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "amount calculated as per provisions of section 25F(b) of the Industrial Disputes Act, 1947 (14 of 1947);",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "19-2-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "such amount, not being less than Rs. 50000, as may be notified by the Central Government. Compensation received. Minimum of—",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "19-2-a",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "compensation received; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "19-2-b",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "Rs. 500000. Entire amount. Amount being minimum of—",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "19-2-a",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the cash equivalent of the leave salary in respect of the period of earned leave at his credit at the time of his retirement, whether on superannuation or otherwise (entitlement of earned leave shall not exceed thirty days for every year of actual service);",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "19-2-b",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "amount \"A\", where,— A=10 x B; B = average monthly salary for the ten months immediately preceding his retirement whether on superannuation or otherwise;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "19-2-c",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "amount as the Central Government may, by notification, specify in this behalf having regard to the limit applicable in this behalf to the employees of that Government; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "19-2-d",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "actual payment received.",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "19-2-a",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of the entries against serial number 6 thereof, if gratuity or gratuities was or were received from one or more than one employer in the same tax year (whether or not any gratuity or gratuities was or were received in any earlier tax year), the aggregate amount of deduction shall not exceed— A - B, where,— A = the limit specified by the Central Government, by notification; and B = the aggregate amount of gratuity or gratuities which was or were received in any one or more earlier tax years and allowed as an exemption or a deduction (whether whole or part) from the total income of any such tax year or years;",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "19-2-b",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of the entries against serial numbers 6 and 14 thereof, \"Salary\" includes dearness allowance, if the terms of employment so provide, but excludes all other allowances and perquisites;",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "19-2-c",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of the entries against serial numbers 10 and 11 thereof, the following amounts shall be deemed to be compensation received at the time of retrenchment:—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "19-2-c-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "compensation received by a workman at the time of the closing down of the undertaking in which he is employed;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "19-2-c-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "compensation received by a workman, at the time of the transfer (whether by agreement or by operation of law) of the ownership or management of the undertaking in which he is employed, from the employer in relation to that undertaking to a new employer, if—"
                },
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "19-2-c-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the applicable schemes of the said companies or authorities or societies or Universities or the institutes referred to in clauses (h)(vii) and (x), governing the payment of such amount are made as per such guidelines (including, inter alia, criteria of economic viability) as may be issued in this behalf;"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "19-2-c-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "where deduction has been allowed to an employee in respect of the said item for any tax year, no deduction thereunder shall be allowed to him in relation to any other tax year; and"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "19-2-c-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "where any relief under section 157 has been allowed to an assessee for any tax year in respect of any amount referred to in the said item, such amount shall not be allowed as a deduction from the compensation received or receivable in any tax year;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "f",
              "id": "19-2-f",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "in respect of the entries against serial number 14 thereof, if any payment on account of cash equivalent of leave salary is received from one or more than one employer in the same tax year (whether or not any such payment or payments was or were received in any earlier tax year), the aggregate amount of deduction shall not exceed— A - B, where,— A = the limit specified by the Central Government, by notification; and B = the aggregate amount of payment or payments which was received in any one or more earlier tax years and allowed as an exemption or a deduction (whether whole or part) from total income of any such tax year or years;",
              "children": []
            },
            {
              "type": "clause",
              "number": "g",
              "id": "19-2-g",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the death-cum-retirement gratuity referred to in sub-section (1) (Table: Sl. No. 3) shall be as—",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "i",
                  "id": "19-2-g-i",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to the members of the civil services of the Union or holders of posts connected with defence or of civil posts under the Union (such members or holders being persons not governed by the said rules);"
                },
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "19-2-g-ii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to the members of the all-India services;"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "19-2-g-iii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to the members of the civil services of a State or holders of civil posts under a State; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "19-2-g-iv",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "to the employees of a local authority;"
                }
              ]
            },
            {
              "type": "clause",
              "number": "h",
              "id": "19-2-h",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the schemes of voluntary retirement or termination of service as referred to in sub-section (1) (Table: Sl. No. 12) shall be for the employees of—",
              "children": []
            },
            {
              "type": "clause",
              "number": "i",
              "id": "19-2-i",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "a public sector company (under a scheme of voluntary separation); or",
              "children": [
                {
                  "type": "sub-clause",
                  "number": "ii",
                  "id": "19-2-i-ii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "any other company; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iii",
                  "id": "19-2-i-iii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an authority established under a Central Act or State Act or Provincial Act; or"
                },
                {
                  "type": "sub-clause",
                  "number": "iv",
                  "id": "19-2-i-iv",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a local authority; or"
                },
                {
                  "type": "sub-clause",
                  "number": "v",
                  "id": "19-2-i-v",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a co-operative society; or"
                },
                {
                  "type": "sub-clause",
                  "number": "vi",
                  "id": "19-2-i-vi",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "a University established or incorporated by or under a Central Act or State Act or Provincial Act and an institution declared to be a University under section 3 of the University Grants Commission Act, 1956 (3 of 1956); or"
                },
                {
                  "type": "sub-clause",
                  "number": "viii",
                  "id": "19-2-i-viii",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "the Central or any State Government; or"
                },
                {
                  "type": "sub-clause",
                  "number": "vii",
                  "id": "19-2-i-vii",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an Indian Institute of Technology within the meaning of section 3(g) of the Institutes of Technology Act, 1961 (59 of 1961); or"
                },
                {
                  "type": "sub-clause",
                  "number": "x",
                  "id": "19-2-i-x",
                  "x": 55.0,
                  "y_start": 480.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "such institute of management, as the Central Government may, by notification, specify in this behalf."
                },
                {
                  "type": "sub-clause",
                  "number": "ix",
                  "id": "19-2-i-ix",
                  "x": 55.0,
                  "y_start": 465.0,
                  "page_start": 1,
                  "page_end": 1,
                  "text": "an institution, having importance throughout India or in any State or States, as the Central Government may, by notification, specify in this behalf; or"
                }
              ]
            }
          ],
          "text_after_clauses": ""
        }
      ],
      "text_after_subsections": ""
    }
  ],
