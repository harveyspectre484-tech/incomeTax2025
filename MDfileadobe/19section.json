{
  "chapters": [],
  "sections": [
    {
      "type": "section",
      "number": "19",
      "id": "19",
      "title": "Deductions from salaries.",
      "x": 27.62,
      "y_start": 80.59,
      "page_start": 1,
      "page_end": 1,
      "text_before_subsections": "",
      "subsections": [
        {
          "type": "subsection",
          "number": "1",
          "id": "19-1",
          "x": 27.62,
          "y_start": 95.44,
          "page_start": 1,
          "page_end": 1,
          "text_before_clauses": "The income chargeable under the head \"Salaries\" shall be computed after making the deductions in respect of sums of the nature mentioned in column B of the following Table, not exceeding the amount as mentioned in column C thereof:—",
          "clauses": [
            {
              "type": "clause",
              "number": "a",
              "id": "19-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "under the Industrial Disputes Act, 1947 (14 of 1947); or",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "19-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "under any other Act or rules, orders or notifications issued thereunder; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "c",
              "id": "19-1-c",
              "x": 40.8,
              "y_start": 430.0,
              "page_start": 1,
              "page_end": 1,
              "text": "under any standing orders; or",
              "children": []
            },
            {
              "type": "clause",
              "number": "d",
              "id": "19-1-d",
              "x": 40.8,
              "y_start": 450.0,
              "page_start": 1,
              "page_end": 1,
              "text": "under any award, contract of service or other-wise.",
              "children": []
            },
            {
              "type": "clause",
              "number": "a",
              "id": "19-1-a",
              "x": 40.8,
              "y_start": 395.0,
              "page_start": 1,
              "page_end": 1,
              "text": "the need for extending special protection to the workmen in the undertaking to which such scheme applies; and",
              "children": []
            },
            {
              "type": "clause",
              "number": "b",
              "id": "19-1-b",
              "x": 40.8,
              "y_start": 415.0,
              "page_start": 1,
              "page_end": 1,
              "text": "other relevant circum-stances.",
              "children": []
            }
          ],
          "text_after_clauses": "",
          "table": {
            "type": "table",
            "id": "19-1-table",
            "x": 27.62,
